module Chunky

# A 320x200 chunky screen on the VIC-IV: full-colour characters (a byte per
# pixel, a palette index) numbered down the columns, so the screen's bytes
# run like a framebuffer turned on its side. Pixel (x, y) of a buffer is at
#
#     buffer + (x >> 3) * 1600 + y * 8 + (x & 7)
#
# and a column of pixels steps by 8 bytes: dma_blit draws a column of a
# sprite in one go, dma_fill clears a buffer in one.
#
# Two buffers, each with its own screen map pointing at its characters: one
# is shown while the other is drawn, and chunky_flip swaps them between
# frames.

import Vic4

export const WIDTH = 320
export const HEIGHT = 200
export const COLUMNS = 40
export const ROWS = 25
export const COLUMN_BYTES: u16 = 1600
export const BUFFER_BYTES: u16 = 64000

const BUFFER_A: u32 = $40000
const BUFFER_B: u32 = $50000
# The screen maps sit high in bank 1, leaving its start to the parts
# (bank 1 ends at $1F800, where the first 2 KiB of colour RAM shows).
export const MAP_A: u32 = $1e000
export const MAP_B: u32 = $1e800
# The raster line the swap waits for: past the screen's last line.
const FLIP_LINE = 251

# Where each column of characters starts in a buffer (column * 1600).
const COLUMN_OFFSET: [COLUMNS]u16 = [0, 1600, 3200, 4800, 6400, 8000, 9600, 11200, 12800, 14400, 16000, 17600, 19200, 20800, 22400, 24000, 25600, 27200, 28800, 30400, 32000, 33600, 35200, 36800, 38400, 40000, 41600, 43200, 44800, 46400, 48000, 49600, 51200, 52800, 54400, 56000, 57600, 59200, 60800, 62400]

# The buffer being drawn, and which one it is (0 A, 1 B).
export var drawing: u32
var shown_b: u8
var fill_column: u8
var fill_row: u8
var map_at: u32
var character: u16

# Fills `map` with the characters of `buffer`, down the columns.
procedure fill_map(map: u32, buffer: u32)
    var cell: far ^u8
    character = vic4_tile_at(buffer)
    fill_column = 0
    while fill_column != COLUMNS
        map_at = map + u32(fill_column << 1)
        fill_row = 0
        while fill_row != ROWS
            cell = map_at
            cell^ = u8(character)
            cell = map_at + 1
            cell^ = u8(character >> 8)
            map_at = map_at + u32(COLUMNS * 2)
            character = character + 1
            fill_row = fill_row + 1
        end
        fill_column = fill_column + 1
    end
    return
end

# Sets up both buffers (cleared to colour 0) and shows A, drawing into B.
export procedure chunky_init()
    fill_map(MAP_A, BUFFER_A)
    fill_map(MAP_B, BUFFER_B)
    vic4_fill_colour(0, 0, 0, COLUMNS * ROWS)
    dma_fill(BUFFER_A, 0, BUFFER_BYTES)
    dma_fill(BUFFER_B, 0, BUFFER_BYTES)
    vic4_text16(MAP_A, COLUMNS, 0)
    shown_b = 0
    drawing = BUFFER_B
    return
end

# Waits for the frame to end, shows the buffer just drawn and makes the
# other the one to draw.
export procedure chunky_flip()
    vic4_wait_line(FLIP_LINE)
    if shown_b
        vic4_text16(MAP_A, COLUMNS, 0)
        drawing = BUFFER_B
        shown_b = 0
    else
        vic4_text16(MAP_B, COLUMNS, 0)
        drawing = BUFFER_A
        shown_b = 1
    end
    return
end

# Fills the buffer being drawn with `colour`.
export procedure chunky_clear(colour: u8)
    dma_fill(drawing, colour, BUFFER_BYTES)
    return
end

# The address of pixel (x, y) in the buffer being drawn.
export function chunky_at(x: u16, y: u16): u32
    return drawing + u32(COLUMN_OFFSET[u8(x >> 3)] + (y << 3) + (x & 7))
end

# Draws `count` pixels of a column from `source` (0 is transparent) at
# (x, y) down; the caller keeps it on the screen.
export procedure chunky_column(source: u32, x: u16, y: u16, count: u16)
    dma_blit(source, chunky_at(x, y), count, 8)
    return
end
