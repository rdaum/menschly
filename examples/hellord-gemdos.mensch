module HellordGemdos

external reentrant function bios_bconstat(dev: u16): u16
external reentrant function bios_bconin(dev: u16): u8
external procedure bios_bconout(dev: u16, ch: u16)
external reentrant function bios_bcostat(dev: u16): u16
external reentrant function bios_device_first(): u16
external reentrant function bios_device_next(dev: u16): u16
external reentrant function bios_device_kind(dev: u16): u16
external reentrant function bios_device_flags(dev: u16): u16
external reentrant function dos_get_drive_index(): u16
external reentrant function dos_set_drive_index(drive: u16): u16
external reentrant function dos_set_path(path: near ^u8): u16
external reentrant function dos_fsfirst(dta: near ^u8): u16
external reentrant function dos_fsnext(dta: near ^u8): u16
external reentrant function dos_fopen(path: near ^u8): u16
external reentrant function dos_fread(handle: u16, count: u16, buffer: near ^u8): u16
external reentrant function dos_fwrite(handle: u16, count: u16, buffer: near ^u8): u16
external reentrant function dos_fclose(handle: u16): u16
# Where a trap's caller lives (0 = the kernel), and copies to and from it:
# a program may run in a bank of its own (see the machine modules).
external function machine_caller_bank(): u16
external reentrant procedure machine_copy_in(bank: u16, dst: near ^u8, src: u16, count: u16)
external reentrant procedure machine_copy_out(bank: u16, dst: u16, src: near ^u8, count: u16)

const DEVICE_KIND_CHAR = $0001
const DEVICE_FLAG_READ = $0001
const DEVICE_FLAG_WRITE = $0002
const GEMDOS_STDIN = $0000
const GEMDOS_STDOUT = $0001
const GEMDOS_STDERR = $0002
const GEMDOS_FAMILY = $01
const GEMDOS_CCONIN = $0001
const GEMDOS_CCONOUT = $0002
const GEMDOS_CCONIS = $000b
const GEMDOS_DSETDRV = $000e
const GEMDOS_FCLOSE = $003e
const GEMDOS_FREAD = $003f
const GEMDOS_FWRITE = $0040
const GEMDOS_FOPEN = $003d
const GEMDOS_CCONOS = $0010
const GEMDOS_DGETDRV = $0019
const GEMDOS_DSETPATH = $003b
const GEMDOS_FSFIRST = $004e
const GEMDOS_FSNEXT = $004f
const GEMDOS_GET_STDDEV = $0100
const GEMDOS_SET_STDDEV = $0101
# Sets the byte count for the next Fread/Fwrite (the trap ABI has two
# arguments; Fread and Fwrite take handle and buffer).
const GEMDOS_FCOUNT = $0102
const DOS_ERR_FIRST = $ff00
const PATH_BYTES = 64
const DTA_BYTES = 16
const CHUNK_BYTES = 128

var gemdos_initialized: u8
var gemdos_stdin_device: u16
var gemdos_stdout_device: u16
var gemdos_stderr_device: u16
var gemdos_arg_byte: u8
var gemdos_arg_word: u16
# Kernel copies of a program's arguments.
var gemdos_path: [64]u8
var gemdos_dta: [16]u8
var gemdos_chunk: [128]u8

export reentrant function gemdos_cconis(): u16
    return trap(GEMDOS_FAMILY, GEMDOS_CCONIS, 0, 0)
end

export reentrant function gemdos_cconin(): u8
    return u8(trap(GEMDOS_FAMILY, GEMDOS_CCONIN, 0, 0))
end

export reentrant function gemdos_cconos(): u16
    return trap(GEMDOS_FAMILY, GEMDOS_CCONOS, 0, 0)
end

export reentrant procedure gemdos_cconout(ch: u8)
    var status: u16
    gemdos_arg_byte = ch
    gemdos_arg_word = u16(gemdos_arg_byte)
    status = trap(GEMDOS_FAMILY, GEMDOS_CCONOUT, gemdos_arg_word, 0)
    return
end

export reentrant function gemdos_get_stddev(stream: u16): u16
    return trap(GEMDOS_FAMILY, GEMDOS_GET_STDDEV, stream, 0)
end

export reentrant procedure gemdos_set_stddev(stream: u16, dev: u16)
    var status: u16
    status = trap(GEMDOS_FAMILY, GEMDOS_SET_STDDEV, stream, dev)
    return
end

export reentrant function gemdos_dgetdrv(): u16
    return trap(GEMDOS_FAMILY, GEMDOS_DGETDRV, 0, 0)
end

export reentrant function gemdos_dsetdrv(drive: u16): u16
    return trap(GEMDOS_FAMILY, GEMDOS_DSETDRV, drive, 0)
end

export reentrant function gemdos_dsetpath(path: near ^u8): u16
    return trap(GEMDOS_FAMILY, GEMDOS_DSETPATH, u16(path), 0)
end

export reentrant function gemdos_fsfirst(pattern: near ^u8, dta: near ^u8): u16
    return trap(GEMDOS_FAMILY, GEMDOS_FSFIRST, u16(pattern), u16(dta))
end

export reentrant function gemdos_fsnext(dta: near ^u8): u16
    return trap(GEMDOS_FAMILY, GEMDOS_FSNEXT, u16(dta), 0)
end

export reentrant function gemdos_fopen(path: near ^u8, mode: u16): u16
    return trap(GEMDOS_FAMILY, GEMDOS_FOPEN, u16(path), mode)
end

export reentrant function gemdos_fread(handle: u16, count: u16, buffer: near ^u8): u16
    gemdos_arg_word = count
    return trap(GEMDOS_FAMILY, GEMDOS_FREAD, handle, u16(buffer))
end

export reentrant function gemdos_fwrite(handle: u16, count: u16, buffer: near ^u8): u16
    gemdos_arg_word = count
    return trap(GEMDOS_FAMILY, GEMDOS_FWRITE, handle, u16(buffer))
end

export reentrant function gemdos_fclose(handle: u16): u16
    return trap(GEMDOS_FAMILY, GEMDOS_FCLOSE, handle, 0)
end

export reentrant procedure gemdos_init()
    var dev: u16
    dev = gemdos_find_default_console()
    gemdos_stdin_device = dev
    gemdos_stdout_device = dev
    gemdos_stderr_device = dev
    gemdos_initialized = 1
    return
end

reentrant procedure gemdos_ensure_init()
    if gemdos_initialized
        return
    end
    gemdos_init()
    return
end

reentrant function gemdos_find_default_console(): u16
    var dev: u16
    var flags: u16
    dev = bios_device_first()
    while dev
        if bios_device_kind(dev) == DEVICE_KIND_CHAR
            flags = bios_device_flags(dev)
            if flags & DEVICE_FLAG_READ
                if flags & DEVICE_FLAG_WRITE
                    return dev
                end
            end
        end
        dev = bios_device_next(dev)
    end
    return 0
end

reentrant function gemdos_impl_get_stddev(stream: u16): u16
    gemdos_ensure_init()
    if stream == GEMDOS_STDIN
        return gemdos_stdin_device
    end
    if stream == GEMDOS_STDOUT
        return gemdos_stdout_device
    end
    if stream == GEMDOS_STDERR
        return gemdos_stderr_device
    end
    return 0
end

reentrant procedure gemdos_impl_set_stddev(stream: u16, dev: u16)
    gemdos_ensure_init()
    if stream == GEMDOS_STDIN
        gemdos_stdin_device = dev
        return
    end
    if stream == GEMDOS_STDOUT
        gemdos_stdout_device = dev
        return
    end
    if stream != GEMDOS_STDERR
        return
    end
    gemdos_stderr_device = dev
    return
end

reentrant function gemdos_impl_cconis(): u16
    gemdos_ensure_init()
    return bios_bconstat(gemdos_stdin_device)
end

reentrant function gemdos_impl_cconin(): u8
    gemdos_ensure_init()
    return bios_bconin(gemdos_stdin_device)
end

reentrant function gemdos_impl_cconos(): u16
    gemdos_ensure_init()
    return bios_bcostat(gemdos_stdout_device)
end

reentrant procedure gemdos_impl_cconout(ch: u8)
    gemdos_ensure_init()
    gemdos_arg_byte = ch
    gemdos_arg_word = u16(gemdos_arg_byte)
    bios_bconout(gemdos_stdout_device, gemdos_arg_word)
    return
end

reentrant function gemdos_impl_dgetdrv(): u16
    return dos_get_drive_index()
end

reentrant function gemdos_impl_dsetdrv(drive: u16): u16
    return dos_set_drive_index(drive)
end

reentrant function gemdos_impl_dsetpath(path: near ^u8): u16
    return dos_set_path(path)
end

reentrant function gemdos_impl_fsfirst(pattern: near ^u8, dta: near ^u8): u16
    return dos_fsfirst(dta)
end

reentrant function gemdos_impl_fsnext(dta: near ^u8): u16
    return dos_fsnext(dta)
end

reentrant function gemdos_impl_fopen(path: near ^u8, mode: u16): u16
    return dos_fopen(path)
end

reentrant function gemdos_impl_fread(handle: u16, buffer: near ^u8): u16
    return dos_fread(handle, gemdos_arg_word, buffer)
end

reentrant function gemdos_impl_fwrite(handle: u16, buffer: near ^u8): u16
    return dos_fwrite(handle, gemdos_arg_word, buffer)
end

reentrant function gemdos_impl_fclose(handle: u16): u16
    return dos_fclose(handle)
end

# Copies the caller's NUL-terminated path into gemdos_path.
reentrant function gemdos_caller_path(caller: u16, path: u16): near ^u8
    machine_copy_in(caller, addr(gemdos_path), path, PATH_BYTES)
    gemdos_path[PATH_BYTES - 1] = 0
    return addr(gemdos_path)
end

# Fread for a caller in another bank: reads through gemdos_chunk.
reentrant function gemdos_caller_fread(caller: u16, handle: u16, buffer: u16): u16
    var total: u16
    var want: u16
    var got: u16
    total = 0
    while total != gemdos_arg_word
        want = gemdos_arg_word - total
        if want > CHUNK_BYTES
            want = CHUNK_BYTES
        end
        got = dos_fread(handle, want, addr(gemdos_chunk))
        if got >= DOS_ERR_FIRST
            return got
        end
        machine_copy_out(caller, buffer + total, addr(gemdos_chunk), got)
        total = total + got
        if got != want
            return total
        end
    end
    return total
end

# Fwrite for a caller in another bank: writes through gemdos_chunk.
reentrant function gemdos_caller_fwrite(caller: u16, handle: u16, buffer: u16): u16
    var total: u16
    var want: u16
    var put: u16
    total = 0
    while total != gemdos_arg_word
        want = gemdos_arg_word - total
        if want > CHUNK_BYTES
            want = CHUNK_BYTES
        end
        machine_copy_in(caller, addr(gemdos_chunk), buffer + total, want)
        put = dos_fwrite(handle, want, addr(gemdos_chunk))
        if put >= DOS_ERR_FIRST
            return put
        end
        total = total + put
        if put != want
            return total
        end
    end
    return total
end

# Fsfirst/Fsnext through gemdos_dta, for callers in another bank.
reentrant function gemdos_caller_find(caller: u16, first: u8, dta: u16): u16
    var status: u16
    machine_copy_in(caller, addr(gemdos_dta), dta, DTA_BYTES)
    if first
        status = gemdos_impl_fsfirst(addr(gemdos_path), addr(gemdos_dta))
    else
        status = gemdos_impl_fsnext(addr(gemdos_dta))
    end
    machine_copy_out(caller, dta, addr(gemdos_dta), DTA_BYTES)
    return status
end

export reentrant function gemdos_trap_dispatch(call: u16, arg0: u16, arg1: u16): u16
    var caller: u16
    caller = machine_caller_bank()
    if caller
        if call == GEMDOS_DSETPATH
            return gemdos_impl_dsetpath(gemdos_caller_path(caller, arg0))
        end
        if call == GEMDOS_FOPEN
            return gemdos_impl_fopen(gemdos_caller_path(caller, arg0), arg1)
        end
        if call == GEMDOS_FREAD
            return gemdos_caller_fread(caller, arg0, arg1)
        end
        if call == GEMDOS_FWRITE
            return gemdos_caller_fwrite(caller, arg0, arg1)
        end
        if call == GEMDOS_FSFIRST
            gemdos_path[0] = 0
            return gemdos_caller_find(caller, 1, arg1)
        end
        if call == GEMDOS_FSNEXT
            return gemdos_caller_find(caller, 0, arg0)
        end
    end
    if call == GEMDOS_FCOUNT
        gemdos_arg_word = arg0
        return 0
    end
    if call == GEMDOS_CCONIS
        return gemdos_impl_cconis()
    end
    if call == GEMDOS_CCONIN
        return u16(gemdos_impl_cconin())
    end
    if call == GEMDOS_CCONOS
        return gemdos_impl_cconos()
    end
    if call == GEMDOS_CCONOUT
        gemdos_impl_cconout(u8(arg0))
        return 0
    end
    if call == GEMDOS_DSETDRV
        return gemdos_impl_dsetdrv(arg0)
    end
    if call == GEMDOS_DGETDRV
        return gemdos_impl_dgetdrv()
    end
    if call == GEMDOS_DSETPATH
        return gemdos_impl_dsetpath(arg0)
    end
    if call == GEMDOS_FOPEN
        return gemdos_impl_fopen(arg0, arg1)
    end
    if call == GEMDOS_FCLOSE
        return gemdos_impl_fclose(arg0)
    end
    if call == GEMDOS_FREAD
        return gemdos_impl_fread(arg0, arg1)
    end
    if call == GEMDOS_FWRITE
        return gemdos_impl_fwrite(arg0, arg1)
    end
    if call == GEMDOS_FSFIRST
        return gemdos_impl_fsfirst(arg0, arg1)
    end
    if call == GEMDOS_FSNEXT
        return gemdos_impl_fsnext(arg0)
    end
    if call == GEMDOS_GET_STDDEV
        return gemdos_impl_get_stddev(arg0)
    end
    if call != GEMDOS_SET_STDDEV
        return $ffff
    end
    gemdos_impl_set_stddev(arg0, arg1)
    return 0
end
