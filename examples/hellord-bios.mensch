module HellordBios

external procedure serial_write(value: u16)
external function serial_has_data(): u8
external function serial_read(): u8

const BIOS_BCONSTAT = $0001
const BIOS_BCONIN = $0002
const BIOS_BCONOUT = $0003
const BIOS_BCOSTAT = $0008
const BIOS_BBLKSTAT = $0200
const BIOS_BBLKCOUNT = $0201
const BIOS_BSETLBA = $0202
const BIOS_BREAD = $0203
const BIOS_DEV_FIRST = $0100
const BIOS_DEV_NEXT = $0101
const BIOS_DEV_PARENT = $0102
const BIOS_DEV_CHILD = $0103
const BIOS_DEV_KIND = $0104
const BIOS_DEV_FLAGS = $0105
const BIOS_DEV_DRIVER = $0106
const BIOS_CONSOLE = $0002
const BIOS_BLOCK0 = $0008
const BIOS_FAMILY = $0d
const DEVICE_KIND_CHAR = $0001
const DEVICE_KIND_BLOCK = $0002
const DEVICE_FLAG_READ = $0001
const DEVICE_FLAG_WRITE = $0002
const DEVICE_DRIVER_NONE = $0000
const DEVICE_DRIVER_SERIAL = $0001
const DEVICE_DRIVER_X65_BLOCK = $0002
const USB_UART_DATA = $009f57
const BLOCK_LBA0 = $009f60
const BLOCK_LBA1 = $009f61
const BLOCK_LBA2 = $009f62
const BLOCK_LBA3 = $009f63
const BLOCK_INDEX_LO = $009f64
const BLOCK_INDEX_HI = $009f65
const BLOCK_DATA = $009f66
const BLOCK_COMMAND = $009f67
const BLOCK_STATUS = $009f68
const BLOCK_ERROR = $009f69
const BLOCK_SECTOR_COUNT0 = $009f6a
const BLOCK_SECTOR_COUNT1 = $009f6b
const BLOCK_COMMAND_READ = $01
const BLOCK_COMMAND_WRITE = $02

type BiosDevice = record
    id: u16
    kind: u16
    flags: u16
    driver: u16
    parent: u16
    first_child: u16
    next_sibling: u16
end

fixed($009f57) volatile var usb_uart_data: u8
fixed($009f60) volatile var block_lba0: u8
fixed($009f61) volatile var block_lba1: u8
fixed($009f62) volatile var block_lba2: u8
fixed($009f63) volatile var block_lba3: u8
fixed($009f64) volatile var block_index_lo: u8
fixed($009f65) volatile var block_index_hi: u8
fixed($009f66) volatile var block_data: u8
fixed($009f67) volatile var block_command: u8
fixed($009f68) volatile var block_status: u8
fixed($009f69) volatile var block_error: u8
fixed($009f6a) volatile var block_sector_count0: u8
fixed($009f6b) volatile var block_sector_count1: u8
var registry_initialized: u8
var bios_first_device: u16
var serial_device: BiosDevice
var block_device: BiosDevice
var bios_call: u16
var bios_device: u16
var bios_arg: u16
var bios_arg_byte: u8
var bios_status: u16

export reentrant function bios_bconstat(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_BCONSTAT, dev, 0)
end

export reentrant function bios_bconin(dev: u16): u8
    return u8(cop_call(BIOS_FAMILY, BIOS_BCONIN, dev, 0))
end

export procedure bios_bconout(dev: u16, ch: u16)
    var status: u16
    status = cop_call(BIOS_FAMILY, BIOS_BCONOUT, dev, ch)
    return
end

export reentrant function bios_bcostat(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_BCOSTAT, dev, 0)
end

export reentrant function bios_device_first(): u16
    return cop_call(BIOS_FAMILY, BIOS_DEV_FIRST, 0, 0)
end

export reentrant function bios_device_next(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_DEV_NEXT, dev, 0)
end

export reentrant function bios_device_parent(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_DEV_PARENT, dev, 0)
end

export reentrant function bios_device_child(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_DEV_CHILD, dev, 0)
end

export reentrant function bios_device_kind(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_DEV_KIND, dev, 0)
end

export reentrant function bios_device_flags(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_DEV_FLAGS, dev, 0)
end

export reentrant function bios_device_driver(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_DEV_DRIVER, dev, 0)
end

export reentrant function bios_block_status(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_BBLKSTAT, dev, 0)
end

export reentrant function bios_block_sector_count(dev: u16): u16
    return cop_call(BIOS_FAMILY, BIOS_BBLKCOUNT, dev, 0)
end

export reentrant procedure bios_block_set_lba(dev: u16, lba: u16)
    var status: u16
    status = cop_call(BIOS_FAMILY, BIOS_BSETLBA, dev, lba)
    return
end

export reentrant function bios_block_read(dev: u16, buffer: near ^u8): u16
    return cop_call(BIOS_FAMILY, BIOS_BREAD, dev, u16(buffer))
end

export procedure bios_init_registry()
    registry_initialized = 1
    bios_first_device = BIOS_CONSOLE
    serial_device.id = BIOS_CONSOLE
    serial_device.kind = DEVICE_KIND_CHAR
    serial_device.flags = $0003
    serial_device.driver = DEVICE_DRIVER_SERIAL
    serial_device.parent = 0
    serial_device.first_child = 0
    serial_device.next_sibling = BIOS_BLOCK0
    block_device.id = BIOS_BLOCK0
    block_device.kind = DEVICE_KIND_BLOCK
    block_device.flags = $0003
    block_device.driver = DEVICE_DRIVER_X65_BLOCK
    block_device.parent = 0
    block_device.first_child = 0
    block_device.next_sibling = 0
    return
end

reentrant procedure bios_ensure_registry()
    if registry_initialized == 0
        bios_init_registry()
    end
    return
end

reentrant function bios_find_device(): u16
    bios_ensure_registry()
    if bios_first_device == bios_device
        if serial_device.id == bios_device
            return serial_device.id
        else
            return 0
        end
    elsif block_device.id == bios_device
        return block_device.id
    else
        return 0
    end
end

reentrant function bios_dispatch_bconstat(): u16
    var driver: u16
    if bios_find_device() != 0
        if serial_device.kind == DEVICE_KIND_CHAR
            driver = serial_device.driver
            if driver == DEVICE_DRIVER_SERIAL
                if serial_device.flags & DEVICE_FLAG_READ != 0
                    if serial_has_data() != 0
                        return $ffff
                    else
                        return 0
                    end
                else
                    return 0
                end
            else
                return 0
            end
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_bconin(): u16
    var driver: u16
    if bios_find_device() != 0
        if serial_device.kind == DEVICE_KIND_CHAR
            driver = serial_device.driver
            if driver == DEVICE_DRIVER_SERIAL
                if serial_device.flags & DEVICE_FLAG_READ != 0
                    if serial_has_data() != 0
                        bios_arg_byte = serial_read()
                        bios_status = 0
                        asm "sep #$20"
                        asm ".a8"
                        asm "lda bios_arg_byte"
                        asm "sta bios_status"
                        asm "rep #$20"
                        asm ".a16"
                        return bios_status
                    else
                        return 0
                    end
                else
                    return 0
                end
            else
                return 0
            end
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_bconout(): u16
    var driver: u16
    if bios_find_device() != 0
        if serial_device.kind == DEVICE_KIND_CHAR
            driver = serial_device.driver
            if driver == DEVICE_DRIVER_SERIAL
                if serial_device.flags & DEVICE_FLAG_WRITE != 0
                    serial_write(bios_arg)
                    return 0
                else
                    return $ffff
                end
            else
                return $ffff
            end
        else
            return $ffff
        end
    else
        return $ffff
    end
end

reentrant function bios_dispatch_bcostat(): u16
    var driver: u16
    if bios_find_device() != 0
        if serial_device.kind == DEVICE_KIND_CHAR
            driver = serial_device.driver
            if driver == DEVICE_DRIVER_SERIAL
                if serial_device.flags & DEVICE_FLAG_WRITE != 0
                    return $ffff
                else
                    return 0
                end
            else
                return 0
            end
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_device_next(): u16
    if bios_find_device() != 0
        if bios_device == serial_device.id
            return serial_device.next_sibling
        else
            return block_device.next_sibling
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_device_parent(): u16
    if bios_find_device() != 0
        if bios_device == serial_device.id
            return serial_device.parent
        else
            return block_device.parent
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_device_child(): u16
    if bios_find_device() != 0
        if bios_device == serial_device.id
            return serial_device.first_child
        else
            return block_device.first_child
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_device_kind(): u16
    if bios_find_device() != 0
        if bios_device == serial_device.id
            return serial_device.kind
        else
            return block_device.kind
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_device_flags(): u16
    if bios_find_device() != 0
        if bios_device == serial_device.id
            return serial_device.flags
        else
            return block_device.flags
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_device_driver(): u16
    if bios_find_device() != 0
        if bios_device == serial_device.id
            return serial_device.driver
        else
            return block_device.driver
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_block_status(): u16
    if bios_find_device() != 0
        if bios_device == block_device.id
            return u16(block_status)
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_block_sector_count(): u16
    if bios_find_device() != 0
        if bios_device == block_device.id
            bios_status = 0
            asm "sep #$20"
            asm ".a8"
            asm "lda block_sector_count1"
            asm "sta bios_status+1"
            asm "lda block_sector_count0"
            asm "sta bios_status"
            asm "rep #$20"
            asm ".a16"
            return bios_status
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function bios_dispatch_block_set_lba(): u16
    if bios_find_device() != 0
        if bios_device == block_device.id
            block_lba0 = u8(bios_arg)
            bios_status = bios_arg
            asm "sep #$20"
            asm ".a8"
            asm "lda bios_status+1"
            asm "sta block_lba1"
            asm "stz block_lba2"
            asm "stz block_lba3"
            asm "rep #$20"
            asm ".a16"
            return 0
        else
            return $ffff
        end
    else
        return $ffff
    end
end

reentrant function bios_dispatch_block_read(): u16
    var buffer: near ^u8
    var index: u16
    if bios_find_device() != 0
        if bios_device == block_device.id
            buffer = bios_arg
            block_command = BLOCK_COMMAND_READ
            if block_error != 0
                return u16(block_error)
            else
                index = 0
                while index != $0200
                    buffer^ = block_data
                    buffer = buffer + 1
                    index = index + 1
                end
                return 0
            end
        else
            return $ffff
        end
    else
        return $ffff
    end
end

export reentrant function bios_trap_dispatch(call: u16, dev: u16, arg: u16): u16
    bios_call = call
    bios_device = dev
    bios_arg = arg
    bios_arg_byte = u8(arg)
    if bios_call == BIOS_BCONSTAT
        return bios_dispatch_bconstat()
    elsif bios_call == BIOS_BCONIN
        return bios_dispatch_bconin()
    elsif bios_call == BIOS_BCONOUT
        return bios_dispatch_bconout()
    elsif bios_call == BIOS_BCOSTAT
        return bios_dispatch_bcostat()
    elsif bios_call == BIOS_BBLKSTAT
        return bios_dispatch_block_status()
    elsif bios_call == BIOS_BBLKCOUNT
        return bios_dispatch_block_sector_count()
    elsif bios_call == BIOS_BSETLBA
        return bios_dispatch_block_set_lba()
    elsif bios_call == BIOS_BREAD
        return bios_dispatch_block_read()
    elsif bios_call == BIOS_DEV_FIRST
        bios_ensure_registry()
        return bios_first_device
    elsif bios_call == BIOS_DEV_NEXT
        return bios_dispatch_device_next()
    elsif bios_call == BIOS_DEV_PARENT
        return bios_dispatch_device_parent()
    elsif bios_call == BIOS_DEV_CHILD
        return bios_dispatch_device_child()
    elsif bios_call == BIOS_DEV_KIND
        return bios_dispatch_device_kind()
    elsif bios_call == BIOS_DEV_FLAGS
        return bios_dispatch_device_flags()
    elsif bios_call == BIOS_DEV_DRIVER
        return bios_dispatch_device_driver()
    else
        return $ffff
    end
end
