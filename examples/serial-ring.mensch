module SerialRing
const RX_IRQ = $40
const TX_IRQ = $80
const TX_FULL = $08
const RX_EMPTY = $80
const RING_MASK = 63

fixed($009f55) volatile var serial_ctrl: u8
fixed($009f56) volatile var serial_status: u8
fixed($009f57) volatile var serial_data: u8
var rx_head: u16
var rx_tail: u16
var rx_next: u16
var rx_buffer: [64]u8
var tx_head: u16
var tx_tail: u16
var tx_next: u16
var tx_buffer: [64]u8
fixed($000280) volatile var rx_overflow: u8
fixed($000281) volatile var rx_drop: u8
fixed($000282) volatile var tx_overflow: u8
fixed($000283) volatile var tx_drop: u8

export procedure serial_init()
    rx_head = 0
    rx_tail = 0
    rx_next = 0
    tx_head = 0
    tx_tail = 0
    tx_next = 0
    rx_overflow = 0
    tx_overflow = 0
    serial_ctrl = RX_IRQ
    return
end

export procedure serial_write(value: u8)
    tx_next = tx_head + 1 & RING_MASK
    if tx_next == tx_tail
        tx_drop = value
        tx_overflow = 1
    else
        tx_buffer[tx_head] = value
        tx_head = tx_next
        serial_ctrl = RX_IRQ + TX_IRQ
    end
    return
end

export function serial_has_data(): u8
    if rx_head == rx_tail
        return 0
    else
        return 1
    end
end

export function serial_read(): u8
    direct var value: u8
    value = rx_buffer[rx_tail]
    rx_tail = rx_tail + 1 & RING_MASK
    return value
end

export interrupt procedure serial_irq()
    if serial_status & RX_EMPTY == 0
        rx_next = rx_head + 1 & RING_MASK
        if rx_next == rx_tail
            rx_drop = serial_data
            rx_overflow = 1
        else
            rx_buffer[rx_head] = serial_data
            rx_head = rx_next
        end
    end
    if tx_head == tx_tail
        serial_ctrl = RX_IRQ
    else
        if serial_status & TX_FULL == 0
            serial_data = tx_buffer[tx_tail]
            tx_tail = tx_tail + 1 & RING_MASK
        end
        if tx_head == tx_tail
            serial_ctrl = RX_IRQ
        else
            serial_ctrl = RX_IRQ + TX_IRQ
        end
    end
    return
end
