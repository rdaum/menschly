module HellordOs
application main
vector irq = serial_irq
fixed($009f57) volatile var serial_data: u8

external interrupt procedure serial_irq()
external procedure serial_init()
external function serial_has_data(): u8
external function serial_read(): u8

export procedure main()
    serial_data = 'H'
    serial_data = 'e'
    serial_data = 'l'
    serial_data = 'l'
    serial_data = 'o'
    serial_data = 'r'
    serial_data = 'd'
    serial_data = '!'
    serial_data = '\r'
    serial_data = '\n'

    serial_init()

    while 1 != 0
        while serial_has_data() == 0
        end
        serial_data = serial_read()
    end
end
