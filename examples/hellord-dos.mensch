module HellordDos

external procedure console_write(value: u8)
external procedure console_newline()
external procedure console_prompt()
external function console_read(): u8
external procedure console_write_greeting()
external procedure console_write_help()
external procedure console_write_version()
external procedure console_write_dir()
external procedure console_write_unknown()
external procedure console_write_flag(name: u8, value: u8)
external function serial_rx_overflow(): u8
external function serial_tx_overflow(): u8

const COMMAND_UNKNOWN = 0
const COMMAND_HELP = 1
const COMMAND_VERSION = 2
const COMMAND_DIR = 3
const COMMAND_ECHO = 4
const COMMAND_STATUS = 5
const COMMAND_EMPTY = 255
const LINE_LIMIT = 31
const BACKSPACE = $08
const DELETE = $7f

var line_len: u16
var command_buffer: [32]u8

export procedure dos_boot()
    console_write_greeting()
    console_prompt()
    while 1 != 0
        read_line()
        dispatch_line()
        console_prompt()
    end
end

function command_code(): u8
    if line_len == 0
        return COMMAND_EMPTY
    else
        if is_help() != 0
            return COMMAND_HELP
        else
            if is_version() != 0
                return COMMAND_VERSION
            else
                if is_dir() != 0
                    return COMMAND_DIR
                else
                    if is_status() != 0
                        return COMMAND_STATUS
                    else
                        if is_echo() != 0
                            return COMMAND_ECHO
                        else
                            return COMMAND_UNKNOWN
                        end
                    end
                end
            end
        end
    end
end

function char_matches(index: u16, upper: u8, lower: u8): u8
    if command_buffer[index] == upper
        return 1
    else
        if command_buffer[index] == lower
            return 1
        else
            return 0
        end
    end
end

function is_help(): u8
    if line_len == 1
        return char_matches(0, 'H', 'h')
    else
        if line_len == 4
            if char_matches(0, 'H', 'h') == 0
                return 0
            else
                if char_matches(1, 'E', 'e') == 0
                    return 0
                else
                    if char_matches(2, 'L', 'l') == 0
                        return 0
                    else
                        return char_matches(3, 'P', 'p')
                    end
                end
            end
        else
            return 0
        end
    end
end

function is_version(): u8
    if line_len == 1
        return char_matches(0, 'V', 'v')
    else
        if line_len == 3
            if char_matches(0, 'V', 'v') == 0
                return 0
            else
                if char_matches(1, 'E', 'e') == 0
                    return 0
                else
                    return char_matches(2, 'R', 'r')
                end
            end
        else
            return 0
        end
    end
end

function is_dir(): u8
    if line_len == 1
        return char_matches(0, 'D', 'd')
    else
        if line_len == 3
            if char_matches(0, 'D', 'd') == 0
                return 0
            else
                if char_matches(1, 'I', 'i') == 0
                    return 0
                else
                    return char_matches(2, 'R', 'r')
                end
            end
        else
            return 0
        end
    end
end

function is_echo(): u8
    if line_len == 1
        return char_matches(0, 'E', 'e')
    else
        if line_len == 2
            return 0
        else
            if line_len == 3
                return 0
            else
                if char_matches(0, 'E', 'e') == 0
                    return 0
                else
                    if char_matches(1, 'C', 'c') == 0
                        return 0
                    else
                        if char_matches(2, 'H', 'h') == 0
                            return 0
                        else
                            return char_matches(3, 'O', 'o')
                        end
                    end
                end
            end
        end
    end
end

function is_status(): u8
    if line_len == 1
        return char_matches(0, 'S', 's')
    else
        if line_len == 4
            if char_matches(0, 'S', 's') == 0
                return 0
            else
                if char_matches(1, 'T', 't') == 0
                    return 0
                else
                    if char_matches(2, 'A', 'a') == 0
                        return 0
                    else
                        return char_matches(3, 'T', 't')
                    end
                end
            end
        else
            return 0
        end
    end
end

function echo_start(): u16
    if line_len == 1
        return 1
    else
        if line_len == 2
            return 1
        else
            if line_len == 3
                return 1
            else
                return 4
            end
        end
    end
end

procedure read_line()
    var ch: u8
    var done: u8
    line_len = 0
    done = 0
    while done == 0
        ch = console_read()
        if ch == '\r'
            console_newline()
            done = 1
        else
            if ch == '\n'
                console_newline()
                done = 1
            else
                if ch == BACKSPACE
                    erase_char()
                else
                    if ch == DELETE
                        erase_char()
                    else
                        if line_len == LINE_LIMIT
                        else
                            command_buffer[line_len] = ch
                            line_len = line_len + 1
                            console_write(ch)
                        end
                    end
                end
            end
        end
    end
    return
end

procedure erase_char()
    if line_len == 0
    else
        line_len = line_len - 1
        console_write(BACKSPACE)
        console_write(' ')
        console_write(BACKSPACE)
    end
    return
end

procedure dispatch_line()
    direct var code: u8
    code = command_code()
    if code == COMMAND_EMPTY
        return
    else
        if code == COMMAND_HELP
            console_write_help()
        else
            if code == COMMAND_VERSION
                console_write_version()
            else
                if code == COMMAND_DIR
                    console_write_dir()
                else
                    if code == COMMAND_STATUS
                        write_status()
                    else
                        if code == COMMAND_ECHO
                            echo_line()
                        else
                            console_write_unknown()
                        end
                    end
                end
            end
        end
    end
    return
end

procedure write_status()
    console_write_flag('R', serial_rx_overflow())
    console_write_flag('T', serial_tx_overflow())
    return
end

procedure echo_line()
    var index: u16
    index = echo_start()
    if index == line_len
    else
        if command_buffer[index] == ' '
            index = index + 1
        end
    end
    while index != line_len
        console_write(command_buffer[index])
        index = index + 1
    end
    console_newline()
    return
end
