module SerialRing
fixed($009f55) volatile var serial_ctrl: u8
fixed($009f57) volatile var serial_data: u8
var rx_head: u16
var rx_tail: u16
var rx_next: u16
var rx_buffer: [16]u8
fixed($000280) volatile var rx_overflow: u8
fixed($000281) volatile var rx_drop: u8

export procedure serial_init()
    rx_head = 0
    rx_tail = 0
    rx_next = 0
    rx_overflow = 0
    serial_ctrl = $40
    return
end

export procedure serial_write(value: u8)
    serial_data = value
    return
end

export function serial_has_data(): u8
    if rx_head == rx_tail
        return 0
    else
        return 1
    end
end

export function serial_read(): u8
    direct var value: u8
    value = rx_buffer[rx_tail]
    rx_tail = rx_tail + 1 & 15
    return value
end

export interrupt procedure serial_irq()
    asm "pha"
    rx_next = rx_head + 1 & 15
    if rx_next == rx_tail
        rx_drop = serial_data
        rx_overflow = 1
    else
        rx_buffer[rx_head] = serial_data
        rx_head = rx_next
    end
    asm "pla"
    return
end
