module HellordDos

external procedure console_write(value: u8)
external procedure console_newline()
external function console_read(): u8
external procedure console_write_text(text: near ^u8)
external procedure console_write_hex8(value: u8)
external procedure console_write_hex16(value: u16)
external procedure console_clear()
external procedure console_write_greeting()
external procedure console_write_help()
external procedure console_write_version()
external procedure console_prompt_drive(drive: u8)
external procedure console_write_unknown()
external procedure console_write_flag(name: u8, value: u8)
external procedure files_write_root_dir()
external procedure files_write_games_dir()
external procedure files_type_readme()
external procedure files_type_system()
external procedure files_type_demo()
external procedure files_write_not_found()
external procedure files_write_program_not_found()
external procedure files_write_path_not_found()
external procedure files_run_hello()
external procedure files_run_demo()
external function serial_rx_overflow(): u8
external function serial_tx_overflow(): u8

const COMMAND_UNKNOWN = 0
const COMMAND_HELP = 1
const COMMAND_VERSION = 2
const COMMAND_DIR = 3
const COMMAND_ECHO = 4
const COMMAND_STATUS = 5
const COMMAND_DRIVE = 6
const COMMAND_PWD = 7
const COMMAND_CD = 8
const COMMAND_MAP = 9
const COMMAND_TYPE = 10
const COMMAND_CLS = 11
const COMMAND_PROMPT = 12
const COMMAND_SET = 13
const COMMAND_RUN = 14
const COMMAND_MEM = 15
const COMMAND_PROGRAM = 16
const COMMAND_PATH = 17
const COMMAND_PEEK = 18
const COMMAND_POKE = 19
const COMMAND_EMPTY = 255
const FILE_UNKNOWN = 0
const FILE_README = 1
const FILE_SYSTEM = 2
const FILE_DEMO = 3
const PROGRAM_HELLO = 1
const PROGRAM_DEMO = 2
const DIR_ROOT = 0
const DIR_GAMES = 1
const PROMPT_SHORT = 0
const PROMPT_FULL = 1
const PATH_CURRENT = 0
const PATH_ROOT = 1
const LINE_LIMIT = 31
const PATH_LIMIT = 15
const BACKSPACE = $08
const RECALL = $10
const DELETE = $7f
const LOWERCASE_DELTA = 32

var current_drive: u8
var current_dir: u8
var prompt_mode: u8
var path_mode: u8
var path_len: u16
var line_len: u16
var history_len: u16
var parse_end: u16
var parse_ok: u8
var current_path: [16]u8
var command_buffer: [32]u8
var history_buffer: [32]u8

export procedure dos_boot()
    current_drive = 'A'
    prompt_mode = PROMPT_SHORT
    path_mode = PATH_CURRENT
    init_path()
    console_write_greeting()
    prompt()
    while 1 != 0
        read_line()
        save_history()
        dispatch_line()
        prompt()
    end
end

function command_code(): u8
    if line_len == 0
        return COMMAND_EMPTY
    elsif is_help() != 0
        return COMMAND_HELP
    elsif is_version() != 0
        return COMMAND_VERSION
    elsif is_dir() != 0
        return COMMAND_DIR
    elsif is_status() != 0
        return COMMAND_STATUS
    elsif is_pwd() != 0
        return COMMAND_PWD
    elsif is_map() != 0
        return COMMAND_MAP
    elsif is_mem() != 0
        return COMMAND_MEM
    elsif is_cls() != 0
        return COMMAND_CLS
    elsif is_prompt() != 0
        return COMMAND_PROMPT
    elsif is_path() != 0
        return COMMAND_PATH
    elsif is_peek() != 0
        return COMMAND_PEEK
    elsif is_poke() != 0
        return COMMAND_POKE
    elsif is_set() != 0
        return COMMAND_SET
    elsif is_run() != 0
        return COMMAND_RUN
    elsif bare_program_code() != 0
        return COMMAND_PROGRAM
    elsif is_type() != 0
        return COMMAND_TYPE
    elsif is_cd() != 0
        return COMMAND_CD
    elsif is_echo() != 0
        return COMMAND_ECHO
    elsif is_drive_select() != 0
        return COMMAND_DRIVE
    else
        return COMMAND_UNKNOWN
    end
end

procedure init_path()
    current_path[0] = '/'
    path_len = 1
    history_len = 0
    parse_end = 0
    parse_ok = 0
    current_dir = DIR_ROOT
    return
end

procedure set_games_path()
    current_path[0] = 'G'
    current_path[1] = 'A'
    current_path[2] = 'M'
    current_path[3] = 'E'
    current_path[4] = 'S'
    path_len = 5
    current_dir = DIR_GAMES
    return
end

function normalized_drive(value: u8): u8
    if value >= 'a' and value <= 'z'
        return value - LOWERCASE_DELTA
    else
        return value
    end
end

function is_drive_letter(value: u8): u8
    var drive: u8
    drive = normalized_drive(value)
    if drive >= 'A' and drive <= 'Z'
        return 1
    else
        return 0
    end
end

function is_drive_select(): u8
    if line_len == 2 and is_drive_letter(command_buffer[0]) != 0 and command_buffer[1] == ':'
        return 1
    else
        return 0
    end
end

function command_char_matches(index: u16, expected: u8): u8
    if normalized_drive(command_buffer[index]) == expected
        return 1
    else
        return 0
    end
end

function command_word_matches(word: near ^u8): u8
    var index: u16
    var ch: u8
    index = 0
    ch = word^
    while ch != 0
        if index >= line_len
            return 0
        elsif command_char_matches(index, ch) == 0
            return 0
        else
            index = index + 1
            word = word + 1
            ch = word^
        end
    end
    if index == line_len
        return 1
    else
        return 0
    end
end

function command_argument_matches(word: near ^u8): u8
    var index: u16
    var ch: u8
    index = 0
    ch = word^
    while ch != 0
        if index >= line_len
            return 0
        elsif command_char_matches(index, ch) == 0
            return 0
        else
            index = index + 1
            word = word + 1
            ch = word^
        end
    end
    if index < line_len and command_buffer[index] == ' ' and index + 1 < line_len
        return 1
    else
        return 0
    end
end

function argument_start(short: near ^u8, long: near ^u8): u16
    var index: u16
    index = 0
    if command_argument_matches(short) != 0
        while short^ != 0
            index = index + 1
            short = short + 1
        end
        return index + 1
    else
        while long^ != 0
            index = index + 1
            long = long + 1
        end
        return index + 1
    end
end

function argument_word_matches(index: u16, word: near ^u8): u8
    var ch: u8
    ch = word^
    while ch != 0
        if index >= line_len
            return 0
        elsif command_char_matches(index, ch) == 0
            return 0
        else
            index = index + 1
            word = word + 1
            ch = word^
        end
    end
    if index == line_len
        return 1
    else
        return 0
    end
end

function argument_name_matches(index: u16, word: near ^u8): u8
    var ch: u8
    ch = word^
    while ch != 0
        if index >= line_len
            return 0
        elsif command_char_matches(index, ch) == 0
            return 0
        else
            index = index + 1
            word = word + 1
            ch = word^
        end
    end
    if index == line_len
        return 1
    elsif command_buffer[index] == ' '
        return 1
    else
        return 0
    end
end

function is_help(): u8
    if command_word_matches("H") != 0
        return 1
    elsif command_word_matches("HELP") != 0
        return 1
    else
        return 0
    end
end

function is_version(): u8
    if command_word_matches("V") != 0
        return 1
    elsif command_word_matches("VER") != 0
        return 1
    else
        return 0
    end
end

function is_dir(): u8
    if command_word_matches("D") != 0
        return 1
    elsif command_word_matches("DIR") != 0
        return 1
    else
        return 0
    end
end

function is_echo(): u8
    if command_word_matches("E") != 0
        return 1
    elsif command_argument_matches("E") != 0
        return 1
    elsif command_word_matches("ECHO") != 0
        return 1
    elsif command_argument_matches("ECHO") != 0
        return 1
    else
        return 0
    end
end

function is_status(): u8
    if command_word_matches("S") != 0
        return 1
    elsif command_word_matches("STAT") != 0
        return 1
    else
        return 0
    end
end

function is_pwd(): u8
    if command_word_matches("PWD") != 0
        return 1
    elsif command_word_matches("P") != 0
        return 1
    else
        return 0
    end
end

function is_map(): u8
    if command_word_matches("M") != 0
        return 1
    elsif command_word_matches("MAP") != 0
        return 1
    else
        return 0
    end
end

function is_mem(): u8
    if command_word_matches("MEM") != 0
        return 1
    else
        return 0
    end
end

function is_cls(): u8
    if command_word_matches("C") != 0
        return 1
    elsif command_word_matches("CLS") != 0
        return 1
    else
        return 0
    end
end

function is_prompt(): u8
    if command_word_matches("PROMPT") != 0
        return 1
    elsif command_argument_matches("PROMPT") != 0
        return 1
    else
        return 0
    end
end

function is_path(): u8
    if command_word_matches("PATH") != 0
        return 1
    elsif command_argument_matches("PATH") != 0
        return 1
    else
        return 0
    end
end

function is_peek(): u8
    if command_argument_matches("PEEK") != 0
        return 1
    else
        return 0
    end
end

function is_poke(): u8
    if command_argument_matches("POKE") != 0
        return 1
    else
        return 0
    end
end

function is_set(): u8
    if command_word_matches("SET") != 0
        return 1
    elsif command_argument_matches("SET") != 0
        return 1
    else
        return 0
    end
end

function is_type(): u8
    if command_argument_matches("T") != 0
        return 1
    elsif command_argument_matches("TYPE") != 0
        return 1
    else
        return 0
    end
end

function is_run(): u8
    if command_argument_matches("R") != 0
        return 1
    elsif command_argument_matches("RUN") != 0
        return 1
    else
        return 0
    end
end

function is_cd(): u8
    if command_word_matches("CD") != 0
        return 1
    elsif command_argument_matches("CD") != 0
        return 1
    else
        return 0
    end
end

function echo_start(): u16
    if command_word_matches("E") != 0
        return 1
    elsif command_argument_matches("E") != 0
        return 2
    elsif command_word_matches("ECHO") != 0
        return 4
    else
        return 5
    end
end

procedure read_line()
    var ch: u8
    var done: u8
    line_len = 0
    done = 0
    repeat
        ch = console_read()
        if ch == '\r'
            console_newline()
            done = 1
        else
            if ch == '\n'
                console_newline()
                done = 1
            else
                if ch == BACKSPACE
                    erase_char()
                else
                    if ch == DELETE
                        erase_char()
                    else
                        if ch == RECALL
                            recall_history()
                        else
                            if line_len < LINE_LIMIT
                                command_buffer[line_len] = ch
                                line_len = line_len + 1
                                console_write(ch)
                            end
                        end
                    end
                end
            end
        end
    until done != 0
    return
end

procedure recall_history()
    var index: u16
    if line_len == 0
        index = 0
        while index != history_len
            command_buffer[index] = history_buffer[index]
            console_write(command_buffer[index])
            index = index + 1
        end
        line_len = history_len
    end
    return
end

procedure save_history()
    var index: u16
    if line_len == 0
        return
    end
    index = 0
    while index != line_len
        history_buffer[index] = command_buffer[index]
        index = index + 1
    end
    history_len = line_len
    return
end

procedure erase_char()
    if line_len == 0
    else
        line_len = line_len - 1
        console_write(BACKSPACE)
        console_write(' ')
        console_write(BACKSPACE)
    end
    return
end

procedure dispatch_line()
    direct var code: u8
    code = command_code()
    if code == COMMAND_EMPTY
        return
    elsif code == COMMAND_HELP
        console_write_help()
    elsif code == COMMAND_VERSION
        console_write_version()
    elsif code == COMMAND_DIR
        write_dir()
    elsif code == COMMAND_STATUS
        write_status()
    elsif code == COMMAND_PWD
        write_path()
    elsif code == COMMAND_MAP
        write_memory_map()
    elsif code == COMMAND_MEM
        write_memory_status()
    elsif code == COMMAND_CLS
        console_clear()
    elsif code == COMMAND_PROMPT
        configure_prompt()
    elsif code == COMMAND_PATH
        configure_path()
    elsif code == COMMAND_PEEK
        peek_memory()
    elsif code == COMMAND_POKE
        poke_memory()
    elsif code == COMMAND_SET
        configure_set()
    elsif code == COMMAND_RUN
        run_program()
    elsif code == COMMAND_PROGRAM
        run_bare_program()
    elsif code == COMMAND_TYPE
        type_file()
    elsif code == COMMAND_CD
        change_dir()
    elsif code == COMMAND_ECHO
        echo_line()
    elsif code == COMMAND_DRIVE
        select_drive()
    else
        console_write_unknown()
    end
    return
end

procedure prompt()
    if prompt_mode == PROMPT_SHORT
        console_prompt_drive(current_drive)
    else
        write_path_prefix()
        console_write_text("> ")
    end
    return
end

procedure select_drive()
    current_drive = normalized_drive(command_buffer[0])
    return
end

procedure write_path()
    write_path_prefix()
    console_newline()
    return
end

procedure write_path_prefix()
    var index: u16
    console_write(current_drive)
    console_write(':')
    index = 0
    while index != path_len
        console_write(current_path[index])
        index = index + 1
    end
    return
end

procedure write_dir_prefix()
    var index: u16
    index = 0
    while index != path_len
        console_write(current_path[index])
        index = index + 1
    end
    return
end

function hex_digit(value: u8): u8
    value = normalized_drive(value)
    if value >= '0' and value <= '9'
        return value - '0'
    elsif value >= 'A' and value <= 'F'
        return value - 'A' + 10
    else
        return $ff
    end
end

function hex_argument_start(index: u16): u16
    if index < line_len and command_buffer[index] == '$'
        return index + 1
    else
        return index
    end
end

function append_hex_digit(value: u16, digit: u8): u16
    value = value + value
    value = value + value
    value = value + value
    value = value + value
    if digit == 0
        return value
    elsif digit == 1
        return value + 1
    elsif digit == 2
        return value + 2
    elsif digit == 3
        return value + 3
    elsif digit == 4
        return value + 4
    elsif digit == 5
        return value + 5
    elsif digit == 6
        return value + 6
    elsif digit == 7
        return value + 7
    elsif digit == 8
        return value + 8
    elsif digit == 9
        return value + 9
    elsif digit == 10
        return value + 10
    elsif digit == 11
        return value + 11
    elsif digit == 12
        return value + 12
    elsif digit == 13
        return value + 13
    elsif digit == 14
        return value + 14
    else
        return value + 15
    end
end

function parse_hex_u16(index: u16): u16
    var value: u16
    var digit: u8
    var digits: u8
    index = hex_argument_start(index)
    value = 0
    digits = 0
    parse_ok = 0
    while index < line_len and command_buffer[index] != ' '
        digit = hex_digit(command_buffer[index])
        if digit == $ff
            parse_end = index
            return 0
        elsif digits == 4
            parse_end = index
            return 0
        else
            value = append_hex_digit(value, digit)
            digits = digits + 1
            index = index + 1
        end
    end
    parse_end = index
    parse_ok = digits
    return value
end

function parse_hex_u8(index: u16): u8
    var value: u8
    var digit: u8
    var digits: u8
    index = hex_argument_start(index)
    value = 0
    digits = 0
    parse_ok = 0
    while index < line_len and command_buffer[index] != ' '
        digit = hex_digit(command_buffer[index])
        if digit == $ff
            parse_end = index
            return 0
        elsif digits == 2
            parse_end = index
            return 0
        else
            value = value + value
            value = value + value
            value = value + value
            value = value + value
            value = value + digit
            digits = digits + 1
            index = index + 1
        end
    end
    parse_end = index
    parse_ok = digits
    return value
end

procedure peek_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if parse_ok == 0
        console_write_unknown()
    elsif parse_end != line_len
        console_write_unknown()
    else
        ptr = addr
        value = ptr^
        console_write('$')
        console_write_hex16(addr)
        console_write_text(" = $")
        console_write_hex8(value)
        console_newline()
    end
    return
end

procedure poke_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if parse_ok == 0
        console_write_unknown()
    elsif parse_end >= line_len
        console_write_unknown()
    elsif command_buffer[parse_end] != ' '
        console_write_unknown()
    else
        value = parse_hex_u8(parse_end + 1)
        if parse_ok == 0
            console_write_unknown()
        elsif parse_end != line_len
            console_write_unknown()
        else
            ptr = addr
            ptr^ = value
            console_write_text("OK\r\n")
        end
    end
    return
end

procedure write_dir()
    console_write_text("Directory of ")
    write_path()
    if current_dir == DIR_ROOT
        files_write_root_dir()
    else
        files_write_games_dir()
    end
    return
end

procedure write_memory_range(name: near ^u8, first: u16, last: u16)
    console_write_text(name)
    console_write(' ')
    console_write('$')
    console_write_hex16(first)
    console_write('-')
    console_write('$')
    console_write_hex16(last)
    console_newline()
    return
end

procedure write_memory_map()
    console_write_text("Memory map:\r\n")
    write_memory_range("RAM", $0000, $8fff)
    write_memory_range("I/O", $9f00, $9fff)
    write_memory_range("ROM", $c000, $ffff)
    return
end

procedure write_memory_status()
    console_write_text("Memory status:\r\n")
    write_memory_range("Direct", $0080, $00ff)
    write_memory_range("BSS", $9000, $9eff)
    console_write_text("Line buffer $0020\r\n")
    console_write_text("Serial rings $0040\r\n")
    return
end

procedure write_prompt_mode()
    console_write_text("Prompt: ")
    if prompt_mode == PROMPT_SHORT
        console_write_text("SHORT\r\n")
    else
        console_write_text("FULL\r\n")
    end
    return
end

procedure write_path_mode()
    console_write_text("PATH=")
    if path_mode == PATH_CURRENT
        console_write_text(".\r\n")
    else
        console_write_text("/\r\n")
    end
    return
end

procedure configure_prompt()
    if command_word_matches("PROMPT") != 0
        write_prompt_mode()
    else
        if set_prompt_mode(7) == 0
            console_write_unknown()
        end
    end
    return
end

function set_prompt_mode(index: u16): u8
    if argument_word_matches(index, "SHORT") != 0
        prompt_mode = PROMPT_SHORT
        return 1
    elsif argument_word_matches(index, "FULL") != 0
        prompt_mode = PROMPT_FULL
        return 1
    else
        return 0
    end
end

function set_path_mode(index: u16): u8
    if argument_word_matches(index, ".") != 0
        path_mode = PATH_CURRENT
        return 1
    elsif argument_word_matches(index, "/") != 0
        path_mode = PATH_ROOT
        return 1
    else
        return 0
    end
end

procedure configure_path()
    if command_word_matches("PATH") != 0
        write_path_mode()
    elsif set_path_mode(5) == 0
        console_write_unknown()
    end
    return
end

procedure write_environment()
    console_write_text("DRIVE=")
    console_write(current_drive)
    console_newline()
    console_write_text("DIR=")
    write_dir_prefix()
    console_newline()
    console_write_text("PROMPT=")
    if prompt_mode == PROMPT_SHORT
        console_write_text("SHORT\r\n")
    else
        console_write_text("FULL\r\n")
    end
    write_path_mode()
    return
end

function set_drive_from_argument(index: u16): u8
    if line_len == index + 1 and is_drive_letter(command_buffer[index]) != 0
        current_drive = normalized_drive(command_buffer[index])
        return 1
    else
        return 0
    end
end

procedure configure_set()
    if command_word_matches("SET") != 0
        write_environment()
    elsif argument_name_matches(4, "PROMPT") != 0
        if set_prompt_mode(11) == 0
            console_write_unknown()
        end
    elsif argument_name_matches(4, "DRIVE") != 0
        if set_drive_from_argument(10) == 0
            console_write_unknown()
        end
    elsif argument_name_matches(4, "PATH") != 0
        if set_path_mode(9) == 0
            console_write_unknown()
        end
    else
        console_write_unknown()
    end
    return
end

function type_file_code(): u8
    var start: u16
    start = argument_start("T", "TYPE")
    if current_dir == DIR_ROOT
        if argument_word_matches(start, "README.TXT") != 0
            return FILE_README
        elsif argument_word_matches(start, "README") != 0
            return FILE_README
        elsif argument_word_matches(start, "SYSTEM.TXT") != 0
            return FILE_SYSTEM
        elsif argument_word_matches(start, "SYSTEM") != 0
            return FILE_SYSTEM
        else
            return FILE_UNKNOWN
        end
    elsif argument_word_matches(start, "DEMO.TXT") != 0
        return FILE_DEMO
    elsif argument_word_matches(start, "DEMO") != 0
        return FILE_DEMO
    else
        return FILE_UNKNOWN
    end
end

function run_program_code(): u8
    var start: u16
    start = argument_start("R", "RUN")
    return program_code_at(start)
end

function bare_program_code(): u8
    var code: u8
    code = program_code_at(0)
    if code != FILE_UNKNOWN
        return code
    elsif path_mode == PATH_ROOT
        return root_program_code_at(0)
    else
        return FILE_UNKNOWN
    end
end

function program_code_at(start: u16): u8
    if current_dir == DIR_ROOT
        return root_program_code_at(start)
    elsif argument_word_matches(start, "DEMO.PRG") != 0
        return PROGRAM_DEMO
    elsif argument_word_matches(start, "DEMO") != 0
        return PROGRAM_DEMO
    else
        return FILE_UNKNOWN
    end
end

function root_program_code_at(start: u16): u8
    if argument_word_matches(start, "HELLO.PRG") != 0
        return PROGRAM_HELLO
    elsif argument_word_matches(start, "HELLO") != 0
        return PROGRAM_HELLO
    else
        return FILE_UNKNOWN
    end
end

procedure run_program_code_value(code: u8)
    if code == PROGRAM_HELLO
        files_run_hello()
    elsif code == PROGRAM_DEMO
        files_run_demo()
    else
        files_write_program_not_found()
    end
    return
end

procedure run_program()
    direct var code: u8
    code = run_program_code()
    run_program_code_value(code)
    return
end

procedure run_bare_program()
    direct var code: u8
    code = bare_program_code()
    run_program_code_value(code)
    return
end

procedure type_file()
    direct var code: u8
    code = type_file_code()
    if code == FILE_README
        files_type_readme()
    elsif code == FILE_SYSTEM
        files_type_system()
    elsif code == FILE_DEMO
        files_type_demo()
    else
        files_write_not_found()
    end
    return
end

procedure change_dir()
    if line_len == 2
        init_path()
    elsif argument_word_matches(3, "/") != 0
        init_path()
    elsif argument_word_matches(3, "..") != 0
        init_path()
    elsif argument_word_matches(3, "GAMES") != 0
        set_games_path()
    else
        files_write_path_not_found()
    end
    return
end

procedure write_status()
    console_write_flag('R', serial_rx_overflow())
    console_write_flag('T', serial_tx_overflow())
    return
end

procedure echo_line()
    var index: u16
    index = echo_start()
    if index == line_len
    else
        if command_buffer[index] == ' '
            index = index + 1
        end
    end
    while index != line_len
        console_write(command_buffer[index])
        index = index + 1
    end
    console_newline()
    return
end
