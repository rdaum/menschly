module HellordConsole

external procedure serial_write(value: u8)
external function serial_has_data(): u8
external function serial_read(): u8

export procedure console_write(value: u8)
    serial_write(value)
    return
end

export procedure console_newline()
    serial_write('\r')
    serial_write('\n')
    return
end

export procedure console_prompt()
    serial_write('A')
    serial_write('>')
    serial_write(' ')
    return
end

export function console_read(): u8
    while serial_has_data() == 0
    end
    return serial_read()
end

export procedure console_write_greeting()
    serial_write('H')
    serial_write('e')
    serial_write('l')
    serial_write('l')
    serial_write('o')
    serial_write('r')
    serial_write('d')
    serial_write(' ')
    serial_write('D')
    serial_write('O')
    serial_write('S')
    serial_write(' ')
    serial_write('0')
    serial_write('.')
    serial_write('1')
    console_newline()
    serial_write('T')
    serial_write('y')
    serial_write('p')
    serial_write('e')
    serial_write(' ')
    serial_write('H')
    serial_write(' ')
    serial_write('f')
    serial_write('o')
    serial_write('r')
    serial_write(' ')
    serial_write('h')
    serial_write('e')
    serial_write('l')
    serial_write('p')
    serial_write('.')
    console_newline()
    return
end

export procedure console_write_help()
    serial_write('C')
    serial_write('o')
    serial_write('m')
    serial_write('m')
    serial_write('a')
    serial_write('n')
    serial_write('d')
    serial_write('s')
    serial_write(':')
    console_newline()
    serial_write('H')
    serial_write(' ')
    serial_write(' ')
    serial_write('h')
    serial_write('e')
    serial_write('l')
    serial_write('p')
    console_newline()
    serial_write('V')
    serial_write(' ')
    serial_write(' ')
    serial_write('v')
    serial_write('e')
    serial_write('r')
    serial_write('s')
    serial_write('i')
    serial_write('o')
    serial_write('n')
    console_newline()
    serial_write('D')
    serial_write(' ')
    serial_write(' ')
    serial_write('d')
    serial_write('i')
    serial_write('r')
    console_newline()
    serial_write('E')
    serial_write(' ')
    serial_write(' ')
    serial_write('e')
    serial_write('c')
    serial_write('h')
    serial_write('o')
    console_newline()
    return
end

export procedure console_write_version()
    serial_write('H')
    serial_write('e')
    serial_write('l')
    serial_write('l')
    serial_write('o')
    serial_write('r')
    serial_write('d')
    serial_write(' ')
    serial_write('D')
    serial_write('O')
    serial_write('S')
    serial_write(' ')
    serial_write('0')
    serial_write('.')
    serial_write('1')
    console_newline()
    return
end

export procedure console_write_dir()
    serial_write('N')
    serial_write('o')
    serial_write(' ')
    serial_write('d')
    serial_write('r')
    serial_write('i')
    serial_write('v')
    serial_write('e')
    serial_write('s')
    serial_write(' ')
    serial_write('m')
    serial_write('o')
    serial_write('u')
    serial_write('n')
    serial_write('t')
    serial_write('e')
    serial_write('d')
    console_newline()
    return
end

export procedure console_write_unknown()
    serial_write('?')
    serial_write('S')
    serial_write('Y')
    serial_write('N')
    serial_write('T')
    serial_write('A')
    serial_write('X')
    console_newline()
    return
end
