    elsif command_word_matches("ECHO") != 0
        return 4
    else
        return 5
    end
end

procedure read_line()
    var ch: u8
    var done: u8
    line_len = 0
    done = 0
    repeat
        ch = console_read()
        if ch == '\r'
            console_newline()
            done = 1
        else
            if ch == '\n'
                console_newline()
                done = 1
            else
                if ch == BACKSPACE
                    erase_char()
                else
                    if ch == DELETE
                        erase_char()
                    else
                        if ch == RECALL
                            recall_history()
                        else
                            if line_len < LINE_LIMIT
                                command_buffer[line_len] = ch
                                line_len = line_len + 1
                                console_write(ch)
                            end
                        end
                    end
                end
            end
        end
    until done != 0
    return
end

procedure recall_history()
    var index: u16
    if line_len == 0
        index = 0
        while index != history_len
            command_buffer[index] = history_buffer[index]
            console_write(command_buffer[index])
            index = index + 1
        end
        line_len = history_len
    end
    return
end

procedure save_history()
    var index: u16
    if line_len == 0
        return
    end
    index = 0
    while index != line_len
        history_buffer[index] = command_buffer[index]
        index = index + 1
    end
    history_len = line_len
    return
end

procedure erase_char()
    if line_len == 0
    else
        line_len = line_len - 1
        console_write(BACKSPACE)
        console_write(' ')
        console_write(BACKSPACE)
    end
    return
end

procedure dispatch_line()
    var code: u8
    code = command_code()
    if code == COMMAND_EMPTY
        return
    elsif code == COMMAND_HELP
        console_write_help()
    elsif code == COMMAND_VERSION
        console_write_version()
    elsif code == COMMAND_DIR
        write_dir()
    elsif code == COMMAND_STATUS
        write_status()
    elsif code == COMMAND_PWD
        write_path()
    elsif code == COMMAND_MAP
        write_memory_map()
    elsif code == COMMAND_MEM
        write_memory_status()
    elsif code == COMMAND_CLS
        console_clear()
    elsif code == COMMAND_PROMPT
        configure_prompt()
    elsif code == COMMAND_PATH
        configure_path()
    elsif code == COMMAND_PEEK
        peek_memory()
    elsif code == COMMAND_POKE
        poke_memory()
    elsif code == COMMAND_DUMP
        dump_memory()
    elsif code == COMMAND_FILL
        fill_memory()
    elsif code == COMMAND_REBOOT
        machine_reboot()
    elsif code == COMMAND_BLKINFO
        write_block_info()
    elsif code == COMMAND_SET
        configure_set()
    elsif code == COMMAND_RUN
        run_program()
    elsif code == COMMAND_PROGRAM
        run_bare_program()
    elsif code == COMMAND_TYPE
        type_file()
    elsif code == COMMAND_CD
        change_dir()
    elsif code == COMMAND_ECHO
        echo_line()
    elsif code == COMMAND_DRIVE
        select_drive()
    else
        console_write_unknown()
    end
    return
end

procedure prompt()
    if prompt_mode == PROMPT_SHORT
        console_prompt_drive(current_drive)
    else
        write_path_prefix()
        console_write_text("> ")
    end
    return
end

procedure select_drive()
    current_drive = normalized_drive(command_buffer[0])
    return
end

procedure write_path()
    write_path_prefix()
    console_newline()
    return
end

procedure write_path_prefix()
    var index: u16
    console_write(current_drive)
    console_write(':')
    index = 0
    while index != path_len
        console_write(current_path[index])
        index = index + 1
    end
    return
end

procedure write_dir_prefix()
    var index: u16
    index = 0
    while index != path_len
        console_write(current_path[index])
        index = index + 1
    end
    return
end

function hex_digit(value: u8): u8
    value = normalized_drive(value)
    if value >= '0' and value <= '9'
        return value - '0'
    elsif value >= 'A' and value <= 'F'
        return value - 'A' + 10
    else
        return $ff
    end
end

function hex_argument_start(index: u16): u16
    if index < line_len and command_buffer[index] == '$'
        return index + 1
    else
        return index
    end
end

function append_hex_digit(value: u16, digit: u8): u16
    value = value + value
    value = value + value
    value = value + value
    value = value + value
    if digit == 0
        return value
    elsif digit == 1
        return value + 1
    elsif digit == 2
        return value + 2
    elsif digit == 3
        return value + 3
    elsif digit == 4
        return value + 4
    elsif digit == 5
        return value + 5
    elsif digit == 6
        return value + 6
    elsif digit == 7
        return value + 7
    elsif digit == 8
        return value + 8
    elsif digit == 9
        return value + 9
    elsif digit == 10
        return value + 10
    elsif digit == 11
        return value + 11
    elsif digit == 12
        return value + 12
    elsif digit == 13
        return value + 13
    elsif digit == 14
        return value + 14
    else
        return value + 15
    end
end

function parse_hex_u16(index: u16): u16
    var value: u16
    var digit: u8
    var digits: u8
    index = hex_argument_start(index)
    value = 0
    digits = 0
    parse_ok = 0
    while index < line_len and command_buffer[index] != ' '
        digit = hex_digit(command_buffer[index])
        if digit == $ff
            parse_end = index
            return 0
        elsif digits == 4
            parse_end = index
            return 0
        else
            value = append_hex_digit(value, digit)
            digits = digits + 1
            index = index + 1
        end
    end
    parse_end = index
    parse_ok = digits
    return value
end

function parse_hex_u8(index: u16): u8
    var value: u8
    var digit: u8
    var digits: u8
    index = hex_argument_start(index)
    value = 0
    digits = 0
    parse_ok = 0
    while index < line_len and command_buffer[index] != ' '
        digit = hex_digit(command_buffer[index])
        if digit == $ff
            parse_end = index
            return 0
        elsif digits == 2
            parse_end = index
            return 0
        else
            value = value + value
            value = value + value
            value = value + value
            value = value + value
            value = value + digit
            digits = digits + 1
            index = index + 1
        end
    end
    parse_end = index
    parse_ok = digits
    return value
end

procedure peek_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if parse_ok == 0
        console_write_unknown()
    elsif parse_end != line_len
        console_write_unknown()
    else
        ptr = addr
        value = ptr^
        console_write('$')
        console_write_hex16(addr)
        console_write_text(" = $")
        console_write_hex8(value)
        console_newline()
    end
    return
end

procedure poke_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if parse_ok == 0
        console_write_unknown()
    elsif parse_end >= line_len
        console_write_unknown()
    elsif command_buffer[parse_end] != ' '
        console_write_unknown()
    else
        value = parse_hex_u8(parse_end + 1)
        if parse_ok == 0
            console_write_unknown()
        elsif parse_end != line_len
            console_write_unknown()
        else
            ptr = addr
            ptr^ = value
            console_write_text("OK\r\n")
        end
    end
    return
end

procedure dump_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var count: u8
    direct var length: u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if parse_ok == 0
        console_write_unknown()
    elsif parse_end >= line_len
        console_write_unknown()
    elsif command_buffer[parse_end] != ' '
        console_write_unknown()
    else
        length = parse_hex_u8(parse_end + 1)
        if parse_ok == 0
            console_write_unknown()
        elsif parse_end != line_len
            console_write_unknown()
        elsif length == 0
            console_write_unknown()
        elsif length > $10
            console_write_unknown()
        else
            ptr = addr
            count = 0
            console_write('$')
            console_write_hex16(addr)
            console_write_text(": ")
            while count != length
                if count != 0
                    console_write(' ')
                end
                value = ptr^
                console_write_hex8(value)
                ptr = ptr + 1
                count = count + 1
            end
            console_newline()
        end
    end
    return
end

procedure fill_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var count: u8
    direct var length: u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if parse_ok == 0
        console_write_unknown()
    elsif parse_end >= line_len
        console_write_unknown()
    elsif command_buffer[parse_end] != ' '
        console_write_unknown()
    else
        length = parse_hex_u8(parse_end + 1)
        if parse_ok == 0
            console_write_unknown()
        elsif parse_end >= line_len
            console_write_unknown()
        elsif command_buffer[parse_end] != ' '
            console_write_unknown()
        elsif length == 0
            console_write_unknown()
        elsif length > $10
            console_write_unknown()
        else
            value = parse_hex_u8(parse_end + 1)
            if parse_ok == 0
                console_write_unknown()
            elsif parse_end != line_len
                console_write_unknown()
            else
                ptr = addr
                count = 0
                while count != length
                    ptr^ = value
                    ptr = ptr + 1
                    count = count + 1
                end
                console_write_text("OK\r\n")
            end
        end
    end
    return
end

procedure write_dir()
    console_write_text("Directory of ")
    write_path()
    dos_fs_write_dir()
    return
end

function dos_current_fs_driver(): u8
    return dos_drive_fs_driver(current_drive)
end

procedure dos_fs_write_dir()
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        romfs_write_dir()
    elsif dos_current_fs_driver() == FS_DRIVER_FAT
        fat_write_dir()
    else
        files_write_path_not_found()
    end
    return
end

reentrant procedure fat_write_dir()
    var files: u16
    var dirs: u16
    var status: u16
    var index: u16
    files = 0
    dirs = 0
    status = dos_fsfirst(addr(fat_dta))
    while status == DOS_OK
        index = 3
        while fat_dta[index] != 0
            console_write(fat_dta[index])
            index = index + 1
        end
        while index != 16
            console_write(' ')
            index = index + 1
        end
        if fat_dta[0] & GEMDOS_ATTR_DIR != 0
            console_write_text("<DIR>")
            dirs = dirs + 1
        else
            console_write('$')
            console_write_hex16(u16(fat_dta[1]) | u16(fat_dta[2]) << 8)
            files = files + 1
        end
        console_newline()
        status = dos_fsnext(addr(fat_dta))
    end
    console_write_hex8(u8(files))
    console_write_text(" file(s)  ")
    console_write_hex8(u8(dirs))
    console_write_text(" dir(s)\r\n")
    return
end

reentrant procedure fat_type_file(start: u16)
    var index: u16
    var handle: u16
    var ch: u8
    index = 0
    while start < line_len and index != 15
        fat_name[index] = command_buffer[start]
        start = start + 1
        index = index + 1
    end
    fat_name[index] = 0
    handle = dos_fopen(addr(fat_name))
    if handle < DOS_HANDLE_BASE or handle >= DOS_HANDLE_LIMIT
        files_write_not_found()
        return
    end
    while dos_fread(handle, 1, addr(fat_dta)) == 1
        ch = fat_dta[0]
        if ch == '\n'
            console_newline()
        elsif ch != '\r'
            console_write(ch)
        end
    end
    handle = dos_fclose(handle)
    return
end

procedure romfs_write_dir()
    if current_dir == DIR_ROOT
        files_write_root_dir()
    else
        files_write_games_dir()
    end
    return
end

reentrant function romfs_search_next(dta: near ^u8): u16
    if dos_search_dir == DIR_ROOT
        if dos_search_next == 0
            dos_search_next = 1
            romfs_write_search_entry(dta, "README.TXT", 49, 0)
            return DOS_OK
        elsif dos_search_next == 1
            dos_search_next = 2
            romfs_write_search_entry(dta, "SYSTEM.TXT", 65, 0)
            return DOS_OK
        elsif dos_search_next == 2
            dos_search_next = 3
            romfs_write_search_entry(dta, "HELLO.PRG", 37, 0)
            return DOS_OK
        elsif dos_search_next == 3
            dos_search_next = 4
            romfs_write_search_entry(dta, "GAMES", 0, GEMDOS_ATTR_DIR)
            return DOS_OK
        else
            return DOS_ERR_NO_MORE_FILES
        end
    else
        if dos_search_next == 0
            dos_search_next = 1
            romfs_write_search_entry(dta, "DEMO.TXT", 48, 0)
            return DOS_OK
        elsif dos_search_next == 1
            dos_search_next = 2
            romfs_write_search_entry(dta, "DEMO.PRG", 36, 0)
            return DOS_OK
        else
            return DOS_ERR_NO_MORE_FILES
        end
    end
end

reentrant procedure romfs_write_search_entry(dta: near ^u8, name: near ^u8, size: u16, attr: u8)
    dta^ = attr
    dta = dta + 1
    dta^ = u8(size)
    dta = dta + 1
    dta^ = 0
    dta = dta + 1
    while name^ != 0
        dta^ = name^
        dta = dta + 1
        name = name + 1
    end
    dta^ = 0
    return
end

procedure write_memory_range(name: near ^u8, first: u16, last: u16)
    console_write_text(name)
    console_write(' ')
    console_write('$')
    console_write_hex16(first)
    console_write('-')
    console_write('$')
    console_write_hex16(last)
    console_newline()
    return
end

procedure write_memory_map()
    console_write_text("Memory map:\r\n")
    write_memory_range("RAM", $0000, $8fff)
    write_memory_range("I/O", $9f00, $9fff)
    write_memory_range("ROM", $c000, $ffff)
    return
end

procedure write_memory_status()
    console_write_text("Memory status:\r\n")
    write_memory_range("Direct", $0080, $00ff)
    write_memory_range("BSS", $9000, $9eff)
    console_write_text("Line buffer $0020\r\n")
    console_write_text("Serial rings $0040\r\n")
    return
end

procedure write_block_info()
    var status: u16
    var sectors: u16
    var read_status: u16
    var index: u16
    status = dos_drive_block_status(current_drive)
    sectors = dos_drive_block_sector_count(current_drive)
    console_write_text("Drive ")
    console_write(current_drive)
    console_write_text(" block:\r\n")
    if dos_drive_bios_device(current_drive) == 0
        console_write_text("No block device\r\n")
        return
    end
    console_write_text("Status $")
    console_write_hex8(u8(status))
    console_write_text("\r\nSectors $")
    console_write_hex16(sectors)
    console_newline()
    read_status = dos_drive_read_blocks(current_drive, 0, 1, addr(block_sector_buffer))
    if read_status == DOS_BLOCK_OK
        console_write_text("Sector0:")
        index = 0
        while index != 16
            console_write(' ')
            console_write_hex8(block_sector_buffer[index])
            index = index + 1
        end
        console_newline()
    else
        console_write_text("Read error $")
        console_write_hex8(u8(read_status))
        console_newline()
    end
    return
end

procedure write_prompt_mode()
    console_write_text("Prompt: ")
    if prompt_mode == PROMPT_SHORT
        console_write_text("SHORT\r\n")
    else
        console_write_text("FULL\r\n")
    end
    return
end

procedure write_path_mode()
    console_write_text("PATH=")
    if path_mode == PATH_CURRENT
        console_write_text(".\r\n")
    else
        console_write_text("/\r\n")
    end
    return
end

procedure configure_prompt()
    if command_word_matches("PROMPT") != 0
        write_prompt_mode()
    else
        if set_prompt_mode(7) == 0
            console_write_unknown()
        end
    end
    return
end

function set_prompt_mode(index: u16): u8
    if argument_word_matches(index, "SHORT") != 0
        prompt_mode = PROMPT_SHORT
        return 1
    elsif argument_word_matches(index, "FULL") != 0
        prompt_mode = PROMPT_FULL
        return 1
    else
        return 0
    end
end

function set_path_mode(index: u16): u8
    if argument_word_matches(index, ".") != 0
        path_mode = PATH_CURRENT
        return 1
    elsif argument_word_matches(index, "/") != 0
        path_mode = PATH_ROOT
        return 1
    else
        return 0
    end
end

procedure configure_path()
    if command_word_matches("PATH") != 0
        write_path_mode()
    elsif set_path_mode(5) == 0
        console_write_unknown()
    end
    return
end

procedure write_environment()
    console_write_text("DRIVE=")
    console_write(current_drive)
    console_newline()
    console_write_text("DIR=")
    write_dir_prefix()
    console_newline()
    console_write_text("PROMPT=")
    if prompt_mode == PROMPT_SHORT
        console_write_text("SHORT\r\n")
    else
        console_write_text("FULL\r\n")
    end
    write_path_mode()
    return
end

function set_drive_from_argument(index: u16): u8
    if line_len == index + 1 and is_drive_letter(command_buffer[index]) != 0
        current_drive = normalized_drive(command_buffer[index])
        return 1
    else
        return 0
    end
end

procedure configure_set()
    if command_word_matches("SET") != 0
        write_environment()
    elsif argument_name_matches(4, "PROMPT") != 0
        if set_prompt_mode(11) == 0
            console_write_unknown()
        end
    elsif argument_name_matches(4, "DRIVE") != 0
        if set_drive_from_argument(10) == 0
            console_write_unknown()
        end
    elsif argument_name_matches(4, "PATH") != 0
        if set_path_mode(9) == 0
            console_write_unknown()
        end
    else
        console_write_unknown()
    end
    return
end

function type_file_code(): u8
    var start: u16
    start = argument_start("T", "TYPE")
    return dos_fs_type_file_code(start)
end

function dos_fs_type_file_code(start: u16): u8
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_type_file_code(start)
    else
        return FILE_UNKNOWN
    end
end

reentrant function dos_fs_file_code(path: near ^u8): u8
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_file_code(path)
    else
        return FILE_UNKNOWN
    end
end

reentrant function romfs_file_code(path: near ^u8): u8
    if path^ == '/'
        path = path + 1
        return romfs_root_file_code(path)
    elsif current_dir == DIR_ROOT
        return romfs_root_file_code(path)
    else
        return romfs_games_file_code(path)
    end
end

reentrant function romfs_root_file_code(path: near ^u8): u8
    if file_name_is_readme(path) != 0
        return FILE_README
    elsif file_name_is_system(path) != 0
        return FILE_SYSTEM
    else
        return FILE_UNKNOWN
    end
end

reentrant function romfs_games_file_code(path: near ^u8): u8
    if file_name_is_demo(path) != 0
        return FILE_DEMO
    else
        return FILE_UNKNOWN
    end
end

function romfs_type_file_code(start: u16): u8
    if current_dir == DIR_ROOT
        if argument_word_matches(start, "README.TXT") != 0
            return FILE_README
        elsif argument_word_matches(start, "README") != 0
            return FILE_README
        elsif argument_word_matches(start, "SYSTEM.TXT") != 0
            return FILE_SYSTEM
        elsif argument_word_matches(start, "SYSTEM") != 0
            return FILE_SYSTEM
        else
            return FILE_UNKNOWN
        end
    elsif argument_word_matches(start, "DEMO.TXT") != 0
        return FILE_DEMO
    elsif argument_word_matches(start, "DEMO") != 0
        return FILE_DEMO
    else
        return FILE_UNKNOWN
    end
end

reentrant function dos_alloc_handle(driver: u8, code: u8): u16
    var slot: u16
    slot = 0
    while slot != DOS_MAX_HANDLES
        if dos_handle_file[slot] == FILE_UNKNOWN
            dos_handle_driver[slot] = driver
            dos_handle_file[slot] = code
            dos_handle_offset[slot] = 0
            dos_handle_drive[slot] = u8(dos_drive_index(current_drive))
            dos_handle_lba[slot] = 0
            dos_handle_size[slot] = 0
            return slot + DOS_HANDLE_BASE
        end
        slot = slot + 1
    end
    return DOS_ERR_ACCESS_DENIED
end

reentrant function dos_handle_slot_valid(handle: u16): u8
    if handle < DOS_HANDLE_BASE
        return 0
    elsif handle >= DOS_HANDLE_LIMIT
        return 0
    else
        return 1
    end
end

reentrant function dos_file_size(driver: u8, code: u8): u16
    if driver == FS_DRIVER_ROMFS
        return romfs_file_size(code)
    elsif driver == FS_DRIVER_FAT
        return fat_file_size(u16(dos_current_read_slot))
    else
        return 0
    end
end

reentrant function dos_file_byte(driver: u8, code: u8, offset: u16): u8
    if driver == FS_DRIVER_ROMFS
        return romfs_file_byte(code, offset)
    elsif driver == FS_DRIVER_FAT
        return fat_file_byte(u16(dos_current_read_slot), offset)
    else
        return 0
    end
end

reentrant function romfs_file_size(code: u8): u16
    if code == FILE_README
        return 49
    elsif code == FILE_SYSTEM
        return 65
    elsif code == FILE_DEMO
        return 48
    else
        return 0
    end
end

reentrant function romfs_file_byte(code: u8, offset: u16): u8
    if code == FILE_README
        return readme_byte(offset)
    elsif code == FILE_SYSTEM
        return system_byte(offset)
    elsif code == FILE_DEMO
        return demo_byte(offset)
    else
        return 0
    end
end

reentrant function readme_byte(offset: u16): u8
    return string_byte_at("Hellord is a tiny Mensch DOS for the x65-alike.\r\n", offset)
end

reentrant function system_byte(offset: u16): u8
    return string_byte_at("CPU: 65816\r\nConsole: USB UART IRQ rings\r\nStorage: ROM file table\r\n", offset)
end

reentrant function demo_byte(offset: u16): u8
    return string_byte_at("No games yet, but the directory layer works.\r\n", offset)
end

reentrant function string_byte_at(text: near ^u8, offset: u16): u8
    while offset != 0
        text = text + 1
        offset = offset - 1
    end
    return text^
end

reentrant function file_name_is_readme(path: near ^u8): u8
    if normalized_drive(path^) != 'R'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'E'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'A'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'D'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'M'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'E'
        return 0
    end
    path = path + 1
    if path^ == 0
        return 1
    elsif path^ == '.'
        path = path + 1
        if normalized_drive(path^) != 'T'
            return 0
        end
        path = path + 1
        if normalized_drive(path^) != 'X'
            return 0
        end
        path = path + 1
        if normalized_drive(path^) != 'T'
            return 0
        end
        path = path + 1
        if path^ == 0
            return 1
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function file_name_is_system(path: near ^u8): u8
    if normalized_drive(path^) != 'S'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'Y'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'S'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'T'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'E'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'M'
        return 0
    end
    path = path + 1
    if path^ == 0
        return 1
    elsif path^ == '.'
        path = path + 1
        if normalized_drive(path^) != 'T'
            return 0
        end
        path = path + 1
        if normalized_drive(path^) != 'X'
            return 0
        end
        path = path + 1
        if normalized_drive(path^) != 'T'
            return 0
        end
        path = path + 1
        if path^ == 0
            return 1
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function file_name_is_demo(path: near ^u8): u8
    if normalized_drive(path^) != 'D'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'E'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'M'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'O'
        return 0
    end
    path = path + 1
    if path^ == 0
        return 1
    elsif path^ == '.'
        path = path + 1
        if normalized_drive(path^) != 'T'
            return 0
        end
        path = path + 1
        if normalized_drive(path^) != 'X'
            return 0
        end
        path = path + 1
        if normalized_drive(path^) != 'T'
            return 0
        end
        path = path + 1
        if path^ == 0
            return 1
        else
            return 0
        end
    else
        return 0
    end
end

function run_program_code(): u8
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_run_program_code()
    else
        return FILE_UNKNOWN
    end
end

function bare_program_code(): u8
    var code: u8
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        code = romfs_program_code_at(0)
    else
        code = FILE_UNKNOWN
    end
    if code != FILE_UNKNOWN
        return code
    elsif path_mode == PATH_ROOT
        if dos_current_fs_driver() == FS_DRIVER_ROMFS
            return romfs_root_program_code_at(0)
        else
            return FILE_UNKNOWN
        end
    else
        return FILE_UNKNOWN
    end
end

function romfs_run_program_code(): u8
    var start: u16
    start = argument_start("R", "RUN")
    return romfs_program_code_at(start)
end

function romfs_program_code_at(start: u16): u8
    if current_dir == DIR_ROOT
        return romfs_root_program_code_at(start)
    elsif argument_word_matches(start, "DEMO.PRG") != 0
        return PROGRAM_DEMO
    elsif argument_word_matches(start, "DEMO") != 0
        return PROGRAM_DEMO
    else
        return FILE_UNKNOWN
    end
end

function romfs_root_program_code_at(start: u16): u8
    if argument_word_matches(start, "HELLO.PRG") != 0
        return PROGRAM_HELLO
    elsif argument_word_matches(start, "HELLO") != 0
        return PROGRAM_HELLO
    else
        return FILE_UNKNOWN
    end
end

procedure run_program_code_value(code: u8)
    romfs_run_program_code_value(code)
    return
end

procedure romfs_run_program_code_value(code: u8)
    if code == PROGRAM_HELLO
        files_run_hello()
    elsif code == PROGRAM_DEMO
        files_run_demo()
    else
        files_write_program_not_found()
    end
    return
end

procedure run_program()
    var code: u8
    code = run_program_code()
    run_program_code_value(code)
    return
end

procedure run_bare_program()
    var code: u8
    code = bare_program_code()
    run_program_code_value(code)
    return
end

procedure type_file()
    var code: u8
    if dos_current_fs_driver() == FS_DRIVER_FAT
        fat_type_file(argument_start("T", "TYPE"))
        return
    end
    code = type_file_code()
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        romfs_type_file_code_value(code)
    else
        files_write_not_found()
    end
    return
end

procedure romfs_type_file_code_value(code: u8)
    if code == FILE_README
        files_type_readme()
    elsif code == FILE_SYSTEM
        files_type_system()
    elsif code == FILE_DEMO
        files_type_demo()
    else
        files_write_not_found()
    end
    return
end

procedure change_dir()
    if line_len == 2
        init_path()
    elsif argument_word_matches(3, "/") != 0
        init_path()
    elsif argument_word_matches(3, "..") != 0
        init_path()
    elsif argument_word_matches(3, "GAMES") != 0
        set_games_path()
    else
        files_write_path_not_found()
    end
    return
end

procedure write_status()
    console_write_flag('R', serial_rx_overflow())
    console_write_flag('T', serial_tx_overflow())
    return
end

procedure echo_line()
    var index: u16
    index = echo_start()
    if index == line_len
    else
        if command_buffer[index] == ' '
            index = index + 1
        end
    end
    while index != line_len
        console_write(command_buffer[index])
        index = index + 1
    end
    console_newline()
    return
end
