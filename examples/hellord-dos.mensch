module HellordDos

external procedure console_write(value: u8)
external procedure console_newline()
external procedure console_prompt()
external function console_read(): u8
external procedure console_write_greeting()
external procedure console_write_help()
external procedure console_write_version()
external procedure console_write_dir()
external procedure console_write_unknown()

var line_len: u16
var command_buffer: [32]u8

export procedure dos_boot()
    console_write_greeting()
    console_prompt()
    while 1 != 0
        read_line()
        dispatch_line()
        console_prompt()
    end
end

function command_code(): u8
    if line_len == 0
        return 255
    else
        if command_buffer[0] == 'H'
            return 1
        else
            if command_buffer[0] == 'h'
                return 1
            else
                if command_buffer[0] == 'V'
                    return 2
                else
                    if command_buffer[0] == 'v'
                        return 2
                    else
                        if command_buffer[0] == 'D'
                            return 3
                        else
                            if command_buffer[0] == 'd'
                                return 3
                            else
                                if command_buffer[0] == 'E'
                                    return 4
                                else
                                    if command_buffer[0] == 'e'
                                        return 4
                                    else
                                        return 0
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

procedure read_line()
    var ch: u8
    var done: u8
    line_len = 0
    done = 0
    while done == 0
        ch = console_read()
        if ch == '\r'
            console_newline()
            done = 1
        else
            if ch == '\n'
                console_newline()
                done = 1
            else
                if line_len == 31
                else
                    command_buffer[line_len] = ch
                    line_len = line_len + 1
                    console_write(ch)
                end
            end
        end
    end
    return
end

procedure dispatch_line()
    direct var code: u8
    code = command_code()
    if code == 255
        return
    else
        if code == 1
            console_write_help()
        else
            if code == 2
                console_write_version()
            else
                if code == 3
                    console_write_dir()
                else
                    if code == 4
                        echo_line()
                    else
                        console_write_unknown()
                    end
                end
            end
        end
    end
    return
end

procedure echo_line()
    var index: u16
    index = 1
    while index != line_len
        console_write(command_buffer[index])
        index = index + 1
    end
    console_newline()
    return
end
