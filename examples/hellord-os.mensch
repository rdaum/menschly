module HellordOs
application main
fixed($009f56) volatile var serial_status: u8
fixed($009f57) volatile var serial_data: u8

export procedure main()
    serial_data = 'H'
    serial_data = 'e'
    serial_data = 'l'
    serial_data = 'l'
    serial_data = 'o'
    serial_data = 'r'
    serial_data = 'd'
    serial_data = '!'
    serial_data = '\r'
    serial_data = '\n'

    while 1 != 0
        while serial_status & $80 != 0
        end
        serial_data = serial_data
    end
end
