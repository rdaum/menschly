module HellordDos
# Bank-0 code below the I/O window; the DOS is the largest module.
metadata code_segment = "LOWCODE"

external far procedure console_write(value: u8)
external far procedure console_newline()
external far function console_read(): u8
external far procedure console_write_text(text: near ^u8)
external far procedure console_write_hex8(value: u8)
external far procedure console_write_hex16(value: u16)
external far procedure console_clear()
external far procedure console_write_greeting()
external far procedure console_write_help()
external far procedure console_write_version()
external far procedure console_prompt_drive(drive: u8)
external far procedure console_write_unknown()
external far procedure console_write_flag(name: u8, value: u8)
external far procedure files_write_root_dir()
external far procedure files_write_games_dir()
external far procedure files_type_readme()
external far procedure files_type_system()
external far procedure files_type_demo()
external far procedure files_write_not_found()
external far procedure files_write_program_not_found()
external far procedure files_write_path_not_found()
external far procedure files_run_hello()
external far procedure files_run_demo()
external procedure machine_reboot()
external function serial_rx_overflow(): u8
external function serial_tx_overflow(): u8
external stack function bios_block_status(dev: u16): u16
external stack function bios_block_sector_count(dev: u16): u16
external stack procedure bios_block_set_lba(dev: u16, lba: u16)
external stack function fat_mount(dev: u16, base: u16): u16
external stack procedure fat_dir_rewind()
external stack function fat_dir_next(dta: near ^u8): u16
external stack function fat_open(path: near ^u8, slot: u16): u16
external stack function fat_file_size(slot: u16): u16
external stack function fat_file_byte(slot: u16, offset: u16): u8
external stack function fat_write(slot: u16, offset: u16, count: u16, buffer: near ^u8): u16
external stack function fat_read(slot: u16, offset: u16, count: u16, buffer: near ^u8): u16
external stack function exec_program(path: near ^u8): u16
external stack function bios_block_read(dev: u16, buffer: near ^u8): u16
external stack function bios_block_write(dev: u16, buffer: near ^u8): u16

const COMMAND_UNKNOWN = 0
const COMMAND_HELP = 1
const COMMAND_VERSION = 2
const COMMAND_DIR = 3
const COMMAND_ECHO = 4
const COMMAND_STATUS = 5
const COMMAND_DRIVE = 6
const COMMAND_PWD = 7
const COMMAND_CD = 8
const COMMAND_MAP = 9
const COMMAND_TYPE = 10
const COMMAND_CLS = 11
const COMMAND_PROMPT = 12
const COMMAND_SET = 13
const COMMAND_RUN = 14
const COMMAND_MEM = 15
const COMMAND_PROGRAM = 16
const COMMAND_PATH = 17
const COMMAND_PEEK = 18
const COMMAND_POKE = 19
const COMMAND_DUMP = 20
const COMMAND_FILL = 21
const COMMAND_BLKINFO = 22
const COMMAND_REBOOT = 23
const COMMAND_EMPTY = 255

# Commands, tried in order. A command may stand alone (ACCEPTS_WORD) or
# take arguments (ACCEPTS_ARGUMENTS); `short` and `long` are its names.
const ACCEPTS_WORD = 1
const ACCEPTS_ARGUMENTS = 2
const ACCEPTS_EITHER = 3
const COMMAND_COUNT = 21
type Command = record(short: near ^u8, long: near ^u8, accepts: u8, code: u8)
const COMMANDS: parallel [21]Command = [
    ("H", "HELP", ACCEPTS_WORD, COMMAND_HELP),
    ("V", "VER", ACCEPTS_WORD, COMMAND_VERSION),
    ("D", "DIR", ACCEPTS_WORD, COMMAND_DIR),
    ("S", "STAT", ACCEPTS_WORD, COMMAND_STATUS),
    ("P", "PWD", ACCEPTS_WORD, COMMAND_PWD),
    ("M", "MAP", ACCEPTS_WORD, COMMAND_MAP),
    ("MEM", "MEM", ACCEPTS_WORD, COMMAND_MEM),
    ("C", "CLS", ACCEPTS_WORD, COMMAND_CLS),
    ("PROMPT", "PROMPT", ACCEPTS_EITHER, COMMAND_PROMPT),
    ("PATH", "PATH", ACCEPTS_EITHER, COMMAND_PATH),
    ("PEEK", "PEEK", ACCEPTS_ARGUMENTS, COMMAND_PEEK),
    ("POKE", "POKE", ACCEPTS_ARGUMENTS, COMMAND_POKE),
    ("DUMP", "DUMP", ACCEPTS_ARGUMENTS, COMMAND_DUMP),
    ("FILL", "FILL", ACCEPTS_ARGUMENTS, COMMAND_FILL),
    ("BLK", "BLKINFO", ACCEPTS_WORD, COMMAND_BLKINFO),
    ("REBOOT", "REBOOT", ACCEPTS_WORD, COMMAND_REBOOT),
    ("SET", "SET", ACCEPTS_EITHER, COMMAND_SET),
    ("R", "RUN", ACCEPTS_ARGUMENTS, COMMAND_RUN),
    ("T", "TYPE", ACCEPTS_ARGUMENTS, COMMAND_TYPE),
    ("CD", "CD", ACCEPTS_EITHER, COMMAND_CD),
    ("E", "ECHO", ACCEPTS_EITHER, COMMAND_ECHO),
]
const FILE_UNKNOWN = 0
const FILE_README = 1
const FILE_SYSTEM = 2
const FILE_DEMO = 3
const PROGRAM_HELLO = 1
const PROGRAM_DEMO = 2
# A program file on a FAT drive, loaded by exec_program.
const PROGRAM_FILE = 3
const EXEC_ERR_FORMAT = $ff01
const EXEC_ERR_TOO_LARGE = $ff02
const EXEC_ERR_IMPORTS = $ff03
const EXEC_ERR_BASE_PAGE = $ff04
const DIR_ROOT = 0
const DIR_GAMES = 1
const PROMPT_SHORT = 0
const PROMPT_FULL = 1
const PATH_CURRENT = 0
const PATH_ROOT = 1
const LINE_LIMIT = 31
const PATH_LIMIT = 15
const BACKSPACE = $08
const RECALL = $10
const DELETE = $7f
const LOWERCASE_DELTA = 32
const BIOS_BLOCK0 = $0008
const DRIVE_COUNT = 26
const DRIVE_BACKEND_NONE = 0
const DRIVE_BACKEND_ROMFS = 1
const DRIVE_BACKEND_BIOS_BLOCK = 2
const FS_DRIVER_NONE = 0
const FS_DRIVER_ROMFS = 1
const FS_DRIVER_FAT = 2
const FAT_DRIVE = 18
const DOS_BLOCK_OK = 0
const DOS_BLOCK_ERR_NO_DEVICE = $ffff
const DOS_OK = 0
const DOS_ERR_PATH_NOT_FOUND = $ffff
const DOS_ERR_NO_MORE_FILES = $fffe
const DOS_ERR_FILE_NOT_FOUND = $fffd
const DOS_ERR_BAD_HANDLE = $fffc
const DOS_ERR_ACCESS_DENIED = $fffb
const GEMDOS_ATTR_DIR = $10
const DOS_MAX_HANDLES = 4
const DOS_HANDLE_BASE = 6
const DOS_HANDLE_LIMIT = 10
const FAT_ATTR_VOLUME = $08
const FAT_ATTR_DIRECTORY = $10
const FAT_ATTR_LONG_NAME = $0f

var current_drive: u8
var dos_initialized: u8
var current_dir: u8
var prompt_mode: u8
var path_mode: u8
var path_len: u16
var line_len: u16
var history_len: u16
var parse_end: u16
var parse_ok: u8
# Drives A: to Z:: what backs each one.
type Drive = record(backend: u8, fs_driver: u8, bios_device: u16, partition_lba: u16)
var drives: parallel [26]Drive
var block_cache_valid: u8
var block_cache_drive: u8
var block_cache_lba: u16
var dos_search_dir: u8
var dos_search_next: u8

# The ROM filesystem's directories, as Fsfirst/Fsnext list them.
type RomEntry = record(name: near ^u8, size: u16, attr: u8)
const ROMFS_ROOT_COUNT = 4
const ROMFS_ROOT: parallel [4]RomEntry = [
    ("README.TXT", 49, 0),
    ("SYSTEM.TXT", 65, 0),
    ("HELLO.PRG", 37, 0),
    ("GAMES", 0, GEMDOS_ATTR_DIR),
]
const ROMFS_GAMES_COUNT = 2
const ROMFS_GAMES: parallel [2]RomEntry = [("DEMO.TXT", 48, 0), ("DEMO.PRG", 36, 0)]
var dos_current_read_slot: u8
# Open file handles, by slot.
type Handle = record(driver: u8, file: u8, offset: u16, drive: u8, lba: u16, size: u16)
var handles: parallel [4]Handle
var current_path: [16]u8
var command_buffer: [32]u8
var history_buffer: [32]u8
var block_sector_buffer: [512]u8
var fat_name: [16]u8
var fat_dta: [16]u8

export procedure dos_boot()
    current_drive = 'A'
    prompt_mode = PROMPT_SHORT
    path_mode = PATH_CURRENT
    dos_ensure_init()
    init_path()
    console_write_greeting()
    prompt()
    while 1
        read_line()
        save_history()
        dispatch_line()
        prompt()
    end
end

export stack function dos_get_drive_index(): u16
    dos_ensure_init()
    return dos_drive_index(current_drive)
end

export stack function dos_set_drive_index(drive: u16): u16
    dos_ensure_init()
    if drive >= DRIVE_COUNT
        return 0
    end
    current_drive = u8(drive) + 'A'
    return $ffff
end

export stack function dos_mount_fat_drive(drive: u16): u16
    dos_ensure_init()
    if drive >= DRIVE_COUNT
        return DOS_BLOCK_ERR_NO_DEVICE
    end
    if drives[drive].backend != DRIVE_BACKEND_BIOS_BLOCK
        return DOS_BLOCK_ERR_NO_DEVICE
    end
    drives[drive].fs_driver = FS_DRIVER_FAT
    return DOS_OK
end

export stack function dos_set_path(path: near ^u8): u16
    dos_ensure_init()
    if not path^
        init_path()
        return DOS_OK
    end
    if path_is_root(path)
        init_path()
        return DOS_OK
    end
    if path_is_current(path)
        return DOS_OK
    end
    if path_is_parent(path)
        init_path()
        return DOS_OK
    end
    if name_is(path, "GAMES", "")
        set_games_path()
        return DOS_OK
    end
    if not path_is_root_games(path)
        return DOS_ERR_PATH_NOT_FOUND
    end
    set_games_path()
    return DOS_OK
end

export stack function dos_fsfirst(dta: near ^u8): u16
    dos_ensure_init()
    dos_search_dir = current_dir
    dos_search_next = 0
    if dos_current_fs_driver() == FS_DRIVER_FAT
        if dos_mount_current_fat() != DOS_OK
            return DOS_ERR_NO_MORE_FILES
        end
        fat_dir_rewind()
    end
    return dos_fsnext(dta)
end

# Mounts the current drive's FAT volume (a no-op when already mounted).
stack function dos_mount_current_fat(): u16
    var index: u16
    index = dos_drive_index(current_drive)
    if fat_mount(drives[index].bios_device, drives[index].partition_lba)
        return DOS_ERR_PATH_NOT_FOUND
    end
    return DOS_OK
end

export stack function dos_fsnext(dta: near ^u8): u16
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_search_next(dta)
    end
    if dos_current_fs_driver() != FS_DRIVER_FAT
        return DOS_ERR_NO_MORE_FILES
    end
    if dos_search_dir != DIR_ROOT
        return DOS_ERR_NO_MORE_FILES
    end
    return fat_dir_next(dta)
end

export stack function dos_fopen(path: near ^u8): u16
    var driver: u8
    var code: u8
    dos_ensure_init()
    driver = dos_current_fs_driver()
    if driver == FS_DRIVER_FAT
        return dos_fat_open(path)
    end
    code = dos_fs_file_code(path)
    if code == FILE_UNKNOWN
        return DOS_ERR_FILE_NOT_FOUND
    end
    return dos_alloc_handle(driver, code)
end

export stack function dos_fread(handle: u16, count: u16, buffer: near ^u8): u16
    var slot: u16
    var read_count: u16
    var driver: u8
    var code: u8
    var offset: u16
    var done: u8
    dos_ensure_init()
    if not dos_handle_slot_valid(handle)
        return DOS_ERR_BAD_HANDLE
    end
    slot = handle - DOS_HANDLE_BASE
    driver = handles[slot].driver
    code = handles[slot].file
    if code == FILE_UNKNOWN
        return DOS_ERR_BAD_HANDLE
    end
    dos_current_read_slot = u8(slot)
    offset = handles[slot].offset
    if driver == FS_DRIVER_FAT
        read_count = fat_read(slot, offset, count, buffer)
        handles[slot].offset = offset + read_count
        return read_count
    end
    read_count = 0
    done = 0
    while not done
        if read_count == count
            done = 1
        elsif offset >= dos_file_size(driver, code)
            done = 1
        else
            buffer^ = dos_file_byte(driver, code, offset)
            buffer = buffer + 1
            offset = offset + 1
            read_count = read_count + 1
        end
    end
    handles[slot].offset = offset
    return read_count
end

export stack function dos_fwrite(handle: u16, count: u16, buffer: near ^u8): u16
    var slot: u16
    var written: u16
    dos_ensure_init()
    if not dos_handle_slot_valid(handle)
        return DOS_ERR_BAD_HANDLE
    end
    slot = handle - DOS_HANDLE_BASE
    if handles[slot].file == FILE_UNKNOWN
        return DOS_ERR_BAD_HANDLE
    end
    if handles[slot].driver != FS_DRIVER_FAT
        return DOS_ERR_ACCESS_DENIED
    end
    written = fat_write(slot, handles[slot].offset, count, buffer)
    handles[slot].offset = handles[slot].offset + written
    return written
end

export stack function dos_fclose(handle: u16): u16
    var slot: u16
    dos_ensure_init()
    if not dos_handle_slot_valid(handle)
        return DOS_ERR_BAD_HANDLE
    end
    slot = handle - DOS_HANDLE_BASE
    handles[slot].driver = FS_DRIVER_NONE
    handles[slot].file = FILE_UNKNOWN
    handles[slot].offset = 0
    handles[slot].drive = 0
    handles[slot].lba = 0
    handles[slot].size = 0
    return DOS_OK
end

stack function dos_fat_open(path: near ^u8): u16
    var handle: u16
    var slot: u16
    if current_dir != DIR_ROOT
        return DOS_ERR_FILE_NOT_FOUND
    end
    if dos_mount_current_fat() != DOS_OK
        return DOS_ERR_FILE_NOT_FOUND
    end
    handle = dos_alloc_handle(FS_DRIVER_FAT, 1)
    if handle < DOS_HANDLE_BASE or handle >= DOS_HANDLE_LIMIT
        return handle
    end
    slot = handle - DOS_HANDLE_BASE
    if fat_open(path, slot)
        handles[slot].driver = FS_DRIVER_NONE
        handles[slot].file = FILE_UNKNOWN
        return DOS_ERR_FILE_NOT_FOUND
    end
    return handle
end

export stack function fat_read_sector(drive: u16, lba: u16, buffer: near ^u8): u16
    dos_ensure_init()
    if drive >= DRIVE_COUNT
        return DOS_BLOCK_ERR_NO_DEVICE
    end
    if drives[drive].fs_driver != FS_DRIVER_FAT
        return DOS_BLOCK_ERR_NO_DEVICE
    end
    return dos_drive_read_blocks(u8(drive) + 'A', lba, 1, buffer)
end

export stack function fat_write_sector(drive: u16, lba: u16, buffer: near ^u8): u16
    dos_ensure_init()
    if drive >= DRIVE_COUNT
        return DOS_BLOCK_ERR_NO_DEVICE
    end
    if drives[drive].fs_driver != FS_DRIVER_FAT
        return DOS_BLOCK_ERR_NO_DEVICE
    end
    return dos_drive_write_blocks(u8(drive) + 'A', lba, 1, buffer)
end

function command_code(): u8
    var i: u8
    var accepts: u8
    if not line_len
        return COMMAND_EMPTY
    end
    for i = 0 to COMMAND_COUNT - 1
        accepts = COMMANDS[i].accepts
        if accepts & ACCEPTS_WORD
            if command_word_matches(COMMANDS[i].short) or command_word_matches(COMMANDS[i].long)
                return COMMANDS[i].code
            end
        end
        if accepts & ACCEPTS_ARGUMENTS
            if command_argument_matches(COMMANDS[i].short) or command_argument_matches(COMMANDS[i].long)
                return COMMANDS[i].code
            end
        end
    end
    if is_drive_select()
        return COMMAND_DRIVE
    end
    if bare_program_code()
        return COMMAND_PROGRAM
    end
    return COMMAND_UNKNOWN
end

procedure init_path()
    current_path[0] = '/'
    path_len = 1
    history_len = 0
    parse_end = 0
    parse_ok = 0
    current_dir = DIR_ROOT
    return
end

procedure set_games_path()
    current_path[0] = 'G'
    current_path[1] = 'A'
    current_path[2] = 'M'
    current_path[3] = 'E'
    current_path[4] = 'S'
    path_len = 5
    current_dir = DIR_GAMES
    return
end

function normalized_drive(value: u8): u8
    if value >= 'a' and value <= 'z'
        return value - LOWERCASE_DELTA
    end
    return value
end

stack function path_is_root(path: near ^u8): u8
    if path^ != '/'
        return 0
    end
    path = path + 1
    if not path^
        return 1
    end
    return 0
end

stack function path_is_current(path: near ^u8): u8
    if path^ != '.'
        return 0
    end
    path = path + 1
    if not path^
        return 1
    end
    return 0
end

stack function path_is_parent(path: near ^u8): u8
    if path^ != '.'
        return 0
    end
    path = path + 1
    if path^ != '.'
        return 0
    end
    path = path + 1
    if not path^
        return 1
    end
    return 0
end

stack function path_is_root_games(path: near ^u8): u8
    if path^ != '/'
        return 0
    end
    path = path + 1
    return name_is(path, "GAMES", "")
end

function is_drive_letter(value: u8): u8
    var drive: u8
    drive = normalized_drive(value)
    if drive >= 'A' and drive <= 'Z'
        return 1
    end
    return 0
end

function is_drive_select(): u8
    if line_len == 2 and is_drive_letter(command_buffer[0]) and command_buffer[1] == ':'
        return 1
    end
    return 0
end

stack procedure dos_ensure_init()
    if dos_initialized
        return
    end
    dos_init_drives()
    return
end

procedure dos_init_drives()
    var index: u16
    if not current_drive
        current_drive = 'A'
    end
    for index = 0 to DRIVE_COUNT - 1
        drives[index].backend = DRIVE_BACKEND_ROMFS
        drives[index].fs_driver = FS_DRIVER_ROMFS
        drives[index].bios_device = 0
        drives[index].partition_lba = 0
    end
    drives[0].backend = DRIVE_BACKEND_BIOS_BLOCK
    drives[0].bios_device = BIOS_BLOCK0
    drives[0].partition_lba = 0
    # S: is the block device as a FAT volume (the SD card on the MEGA65).
    drives[FAT_DRIVE].backend = DRIVE_BACKEND_BIOS_BLOCK
    drives[FAT_DRIVE].fs_driver = FS_DRIVER_FAT
    drives[FAT_DRIVE].bios_device = BIOS_BLOCK0
    drives[FAT_DRIVE].partition_lba = 0
    block_cache_valid = 0
    for index = 0 to DOS_MAX_HANDLES - 1
        handles[index].driver = FS_DRIVER_NONE
        handles[index].file = FILE_UNKNOWN
        handles[index].offset = 0
        handles[index].drive = 0
        handles[index].lba = 0
        handles[index].size = 0
    end
    dos_initialized = 1
    return
end

function dos_drive_index(drive: u8): u16
    return u16(normalized_drive(drive) - 'A')
end

function dos_drive_backend(drive: u8): u8
    return drives[dos_drive_index(drive)].backend
end

function dos_drive_fs_driver(drive: u8): u8
    return drives[dos_drive_index(drive)].fs_driver
end

function dos_drive_bios_device(drive: u8): u16
    if dos_drive_backend(drive) != DRIVE_BACKEND_BIOS_BLOCK
        return 0
    end
    return drives[dos_drive_index(drive)].bios_device
end

function dos_drive_partition_lba(drive: u8): u16
    return drives[dos_drive_index(drive)].partition_lba
end

function dos_drive_block_status(drive: u8): u16
    var dev: u16
    dev = dos_drive_bios_device(drive)
    if not dev
        return 0
    end
    return bios_block_status(dev)
end

function dos_drive_block_sector_count(drive: u8): u16
    var dev: u16
    dev = dos_drive_bios_device(drive)
    if not dev
        return 0
    end
    return bios_block_sector_count(dev)
end

function dos_drive_read_blocks(drive: u8, lba: u16, count: u16, buffer: near ^u8): u16
    var physical_lba: u16
    physical_lba = dos_drive_partition_lba(drive) + lba
    return dos_volume_read_blocks(drive, physical_lba, count, buffer)
end

function dos_drive_write_blocks(drive: u8, lba: u16, count: u16, buffer: near ^u8): u16
    var physical_lba: u16
    physical_lba = dos_drive_partition_lba(drive) + lba
    return dos_volume_write_blocks(drive, physical_lba, count, buffer)
end

function dos_volume_read_blocks(drive: u8, lba: u16, count: u16, buffer: near ^u8): u16
    var dev: u16
    var status: u16
    var sector_lba: u16
    var remaining: u16
    dev = dos_drive_bios_device(drive)
    if not dev
        return DOS_BLOCK_ERR_NO_DEVICE
    end
    sector_lba = lba
    remaining = count
    while remaining
        if block_cache_valid and block_cache_drive == normalized_drive(drive) and block_cache_lba == sector_lba
            copy_block_cache_to(buffer)
        else
            bios_block_set_lba(dev, sector_lba)
            status = bios_block_read(dev, addr(block_sector_buffer))
            if status != DOS_BLOCK_OK
                return status
            end
            block_cache_valid = 1
            block_cache_drive = normalized_drive(drive)
            block_cache_lba = sector_lba
            copy_block_cache_to(buffer)
        end
        buffer = buffer + $0200
        sector_lba = sector_lba + 1
        remaining = remaining - 1
    end
    return DOS_BLOCK_OK
end

function dos_volume_write_blocks(drive: u8, lba: u16, count: u16, buffer: near ^u8): u16
    var dev: u16
    var status: u16
    var sector_lba: u16
    var remaining: u16
    dev = dos_drive_bios_device(drive)
    if not dev
        return DOS_BLOCK_ERR_NO_DEVICE
    end
    sector_lba = lba
    remaining = count
    while remaining
        copy_block_to_cache(buffer)
        bios_block_set_lba(dev, sector_lba)
        status = bios_block_write(dev, addr(block_sector_buffer))
        if status != DOS_BLOCK_OK
            return status
        end
        block_cache_valid = 1
        block_cache_drive = normalized_drive(drive)
        block_cache_lba = sector_lba
        buffer = buffer + $0200
        sector_lba = sector_lba + 1
        remaining = remaining - 1
    end
    return DOS_BLOCK_OK
end

procedure copy_block_cache_to(buffer: near ^u8)
    var index: u16
    for index = 0 to $01ff
        buffer^ = block_sector_buffer[index]
        buffer = buffer + 1
    end
    return
end

procedure copy_block_to_cache(buffer: near ^u8)
    var index: u16
    for index = 0 to $01ff
        block_sector_buffer[index] = buffer^
        buffer = buffer + 1
    end
    return
end

function command_char_matches(index: u16, expected: u8): u8
    if normalized_drive(command_buffer[index]) == expected
        return 1
    end
    return 0
end

function command_word_matches(word: near ^u8): u8
    var index: u16
    var ch: u8
    index = 0
    ch = word^
    while ch
        if index >= line_len
            return 0
        end
        if not command_char_matches(index, ch)
            return 0
        end
        index = index + 1
        word = word + 1
        ch = word^
    end
    if index == line_len
        return 1
    end
    return 0
end

function command_argument_matches(word: near ^u8): u8
    var index: u16
    var ch: u8
    index = 0
    ch = word^
    while ch
        if index >= line_len
            return 0
        end
        if not command_char_matches(index, ch)
            return 0
        end
        index = index + 1
        word = word + 1
        ch = word^
    end
    if index < line_len and command_buffer[index] == ' ' and index + 1 < line_len
        return 1
    end
    return 0
end

function argument_start(short: near ^u8, long: near ^u8): u16
    var index: u16
    index = 0
    if command_argument_matches(short)
        while short^
            index = index + 1
            short = short + 1
        end
        return index + 1
    end
    while long^
        index = index + 1
        long = long + 1
    end
    return index + 1
end

function argument_word_matches(index: u16, word: near ^u8): u8
    var ch: u8
    ch = word^
    while ch
        if index >= line_len
            return 0
        end
        if not command_char_matches(index, ch)
            return 0
        end
        index = index + 1
        word = word + 1
        ch = word^
    end
    if index == line_len
        return 1
    end
    return 0
end

function argument_name_matches(index: u16, word: near ^u8): u8
    var ch: u8
    ch = word^
    while ch
        if index >= line_len
            return 0
        end
        if not command_char_matches(index, ch)
            return 0
        end
        index = index + 1
        word = word + 1
        ch = word^
    end
    if index == line_len
        return 1
    end
    if command_buffer[index] == ' '
        return 1
    end
    return 0
end

function echo_start(): u16
    if command_word_matches("E")
        return 1
    end
    if command_argument_matches("E")
        return 2
    end
    if command_word_matches("ECHO")
        return 4
    end
    return 5
end

procedure read_line()
    var ch: u8
    var done: u8
    line_len = 0
    done = 0
    repeat
        ch = console_read()
        if ch == '\r' or ch == '\n'
            console_newline()
            done = 1
        elsif ch == BACKSPACE or ch == DELETE
            erase_char()
        elsif ch == RECALL
            recall_history()
        elsif line_len < LINE_LIMIT
            command_buffer[line_len] = ch
            line_len = line_len + 1
            console_write(ch)
        end
    until done
    return
end

procedure recall_history()
    var index: u16
    if line_len
        return
    end
    index = 0
    while index != history_len
        command_buffer[index] = history_buffer[index]
        console_write(command_buffer[index])
        index = index + 1
    end
    line_len = history_len
    return
end

procedure save_history()
    var index: u16
    if not line_len
        return
    end
    index = 0
    while index != line_len
        history_buffer[index] = command_buffer[index]
        index = index + 1
    end
    history_len = line_len
    return
end

procedure erase_char()
    if not line_len
        return
    end
    line_len = line_len - 1
    console_write(BACKSPACE)
    console_write(' ')
    console_write(BACKSPACE)
    return
end

procedure dispatch_line()
    var code: u8
    code = command_code()
    if code == COMMAND_EMPTY
        return
    end
    if code == COMMAND_HELP
        console_write_help()
        return
    end
    if code == COMMAND_VERSION
        console_write_version()
        return
    end
    if code == COMMAND_DIR
        write_dir()
        return
    end
    if code == COMMAND_STATUS
        write_status()
        return
    end
    if code == COMMAND_PWD
        write_path()
        return
    end
    if code == COMMAND_MAP
        write_memory_map()
        return
    end
    if code == COMMAND_MEM
        write_memory_status()
        return
    end
    if code == COMMAND_CLS
        console_clear()
        return
    end
    if code == COMMAND_PROMPT
        configure_prompt()
        return
    end
    if code == COMMAND_PATH
        configure_path()
        return
    end
    if code == COMMAND_PEEK
        peek_memory()
        return
    end
    if code == COMMAND_POKE
        poke_memory()
        return
    end
    if code == COMMAND_DUMP
        dump_memory()
        return
    end
    if code == COMMAND_FILL
        fill_memory()
        return
    end
    if code == COMMAND_REBOOT
        machine_reboot()
        return
    end
    if code == COMMAND_BLKINFO
        write_block_info()
        return
    end
    if code == COMMAND_SET
        configure_set()
        return
    end
    if code == COMMAND_RUN
        run_program()
        return
    end
    if code == COMMAND_PROGRAM
        run_bare_program()
        return
    end
    if code == COMMAND_TYPE
        type_file()
        return
    end
    if code == COMMAND_CD
        change_dir()
        return
    end
    if code == COMMAND_ECHO
        echo_line()
        return
    end
    if code == COMMAND_DRIVE
        select_drive()
        return
    end
    console_write_unknown()
    return
end

procedure prompt()
    if prompt_mode == PROMPT_SHORT
        console_prompt_drive(current_drive)
        return
    end
    write_path_prefix()
    console_write_text("> ")
    return
end

procedure select_drive()
    current_drive = normalized_drive(command_buffer[0])
    return
end

procedure write_path()
    write_path_prefix()
    console_newline()
    return
end

procedure write_path_prefix()
    var index: u16
    console_write(current_drive)
    console_write(':')
    index = 0
    while index != path_len
        console_write(current_path[index])
        index = index + 1
    end
    return
end

procedure write_dir_prefix()
    var index: u16
    index = 0
    while index != path_len
        console_write(current_path[index])
        index = index + 1
    end
    return
end

function hex_digit(value: u8): u8
    value = normalized_drive(value)
    if value >= '0' and value <= '9'
        return value - '0'
    end
    if value >= 'A' and value <= 'F'
        return value - 'A' + 10
    end
    return $ff
end

function hex_argument_start(index: u16): u16
    if index < line_len and command_buffer[index] == '$'
        return index + 1
    end
    return index
end

function append_hex_digit(value: u16, digit: u8): u16
    value = value << 4
    value = value | u16(digit)
    return value
end

function parse_hex_u16(index: u16): u16
    var value: u16
    var digit: u8
    var digits: u8
    index = hex_argument_start(index)
    value = 0
    digits = 0
    parse_ok = 0
    while index < line_len and command_buffer[index] != ' '
        digit = hex_digit(command_buffer[index])
        if digit == $ff
            parse_end = index
            return 0
        end
        if digits == 4
            parse_end = index
            return 0
        end
        value = append_hex_digit(value, digit)
        digits = digits + 1
        index = index + 1
    end
    parse_end = index
    parse_ok = digits
    return value
end

function parse_hex_u8(index: u16): u8
    var value: u8
    var digit: u8
    var digits: u8
    index = hex_argument_start(index)
    value = 0
    digits = 0
    parse_ok = 0
    while index < line_len and command_buffer[index] != ' '
        digit = hex_digit(command_buffer[index])
        if digit == $ff
            parse_end = index
            return 0
        end
        if digits == 2
            parse_end = index
            return 0
        end
        value = value + value
        value = value + value
        value = value + value
        value = value + value
        value = value + digit
        digits = digits + 1
        index = index + 1
    end
    parse_end = index
    parse_ok = digits
    return value
end

procedure peek_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if not parse_ok
        console_write_unknown()
        return
    end
    if parse_end != line_len
        console_write_unknown()
        return
    end
    ptr = addr
    value = ptr^
    console_write('$')
    console_write_hex16(addr)
    console_write_text(" = $")
    console_write_hex8(value)
    console_newline()
    return
end

procedure poke_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if not parse_ok
        console_write_unknown()
        return
    end
    if parse_end >= line_len
        console_write_unknown()
        return
    end
    if command_buffer[parse_end] != ' '
        console_write_unknown()
        return
    end
    value = parse_hex_u8(parse_end + 1)
    if not parse_ok
        console_write_unknown()
        return
    end
    if parse_end != line_len
        console_write_unknown()
        return
    end
    ptr = addr
    ptr^ = value
    console_write_text("OK\r\n")
    return
end

procedure dump_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var count: u8
    direct var length: u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if not parse_ok
        console_write_unknown()
        return
    end
    if parse_end >= line_len
        console_write_unknown()
        return
    end
    if command_buffer[parse_end] != ' '
        console_write_unknown()
        return
    end
    length = parse_hex_u8(parse_end + 1)
    if not parse_ok
        console_write_unknown()
        return
    end
    if parse_end != line_len
        console_write_unknown()
        return
    end
    if not length
        console_write_unknown()
        return
    end
    if length > $10
        console_write_unknown()
        return
    end
    ptr = addr
    count = 0
    console_write('$')
    console_write_hex16(addr)
    console_write_text(": ")
    while count != length
        if count
            console_write(' ')
        end
        value = ptr^
        console_write_hex8(value)
        ptr = ptr + 1
        count = count + 1
    end
    console_newline()
    return
end

procedure fill_memory()
    direct var addr: u16
    direct var ptr: near ^u8
    direct var count: u8
    direct var length: u8
    direct var value: u8
    addr = parse_hex_u16(5)
    if not parse_ok
        console_write_unknown()
        return
    end
    if parse_end >= line_len
        console_write_unknown()
        return
    end
    if command_buffer[parse_end] != ' '
        console_write_unknown()
        return
    end
    length = parse_hex_u8(parse_end + 1)
    if not parse_ok
        console_write_unknown()
        return
    end
    if parse_end >= line_len
        console_write_unknown()
        return
    end
    if command_buffer[parse_end] != ' '
        console_write_unknown()
        return
    end
    if not length
        console_write_unknown()
        return
    end
    if length > $10
        console_write_unknown()
        return
    end
    value = parse_hex_u8(parse_end + 1)
    if not parse_ok
        console_write_unknown()
        return
    end
    if parse_end != line_len
        console_write_unknown()
        return
    end
    ptr = addr
    count = 0
    while count != length
        ptr^ = value
        ptr = ptr + 1
        count = count + 1
    end
    console_write_text("OK\r\n")
    return
end

procedure write_dir()
    console_write_text("Directory of ")
    write_path()
    dos_fs_write_dir()
    return
end

function dos_current_fs_driver(): u8
    return dos_drive_fs_driver(current_drive)
end

procedure dos_fs_write_dir()
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        romfs_write_dir()
        return
    end
    if dos_current_fs_driver() == FS_DRIVER_FAT
        fat_write_dir()
        return
    end
    files_write_path_not_found()
    return
end

stack procedure fat_write_dir()
    var files: u16
    var dirs: u16
    var status: u16
    var index: u16
    files = 0
    dirs = 0
    status = dos_fsfirst(addr(fat_dta))
    while status == DOS_OK
        index = 3
        while fat_dta[index]
            console_write(fat_dta[index])
            index = index + 1
        end
        while index != 16
            console_write(' ')
            index = index + 1
        end
        if fat_dta[0] & GEMDOS_ATTR_DIR
            console_write_text("<DIR>")
            dirs = dirs + 1
        else
            console_write('$')
            console_write_hex16(u16(fat_dta[1]) | u16(fat_dta[2]) << 8)
            files = files + 1
        end
        console_newline()
        status = dos_fsnext(addr(fat_dta))
    end
    console_write_hex8(u8(files))
    console_write_text(" file(s)  ")
    console_write_hex8(u8(dirs))
    console_write_text(" dir(s)\r\n")
    return
end

# Runs the program file named by the word at `start`, adding ".PRG" when the
# name has no extension.
stack procedure fat_run_program(start: u16)
    var index: u16
    var dotted: u8
    var status: u16
    index = 0
    dotted = 0
    while start < line_len and index != 12 and command_buffer[start] != ' '
        if command_buffer[start] == '.'
            dotted = 1
        end
        fat_name[index] = command_buffer[start]
        start = start + 1
        index = index + 1
    end
    if not dotted and index <= 8
        fat_name[index] = '.'
        fat_name[index + 1] = 'P'
        fat_name[index + 2] = 'R'
        fat_name[index + 3] = 'G'
        index = index + 4
    end
    fat_name[index] = 0
    status = exec_program(addr(fat_name))
    if status == DOS_ERR_FILE_NOT_FOUND
        files_write_program_not_found()
        return
    end
    if status == EXEC_ERR_FORMAT
        console_write_text("Not a program\r\n")
        return
    end
    if status == EXEC_ERR_TOO_LARGE
        console_write_text("Program too large\r\n")
        return
    end
    if status == EXEC_ERR_IMPORTS
        console_write_text("Program has unresolved imports\r\n")
        return
    end
    if status == EXEC_ERR_BASE_PAGE
        console_write_text("Not enough base page\r\n")
        return
    end
    if not status
        return
    end
    console_write_text("Exit status $")
    console_write_hex8(u8(status))
    console_newline()
    return
end

stack procedure fat_type_file(start: u16)
    var index: u16
    var handle: u16
    var ch: u8
    index = 0
    while start < line_len and index != 15
        fat_name[index] = command_buffer[start]
        start = start + 1
        index = index + 1
    end
    fat_name[index] = 0
    handle = dos_fopen(addr(fat_name))
    if handle < DOS_HANDLE_BASE or handle >= DOS_HANDLE_LIMIT
        files_write_not_found()
        return
    end
    while dos_fread(handle, 1, addr(fat_dta)) == 1
        ch = fat_dta[0]
        if ch == '\n'
            console_newline()
        elsif ch != '\r'
            console_write(ch)
        end
    end
    handle = dos_fclose(handle)
    return
end

procedure romfs_write_dir()
    if current_dir == DIR_ROOT
        files_write_root_dir()
        return
    end
    files_write_games_dir()
    return
end

stack function romfs_search_next(dta: near ^u8): u16
    var i: u8
    i = dos_search_next
    if dos_search_dir == DIR_ROOT
        if i >= ROMFS_ROOT_COUNT
            return DOS_ERR_NO_MORE_FILES
        end
        romfs_write_search_entry(dta, ROMFS_ROOT[i].name, ROMFS_ROOT[i].size, ROMFS_ROOT[i].attr)
    else
        if i >= ROMFS_GAMES_COUNT
            return DOS_ERR_NO_MORE_FILES
        end
        romfs_write_search_entry(dta, ROMFS_GAMES[i].name, ROMFS_GAMES[i].size, ROMFS_GAMES[i].attr)
    end
    dos_search_next = i + 1
    return DOS_OK
end

stack procedure romfs_write_search_entry(dta: near ^u8, name: near ^u8, size: u16, attr: u8)
    dta^ = attr
    dta = dta + 1
    dta^ = u8(size)
    dta = dta + 1
    dta^ = 0
    dta = dta + 1
    while name^
        dta^ = name^
        dta = dta + 1
        name = name + 1
    end
    dta^ = 0
    return
end

procedure write_memory_range(name: near ^u8, first: u16, last: u16)
    console_write_text(name)
    console_write(' ')
    console_write('$')
    console_write_hex16(first)
    console_write('-')
    console_write('$')
    console_write_hex16(last)
    console_newline()
    return
end

procedure write_memory_map()
    console_write_text("Memory map:\r\n")
    write_memory_range("RAM", $0000, $8fff)
    write_memory_range("I/O", $9f00, $9fff)
    write_memory_range("ROM", $c000, $ffff)
    return
end

procedure write_memory_status()
    console_write_text("Memory status:\r\n")
    write_memory_range("Direct", $0080, $00ff)
    write_memory_range("BSS", $9000, $9eff)
    console_write_text("Line buffer $0020\r\n")
    console_write_text("Serial rings $0040\r\n")
    return
end

procedure write_block_info()
    var status: u16
    var sectors: u16
    var read_status: u16
    var index: u16
    status = dos_drive_block_status(current_drive)
    sectors = dos_drive_block_sector_count(current_drive)
    console_write_text("Drive ")
    console_write(current_drive)
    console_write_text(" block:\r\n")
    if not dos_drive_bios_device(current_drive)
        console_write_text("No block device\r\n")
        return
    end
    console_write_text("Status $")
    console_write_hex8(u8(status))
    console_write_text("\r\nSectors $")
    console_write_hex16(sectors)
    console_newline()
    read_status = dos_drive_read_blocks(current_drive, 0, 1, addr(block_sector_buffer))
    if read_status != DOS_BLOCK_OK
        console_write_text("Read error $")
        console_write_hex8(u8(read_status))
        console_newline()
        return
    end
    console_write_text("Sector0:")
    for index = 0 to 15
        console_write(' ')
        console_write_hex8(block_sector_buffer[index])
    end
    console_newline()
    return
end

procedure write_prompt_mode()
    console_write_text("Prompt: ")
    if prompt_mode == PROMPT_SHORT
        console_write_text("SHORT\r\n")
        return
    end
    console_write_text("FULL\r\n")
    return
end

procedure write_path_mode()
    console_write_text("PATH=")
    if path_mode == PATH_CURRENT
        console_write_text(".\r\n")
        return
    end
    console_write_text("/\r\n")
    return
end

procedure configure_prompt()
    if command_word_matches("PROMPT")
        write_prompt_mode()
        return
    end
    if set_prompt_mode(7)
        return
    end
    console_write_unknown()
    return
end

function set_prompt_mode(index: u16): u8
    if argument_word_matches(index, "SHORT")
        prompt_mode = PROMPT_SHORT
        return 1
    end
    if not argument_word_matches(index, "FULL")
        return 0
    end
    prompt_mode = PROMPT_FULL
    return 1
end

function set_path_mode(index: u16): u8
    if argument_word_matches(index, ".")
        path_mode = PATH_CURRENT
        return 1
    end
    if not argument_word_matches(index, "/")
        return 0
    end
    path_mode = PATH_ROOT
    return 1
end

procedure configure_path()
    if command_word_matches("PATH")
        write_path_mode()
        return
    end
    if set_path_mode(5)
        return
    end
    console_write_unknown()
    return
end

procedure write_environment()
    console_write_text("DRIVE=")
    console_write(current_drive)
    console_newline()
    console_write_text("DIR=")
    write_dir_prefix()
    console_newline()
    console_write_text("PROMPT=")
    if prompt_mode == PROMPT_SHORT
        console_write_text("SHORT\r\n")
    else
        console_write_text("FULL\r\n")
    end
    write_path_mode()
    return
end

function set_drive_from_argument(index: u16): u8
    if not (line_len == index + 1 and is_drive_letter(command_buffer[index]) != 0)
        return 0
    end
    current_drive = normalized_drive(command_buffer[index])
    return 1
end

procedure configure_set()
    if command_word_matches("SET")
        write_environment()
        return
    end
    if argument_name_matches(4, "PROMPT")
        if set_prompt_mode(11)
            return
        end
        console_write_unknown()
        return
    end
    if argument_name_matches(4, "DRIVE")
        if set_drive_from_argument(10)
            return
        end
        console_write_unknown()
        return
    end
    if not argument_name_matches(4, "PATH")
        console_write_unknown()
        return
    end
    if set_path_mode(9)
        return
    end
    console_write_unknown()
    return
end

function type_file_code(): u8
    var start: u16
    start = argument_start("T", "TYPE")
    return dos_fs_type_file_code(start)
end

function dos_fs_type_file_code(start: u16): u8
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_type_file_code(start)
    end
    return FILE_UNKNOWN
end

stack function dos_fs_file_code(path: near ^u8): u8
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_file_code(path)
    end
    return FILE_UNKNOWN
end

stack function romfs_file_code(path: near ^u8): u8
    if path^ == '/'
        path = path + 1
        return romfs_root_file_code(path)
    end
    if current_dir == DIR_ROOT
        return romfs_root_file_code(path)
    end
    return romfs_games_file_code(path)
end

stack function romfs_root_file_code(path: near ^u8): u8
    if name_is(path, "README", "TXT")
        return FILE_README
    end
    if name_is(path, "SYSTEM", "TXT")
        return FILE_SYSTEM
    end
    return FILE_UNKNOWN
end

stack function romfs_games_file_code(path: near ^u8): u8
    if name_is(path, "DEMO", "TXT")
        return FILE_DEMO
    end
    return FILE_UNKNOWN
end

function romfs_type_file_code(start: u16): u8
    if current_dir == DIR_ROOT
        if argument_word_matches(start, "README.TXT")
            return FILE_README
        end
        if argument_word_matches(start, "README")
            return FILE_README
        end
        if argument_word_matches(start, "SYSTEM.TXT")
            return FILE_SYSTEM
        end
        if argument_word_matches(start, "SYSTEM")
            return FILE_SYSTEM
        end
        return FILE_UNKNOWN
    end
    if argument_word_matches(start, "DEMO.TXT")
        return FILE_DEMO
    end
    if argument_word_matches(start, "DEMO")
        return FILE_DEMO
    end
    return FILE_UNKNOWN
end

stack function dos_alloc_handle(driver: u8, code: u8): u16
    var slot: u16
    for slot = 0 to DOS_MAX_HANDLES - 1
        if handles[slot].file == FILE_UNKNOWN
            handles[slot].driver = driver
            handles[slot].file = code
            handles[slot].offset = 0
            handles[slot].drive = u8(dos_drive_index(current_drive))
            handles[slot].lba = 0
            handles[slot].size = 0
            return slot + DOS_HANDLE_BASE
        end
    end
    return DOS_ERR_ACCESS_DENIED
end

stack function dos_handle_slot_valid(handle: u16): u8
    if handle < DOS_HANDLE_BASE
        return 0
    end
    if handle >= DOS_HANDLE_LIMIT
        return 0
    end
    return 1
end

stack function dos_file_size(driver: u8, code: u8): u16
    if driver == FS_DRIVER_ROMFS
        return romfs_file_size(code)
    end
    if driver == FS_DRIVER_FAT
        return fat_file_size(u16(dos_current_read_slot))
    end
    return 0
end

stack function dos_file_byte(driver: u8, code: u8, offset: u16): u8
    if driver == FS_DRIVER_ROMFS
        return romfs_file_byte(code, offset)
    end
    if driver == FS_DRIVER_FAT
        return fat_file_byte(u16(dos_current_read_slot), offset)
    end
    return 0
end

stack function romfs_file_size(code: u8): u16
    if code == FILE_README
        return 49
    end
    if code == FILE_SYSTEM
        return 65
    end
    if code == FILE_DEMO
        return 48
    end
    return 0
end

stack function romfs_file_byte(code: u8, offset: u16): u8
    if code == FILE_README
        return readme_byte(offset)
    end
    if code == FILE_SYSTEM
        return system_byte(offset)
    end
    if code == FILE_DEMO
        return demo_byte(offset)
    end
    return 0
end

stack function readme_byte(offset: u16): u8
    return string_byte_at("Hellord is a tiny Mensch DOS for the x65-alike.\r\n", offset)
end

stack function system_byte(offset: u16): u8
    return string_byte_at("CPU: 65816\r\nConsole: USB UART IRQ rings\r\nStorage: ROM file table\r\n", offset)
end

stack function demo_byte(offset: u16): u8
    return string_byte_at("No games yet, but the directory layer works.\r\n", offset)
end

stack function string_byte_at(text: near ^u8, offset: u16): u8
    while offset
        text = text + 1
        offset = offset - 1
    end
    return text^
end

# Whether `path` names `base`, or `base.ext` when `ext` is not empty,
# ignoring case.
stack function name_is(path: near ^u8, base: near ^u8, ext: near ^u8): u8
    while base^
        if normalized_drive(path^) != base^
            return 0
        end
        path = path + 1
        base = base + 1
    end
    if not path^
        return 1
    end
    if path^ != '.' or not ext^
        return 0
    end
    path = path + 1
    while ext^
        if normalized_drive(path^) != ext^
            return 0
        end
        path = path + 1
        ext = ext + 1
    end
    if not path^
        return 1
    end
    return 0
end

function run_program_code(): u8
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_run_program_code()
    end
    return FILE_UNKNOWN
end

function bare_program_code(): u8
    var code: u8
    if dos_current_fs_driver() == FS_DRIVER_FAT
        # Any other word names a program file; RUN reports a missing one.
        return PROGRAM_FILE
    end
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        code = romfs_program_code_at(0)
    else
        code = FILE_UNKNOWN
    end
    if code != FILE_UNKNOWN
        return code
    end
    if path_mode != PATH_ROOT
        return FILE_UNKNOWN
    end
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_root_program_code_at(0)
    end
    return FILE_UNKNOWN
end

function romfs_run_program_code(): u8
    var start: u16
    start = argument_start("R", "RUN")
    return romfs_program_code_at(start)
end

function romfs_program_code_at(start: u16): u8
    if current_dir == DIR_ROOT
        return romfs_root_program_code_at(start)
    end
    if argument_word_matches(start, "DEMO.PRG")
        return PROGRAM_DEMO
    end
    if argument_word_matches(start, "DEMO")
        return PROGRAM_DEMO
    end
    return FILE_UNKNOWN
end

function romfs_root_program_code_at(start: u16): u8
    if argument_word_matches(start, "HELLO.PRG")
        return PROGRAM_HELLO
    end
    if argument_word_matches(start, "HELLO")
        return PROGRAM_HELLO
    end
    return FILE_UNKNOWN
end

procedure run_program_code_value(code: u8)
    romfs_run_program_code_value(code)
    return
end

procedure romfs_run_program_code_value(code: u8)
    if code == PROGRAM_HELLO
        files_run_hello()
        return
    end
    if code == PROGRAM_DEMO
        files_run_demo()
        return
    end
    files_write_program_not_found()
    return
end

procedure run_program()
    var code: u8
    if dos_current_fs_driver() == FS_DRIVER_FAT
        fat_run_program(argument_start("R", "RUN"))
        return
    end
    code = run_program_code()
    run_program_code_value(code)
    return
end

procedure run_bare_program()
    var code: u8
    if dos_current_fs_driver() == FS_DRIVER_FAT
        fat_run_program(0)
        return
    end
    code = bare_program_code()
    run_program_code_value(code)
    return
end

procedure type_file()
    var code: u8
    if dos_current_fs_driver() == FS_DRIVER_FAT
        fat_type_file(argument_start("T", "TYPE"))
        return
    end
    code = type_file_code()
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        romfs_type_file_code_value(code)
        return
    end
    files_write_not_found()
    return
end

procedure romfs_type_file_code_value(code: u8)
    if code == FILE_README
        files_type_readme()
        return
    end
    if code == FILE_SYSTEM
        files_type_system()
        return
    end
    if code == FILE_DEMO
        files_type_demo()
        return
    end
    files_write_not_found()
    return
end

procedure change_dir()
    if line_len == 2
        init_path()
        return
    end
    if argument_word_matches(3, "/")
        init_path()
        return
    end
    if argument_word_matches(3, "..")
        init_path()
        return
    end
    if argument_word_matches(3, "GAMES")
        set_games_path()
        return
    end
    files_write_path_not_found()
    return
end

procedure write_status()
    console_write_flag('R', serial_rx_overflow())
    console_write_flag('T', serial_tx_overflow())
    return
end

procedure echo_line()
    var index: u16
    index = echo_start()
    if index == line_len
    elsif command_buffer[index] == ' '
        index = index + 1
    end
    while index != line_len
        console_write(command_buffer[index])
        index = index + 1
    end
    console_newline()
    return
end
