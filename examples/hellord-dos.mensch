module HellordDos

external procedure console_write(value: u8)
external procedure console_newline()
external procedure console_prompt()
external function console_read(): u8
external procedure console_write_greeting()
external procedure console_write_help()
external procedure console_write_version()
external procedure console_write_dir()
external procedure console_write_unknown()

const COMMAND_UNKNOWN = 0
const COMMAND_HELP = 1
const COMMAND_VERSION = 2
const COMMAND_DIR = 3
const COMMAND_ECHO = 4
const COMMAND_EMPTY = 255
const LINE_LIMIT = 31
const BACKSPACE = $08
const DELETE = $7f

var line_len: u16
var command_buffer: [32]u8

export procedure dos_boot()
    console_write_greeting()
    console_prompt()
    while 1 != 0
        read_line()
        dispatch_line()
        console_prompt()
    end
end

function command_code(): u8
    if line_len == 0
        return COMMAND_EMPTY
    else
        if command_buffer[0] == 'H'
            return COMMAND_HELP
        else
            if command_buffer[0] == 'h'
                return COMMAND_HELP
            else
                if command_buffer[0] == 'V'
                    return COMMAND_VERSION
                else
                    if command_buffer[0] == 'v'
                        return COMMAND_VERSION
                    else
                        if command_buffer[0] == 'D'
                            return COMMAND_DIR
                        else
                            if command_buffer[0] == 'd'
                                return COMMAND_DIR
                            else
                                if command_buffer[0] == 'E'
                                    return COMMAND_ECHO
                                else
                                    if command_buffer[0] == 'e'
                                        return COMMAND_ECHO
                                    else
                                        return COMMAND_UNKNOWN
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

procedure read_line()
    var ch: u8
    var done: u8
    line_len = 0
    done = 0
    while done == 0
        ch = console_read()
        if ch == '\r'
            console_newline()
            done = 1
        else
            if ch == '\n'
                console_newline()
                done = 1
            else
                if ch == BACKSPACE
                    erase_char()
                else
                    if ch == DELETE
                        erase_char()
                    else
                        if line_len == LINE_LIMIT
                        else
                            command_buffer[line_len] = ch
                            line_len = line_len + 1
                            console_write(ch)
                        end
                    end
                end
            end
        end
    end
    return
end

procedure erase_char()
    if line_len == 0
    else
        line_len = line_len - 1
        console_write(BACKSPACE)
        console_write(' ')
        console_write(BACKSPACE)
    end
    return
end

procedure dispatch_line()
    direct var code: u8
    code = command_code()
    if code == COMMAND_EMPTY
        return
    else
        if code == COMMAND_HELP
            console_write_help()
        else
            if code == COMMAND_VERSION
                console_write_version()
            else
                if code == COMMAND_DIR
                    console_write_dir()
                else
                    if code == COMMAND_ECHO
                        echo_line()
                    else
                        console_write_unknown()
                    end
                end
            end
        end
    end
    return
end

procedure echo_line()
    var index: u16
    index = 1
    while index != line_len
        console_write(command_buffer[index])
        index = index + 1
    end
    console_newline()
    return
end
