module BubbleGame

# A playable Bubble Bobble-style room on the MEGA65: Bub on joystick 2 in
# room 1, with three Zen-chans that drop in, walk, turn at walls and now and
# then jump after him. Fire blows a bubble, which traps a Zen-chan it hits;
# touching a floating bubble pops it, and a Zen-chan popped that way is gone;
# landing on one with up held bounces Bub off it instead.
# A Zen-chan left in its bubble too long breaks out angry, and faster. When
# all three are gone the round starts again. Touching a Zen-chan spins Bub
# and puts him back at the start.
#
# Movement and collision are BubblePhysics', bubbles BubbleBubbles', drawing
# lib/actors.mensch's. Run it with scripts/bubble_bobble/run-game.sh.

import Vic4
import Actors
import BubbleDemoData
import BubbleVideo
import BubblePhysics
import BubbleBubbles
import GameReplay

# Chip RAM, as in the animation demo.
const ROOM_TILES: u32 = $44000
const SPRITE_TABLE: u32 = $45000
const SPRITE_BUFFERS: u32 = $46000
const ACTOR_CHARACTERS: u32 = $48000
const SCREEN: u32 = $50000

const COLUMNS = 40
const ROWS = 26
const SLOTS = 32
const ENTRIES = 32
const ROOM_LEFT = (COLUMNS - 32) / 2
const ROOM_X = ROOM_LEFT * 8
const SPRITE_X0 = 24
const SPRITE_Y0 = 46
const QUIET_LINE = 256

# ---------------------------------------------------------------- Bub

const PLAYER = 0
# The arcade moves Bub 6 times every 5 frames: twice on frames where
# (tick + BEAT_PHASE) % BEAT is 0 (in step with round 1's start). Walking is
# 1 px a move; steering a jump 1 px on 4 moves in every STEER_CYCLE,
# starting with a skip (the arcade's air steering is uneven, now behind,
# now catching up, by up to 3 px; this keeps closest to it); drifting off an
# edge 1 px every FALL_EVERY frames.
const BEAT = 5
const BEAT_PHASE = 2
const STEER_CYCLE = 5
const FALL_EVERY = 3
const START_X = 24
const START_Y = 184
# Frames Bub spins when caught, then frames he cannot be caught again after
# coming back (none at the start of a round), as the arcade. An enemy
# catches him when their centres are within CATCH_DISTANCE px both ways.
const CAUGHT_FRAMES = 186
const SAFE_FRAMES = 180
const CATCH_DISTANCE = 8
# Frames between bubbles, and of the blowing animation.
const BLOW_FRAMES = 22
# Coming down with up held onto a bubble bounces off it: feet from
# BOUNCE_ABOVE pixels above its top to BOUNCE_BELOW below, and within
# BOUNCE_SIDE pixels of it sideways.
const BOUNCE_ABOVE = 2
const BOUNCE_BELOW = 10
const BOUNCE_SIDE = 12
# Otherwise Bub pops a bubble he overlaps by this margin on every side.
const POP_MARGIN = 5

const BUB_WALK: [6]u16 = [
    BUBBLUN_WALK_01, BUBBLUN_WALK_02, BUBBLUN_WALK_03,
    BUBBLUN_WALK_04, BUBBLUN_WALK_05, BUBBLUN_WALK_06
]
const BUB_SPIN: [6]u16 = [
    BUBBLUN_SPIN_01, BUBBLUN_SPIN_02, BUBBLUN_SPIN_03,
    BUBBLUN_SPIN_04, BUBBLUN_SPIN_05, BUBBLUN_SPIN_06
]
const BUB_BLOW: [8]u16 = [
    BUBBLUN_BLOW_01, BUBBLUN_BLOW_02, BUBBLUN_BLOW_03, BUBBLUN_BLOW_04,
    BUBBLUN_BLOW_05, BUBBLUN_BLOW_06, BUBBLUN_BLOW_07, BUBBLUN_BLOW_08
]

var bub: u8
var facing_left: u8
var walk_step: u8
# Frames of sideways input, for the step patterns.
var stride: u8
# Bubble lives taken from a replay's list.
var lives_used: u16
# Moves steered during the current jump.
var steers: u8
var caught: u8
var safe: u8
var blowing: u8
var buttons_before: u8
var buttons_now: u8

# ---------------------------------------------------------------- Zen-chans

const ENEMIES = 3
const FIRST_ENEMY = 1
# Zen-chan movement, as measured in MAME (round 1, bublboblr): walking 1 px
# a frame; falling straight down at 1 px a frame; a jump is a 29-frame
# crouch, then straight up 40 px (one platform) at 1 px a frame; about 2
# frames' pause on turning at a wall and on landing. All three drop in at
# x 120 from 47 px above the room (111 frames to the top platform) and walk
# left. Angry Zen-chans' speed is a guess.
const ENEMY_SPEED = 16
const ANGRY_SPEED = 32
const ENEMY_CROUCH = 29
# How an enemy decides (the arcade's Zen-chan, bank 0 $8E3F): a cooldown
# counts down its walking frames; when it runs out it is reloaded with
# 10 + (enemy + 1) * the round's pace (round 1's is 120, so 130, 250 and
# 114 after wrapping) and the enemy changes mind:
# - chasing (mode 0): when Bub is above it, less than CHASE_RANGE px up,
#   it turns to walk toward him, or (within CLOSE px across) starts
#   climbing;
# - climbing (mode 1): while Bub is above it, or being caught, it holds the
#   cooldown at HOLD and jumps up to any platform it comes under; otherwise
#   the cooldown soon runs out and it goes back to chasing.
# It judges where Bub is from both their positions LAG frames ago. A jump
# from the height of its last jump (it came back down) is the arcade's
# other jump: rising while stepping 1 px forward every DRIFT_EVERY frames,
# falling at once if a wall stops it (seen in MAME; how long it lasts away
# from walls is a guess, as long as a jump).
const ROUND_PACE = 120
const HOLD = 2
const CHASE_RANGE = 32
const CLOSE = 16
const LAG = 2
const CHASING = 0
const CLIMBING = 1
const DRIFT_EVERY = 5
const NO_JUMP = 1000
const ENEMY_RISE = 40
const DROP_Y = -47
# Frames still after landing from the drop in, from a fall and from a jump.
# (At a wall an enemy turns round where it stands, in one frame.)
const ENTRY_PAUSE = 3
const LAND_PAUSE = 1
const RISE_PAUSE = 2
# Frames at an edge before falling off it.
const EDGE_PAUSE = 1
const DROP_X = 120
# Round 1's stagger: each drops in this many frames after the round starts.
const DROP_DELAY: [ENEMIES]u8 = [1, 21, 41]
# Frames between the last Zen-chan going and the round starting again.
const CLEAR_FRAMES = 120

# A Zen-chan's state.
const WAITING = 0
const ACTIVE = 1
const TRAPPED = 2
const GONE = 3

# An active enemy's motion.
const WALK = 0
const FALL = 1
const CROUCH = 2
const RISE = 3
const PAUSE = 4

const ZEN_WALK: [4]u16 = [
    ZEN_CHAN_WALK_01, ZEN_CHAN_WALK_02, ZEN_CHAN_WALK_03, ZEN_CHAN_WALK_04
]
const ZEN_ANGRY: [4]u16 = [
    ZEN_CHAN_ANGRY_01, ZEN_CHAN_ANGRY_02, ZEN_CHAN_ANGRY_03, ZEN_CHAN_ANGRY_04
]

var enemy_actor: [ENEMIES]u8
var enemy_state: [ENEMIES]u8
var enemy_delay: [ENEMIES]u8
var enemy_left: [ENEMIES]u8
var enemy_angry: [ENEMIES]u8
var enemy_motion: [ENEMIES]u8
var enemy_timer: [ENEMIES]u8
# Whether the enemy was under a platform it could jump to last frame.
var enemy_cooldown: [ENEMIES]u8
var enemy_mind: [ENEMIES]u8
# The height (y) the enemy last jumped from, or NO_JUMP; and whether its
# jump is the drifting one.
var enemy_jumped_from: [ENEMIES]i16
var enemy_drift: [ENEMIES]u8
# Positions over the last LAG + 1 frames (index 0 this frame): Bub's, then
# each enemy's.
var seen_x: [(ENEMIES + 1) * (LAG + 1)]i16
var seen_y: [(ENEMIES + 1) * (LAG + 1)]i16
# Whether the enemy is still dropping in at the start of the round.
var enemy_entering: [ENEMIES]u8
var clearing: u8

# ---------------------------------------------------------------- bubbles

const BUBBLE_FORM: [6]u16 = [
    BUBBLE_FORM_GREEN_01, BUBBLE_FORM_GREEN_02, BUBBLE_FORM_GREEN_03,
    BUBBLE_FORM_GREEN_04, BUBBLE_FORM_GREEN_05, BUBBLE_FORM_GREEN_06
]
const BUBBLE_FLOAT_FRAMES: [3]u16 = [BUBBLE_GREEN_01, BUBBLE_GREEN_02, BUBBLE_GREEN_03]
const BUBBLE_TRAPPED: [3]u16 = [
    ZEN_CHAN_BUBBLE_GREEN_01, ZEN_CHAN_BUBBLE_GREEN_02, ZEN_CHAN_BUBBLE_GREEN_03
]
# A popped bubble: a dotted ring breaking up.
const BUBBLE_POPPED: [3]u16 = [BUBBLE_DOTTED_01, BUBBLE_DOTTED_02, BUBBLE_DOTTED_03]

var bubble_actor: [MAX_BUBBLES]u8

var seed: u16
var tick: u16

# A pseudo-random byte (16-bit Galois shift register).
function random(): u8
    var low: u8
    low = u8(seed) & 1
    seed = seed >> 1
    if low
        seed = seed xor $b400
    end
    return u8(seed)
end

# ---------------------------------------------------------------- per frame

procedure start_round()
    var i: u8
    for i = 0 to ENEMIES - 1
        enemy_state[i] = WAITING
        enemy_delay[i] = DROP_DELAY[i]
        enemy_left[i] = 1
        enemy_angry[i] = 0
        enemy_cooldown[i] = reload(i)
        enemy_mind[i] = CHASING
        enemy_jumped_from[i] = NO_JUMP
        actor_hide(enemy_actor[i])
    end
    bubbles_reset()
    clearing = 0
    return
end

# A new bubble's life: the arcade's is 8 to 15 at random; a replay build
# takes the arcade's own, in order.
function bubble_life(): u8
    if REPLAY and lives_used < REPLAY_LIVES_COUNT
        lives_used = lives_used + 1
        return REPLAY_LIVES[lives_used - 1]
    end
    return 8 + (random() & 7)
end

# The controls: the joystick, or in a replay build the script's input for
# frame `frame` (a frame's later reads see the next frame's).
function read_buttons(frame: u16): u8
    if REPLAY
        if frame < REPLAY_FRAMES
            return REPLAY_INPUT[frame]
        end
        return 0
    end
    return joystick(2)
end

# Pixels Bub steers on this move of a jump.
function steer(): i16
    steers = steers + 1
    if steers % STEER_CYCLE == 0
        return 0
    end
    return 1
end

procedure move_bub(buttons: u8)
    var dx: i16
    var pressed: u8
    var b: u8
    if caught
        caught = caught - 1
        if caught == 0
            body_place(PLAYER, START_X, START_Y)
            safe = SAFE_FRAMES
        elsif not supported(body_x(PLAYER), body_y(PLAYER) + 16)
            # Caught in the air, he sinks to the ground at 1 px a frame.
            body_place(PLAYER, body_x(PLAYER), body_y(PLAYER) + 1)
        end
        return
    end
    if safe
        safe = safe - 1
    end
    if blowing
        blowing = blowing - 1
    end
    pressed = buttons & (buttons_before xor $ff)
    dx = 0
    if buttons & (JOY_LEFT | JOY_RIGHT)
        stride = stride + 1
        if body_on_ground(PLAYER)
            dx = 1
        elsif body_jumping(PLAYER)
            dx = steer()
        elsif stride % FALL_EVERY == 0
            dx = 1
        end
        dx = dx << 4
        if buttons & JOY_LEFT
            dx = 0 - dx
            facing_left = 1
        else
            facing_left = 0
        end
    end
    # Taking off, Bub makes no step sideways that frame.
    if pressed & JOY_UP
        if body_jump(PLAYER)
            walk_step = 0
            dx = 0
            steers = STEER_CYCLE - 1
        end
    end
    if body_walk(PLAYER, dx) == 0 and dx != 0
        walk_step = walk_step + 1
    end
    if (pressed & JOY_FIRE) and blowing == 0
        b = bubble_blow(body_x(PLAYER), body_y(PLAYER), facing_left, bubble_life())
        blowing = BLOW_FRAMES
    end
    body_step(PLAYER)
    # The extra move on the beat: walking and jumping go twice as far. It
    # reads the controls afresh, as the arcade's later move does.
    if (tick + BEAT_PHASE) % BEAT == 0
        buttons = read_buttons(tick + 1)
        if body_on_ground(PLAYER) and (buttons & (JOY_LEFT | JOY_RIGHT))
            dx = 16
            if buttons & JOY_LEFT
                dx = 0 - dx
            end
            if body_walk(PLAYER, dx) == 0
                walk_step = walk_step + 1
            end
            body_step(PLAYER)
        elsif body_jumping(PLAYER)
            if buttons & (JOY_LEFT | JOY_RIGHT)
                dx = steer() << 4
                if buttons & JOY_LEFT
                    dx = 0 - dx
                end
                b = body_walk(PLAYER, dx)
            end
            body_step(PLAYER)
        end
    end
    return
end

function reload(i: u8): u8
    return u8(10 + (u16(i) + 1) * ROUND_PACE)
end

# Remembers this frame's positions of Bub (body 0) and the enemies.
procedure remember()
    var k: u8
    var at: u8
    for k = 0 to ENEMIES
        at = k * (LAG + 1)
        seen_x[at + 2] = seen_x[at + 1]
        seen_y[at + 2] = seen_y[at + 1]
        seen_x[at + 1] = seen_x[at]
        seen_y[at + 1] = seen_y[at]
        seen_x[at] = body_x(k)
        seen_y[at] = body_y(k)
    end
    return
end

# Bub's height above enemy `i`, and across from it, as it judges them.
function bub_above(i: u8): i16
    return seen_y[(i + 1) * (LAG + 1) + LAG] - seen_y[LAG]
end

function bub_across(i: u8): i16
    return seen_x[LAG] - seen_x[(i + 1) * (LAG + 1) + LAG]
end

# Enemy `i`, walking (or about to) at (x, y), makes up its mind for this
# frame: perhaps turning toward Bub, perhaps jumping up to a platform.
procedure think(i: u8, x: i16, y: i16)
    var up: i16
    var across: i16
    var under: u8
    enemy_cooldown[i] = enemy_cooldown[i] - 1
    if enemy_cooldown[i] == 0
        enemy_cooldown[i] = reload(i)
        enemy_mind[i] = enemy_mind[i] xor 1
    end
    up = bub_above(i)
    across = bub_across(i)
    if enemy_mind[i] == CHASING
        if y == START_Y or caught or up <= 0 or up >= CHASE_RANGE
            return
        end
        enemy_jumped_from[i] = NO_JUMP
        if across > 0 - CLOSE and across < CLOSE
            enemy_mind[i] = CLIMBING
        elsif across < 0
            enemy_left[i] = 1
        else
            enemy_left[i] = 0
        end
        return
    end
    if caught == 0 and up <= 0
        return
    end
    enemy_cooldown[i] = HOLD
    under = 0
    if y + 16 - ENEMY_RISE > 8
        under = ground_under_middle(x, y + 16 - ENEMY_RISE)
    end
    if under
        # One more step, then the crouch.
        enemy_motion[i] = CROUCH
        enemy_timer[i] = ENEMY_CROUCH + 1
        enemy_drift[i] = 0
        if enemy_jumped_from[i] == y
            enemy_drift[i] = 1
            enemy_jumped_from[i] = NO_JUMP
        else
            enemy_jumped_from[i] = y
        end
    end
    return
end

procedure move_enemy(i: u8)
    var body: u8
    var dx: i16
    var x: i16
    var y: i16
    var under: u8
    body = FIRST_ENEMY + i
    if enemy_state[i] == WAITING
        enemy_delay[i] = enemy_delay[i] - 1
        if enemy_delay[i] == 0
            body_place(body, DROP_X, DROP_Y)
            enemy_state[i] = ACTIVE
            enemy_motion[i] = FALL
            enemy_timer[i] = 0
            enemy_entering[i] = 1
        end
        return
    end
    if enemy_state[i] != ACTIVE
        return
    end
    x = body_x(body)
    y = body_y(body)
    if enemy_motion[i] == PAUSE
        enemy_timer[i] = enemy_timer[i] - 1
        if enemy_timer[i] == 0
            # Ready to walk: it may decide to jump where it stands.
            enemy_motion[i] = WALK
            think(i, x, y)
        end
    elsif enemy_motion[i] == WALK
        dx = ENEMY_SPEED
        if enemy_angry[i]
            dx = ANGRY_SPEED
        end
        if enemy_left[i]
            dx = 0 - dx
        end
        # Turning round at a wall takes the frame (and does not count
        # toward the jump cooldown).
        if body_walk(body, dx)
            enemy_left[i] = enemy_left[i] xor 1
        else
            x = body_x(body)
            if not supported(x, y + 16)
                enemy_motion[i] = FALL
                enemy_timer[i] = EDGE_PAUSE
            else
                think(i, x, y)
            end
        end
    elsif enemy_motion[i] == FALL and enemy_timer[i]
        enemy_timer[i] = enemy_timer[i] - 1
    elsif enemy_motion[i] == FALL
        y = y + 1
        if y >= ROOM_HEIGHT
            y = y - ROOM_HEIGHT - 16
        end
        # Land on the top of a cell (not the top row's).
        if ((y + 16) & 7) == 0 and y + 16 > 8 and supported(x, y + 16)
            enemy_motion[i] = PAUSE
            enemy_timer[i] = LAND_PAUSE
            if enemy_entering[i]
                enemy_timer[i] = ENTRY_PAUSE
                enemy_entering[i] = 0
            end
        end
        body_place(body, x, y)
    elsif enemy_motion[i] == CROUCH
        if enemy_timer[i] == ENEMY_CROUCH + 1
            dx = ENEMY_SPEED
            if enemy_left[i]
                dx = 0 - dx
            end
            under = body_walk(body, dx)
        end
        enemy_timer[i] = enemy_timer[i] - 1
        if enemy_timer[i] == 0
            enemy_motion[i] = RISE
            enemy_timer[i] = ENEMY_RISE
        end
    elsif enemy_motion[i] == RISE
        y = y - 1
        if enemy_drift[i] and (ENEMY_RISE - enemy_timer[i]) % DRIFT_EVERY == 0
            dx = ENEMY_SPEED
            if enemy_left[i]
                dx = 0 - dx
            end
            under = body_walk(body, dx)
            # Against a wall now: it turns, holds a frame, then falls.
            if under or body_walk(body, dx)
                enemy_left[i] = enemy_left[i] xor 1
                body_place(body, body_x(body), y)
                enemy_motion[i] = FALL
                enemy_timer[i] = 1
                return
            end
            under = body_walk(body, 0 - dx)
            x = body_x(body)
        end
        enemy_timer[i] = enemy_timer[i] - 1
        if enemy_timer[i] == 0
            enemy_motion[i] = FALL
            if supported(x, y + 16)
                enemy_motion[i] = PAUSE
                enemy_timer[i] = RISE_PAUSE
            end
            # Under another platform here: it may jump again at once.
        end
        body_place(body, x, y)
    end
    return
end

# Whether Bub is coming down with his feet on the top of bubble `b`.
function lands_on(b: u8): u8
    var feet: i16
    var dx: i16
    if body_falling(PLAYER) == 0
        return 0
    end
    dx = body_x(PLAYER) - bubble_x(b)
    if dx <= 0 - BOUNCE_SIDE or dx >= BOUNCE_SIDE
        return 0
    end
    feet = body_y(PLAYER) + 16
    if feet >= bubble_y(b) - BOUNCE_ABOVE and feet < bubble_y(b) + BOUNCE_BELOW
        return 1
    end
    return 0
end

# Bubbles against Zen-chans and Bub: trapping, popping, bouncing and
# breaking out.
procedure bubbles_meet()
    var b: u8
    var i: u8
    var enemy: u8
    for b = 0 to MAX_BUBBLES - 1
        if bubble_state(b) == BUBBLE_SHOT
            for i = 0 to ENEMIES - 1
                if enemy_state[i] == ACTIVE
                    if boxes_touch(bubble_x(b), bubble_y(b), body_x(FIRST_ENEMY + i), body_y(FIRST_ENEMY + i), 2)
                        if bubble_capture(b, i)
                            enemy_state[i] = TRAPPED
                            actor_hide(enemy_actor[i])
                        end
                    end
                end
            end
        elsif bubble_state(b) == BUBBLE_FLOAT and caught == 0
            if lands_on(b) and (buttons_now & JOY_UP)
                body_launch(PLAYER)
            elsif boxes_touch(bubble_x(b), bubble_y(b), body_x(PLAYER), body_y(PLAYER), POP_MARGIN)
                enemy = bubble_pop(b)
                if enemy != NO_CAPTIVE
                    enemy_state[enemy] = GONE
                end
            end
        end
        enemy = bubble_escapee(b)
        if enemy != NO_CAPTIVE
            body_place(FIRST_ENEMY + enemy, bubble_x(b), bubble_y(b))
            enemy_state[enemy] = ACTIVE
            enemy_motion[enemy] = FALL
            enemy_timer[enemy] = 0
            enemy_angry[enemy] = 1
        end
    end
    return
end

# Whether bodies `a` and `b`'s positions are within `distance` px both ways.
function near(a: u8, b: u8, distance: i16): u8
    var dx: i16
    var dy: i16
    dx = body_x(a) - body_x(b)
    dy = body_y(a) - body_y(b)
    if dx < 0
        dx = 0 - dx
    end
    if dy < 0
        dy = 0 - dy
    end
    if dx <= distance and dy <= distance
        return 1
    end
    return 0
end

procedure check_caught()
    var i: u8
    if caught or safe
        return
    end
    for i = 0 to ENEMIES - 1
        if enemy_state[i] == ACTIVE and near(PLAYER, FIRST_ENEMY + i, CATCH_DISTANCE)
            caught = CAUGHT_FRAMES
        end
    end
    return
end

procedure check_cleared()
    var i: u8
    if clearing
        clearing = clearing - 1
        if clearing == 0
            start_round()
        end
        return
    end
    for i = 0 to ENEMIES - 1
        if enemy_state[i] != GONE
            return
        end
    end
    clearing = CLEAR_FRAMES
    return
end

# Draws `actor` at room pixel (x, y) with `cell`, hidden only while
# entirely above the room (a body partly above it shows its lower part).
# The sprites face left; `mirrored` turns them to face right.
procedure draw_at(actor: u8, x: i16, y: i16, cell: u16, mirrored: u8)
    if y <= -16
        actor_hide(actor)
        return
    end
    actor_draw(actor, u16(ROOM_X + x), u16(y), cell, mirrored)
    return
end

procedure draw_bub()
    var cell: u16
    if caught
        cell = BUB_SPIN[u8(tick >> 2) % 6]
    elsif blowing
        cell = BUB_BLOW[(BLOW_FRAMES - blowing) >> 1]
    elsif body_on_ground(PLAYER) == 0
        cell = BUB_WALK[2]
    elsif walk_step == 0 or (buttons_before & (JOY_LEFT | JOY_RIGHT)) == 0
        cell = BUBBLUN_STAND
    else
        cell = BUB_WALK[(walk_step >> 2) % 6]
    end
    # Blink while safe after being caught.
    if safe and (u8(tick) & 4)
        actor_hide(bub)
    else
        draw_at(bub, body_x(PLAYER), body_y(PLAYER), cell, facing_left xor 1)
    end
    return
end

procedure draw_enemies()
    var i: u8
    var cell: u16
    for i = 0 to ENEMIES - 1
        if enemy_state[i] == ACTIVE
            cell = ZEN_WALK[u8(tick >> 3) % 4]
            if enemy_angry[i]
                cell = ZEN_ANGRY[u8(tick >> 2) % 4]
            end
            draw_at(enemy_actor[i], body_x(FIRST_ENEMY + i), body_y(FIRST_ENEMY + i),
                    cell, enemy_left[i] xor 1)
        else
            actor_hide(enemy_actor[i])
        end
    end
    return
end

procedure draw_bubbles()
    var b: u8
    var cell: u16
    var step: u8
    for b = 0 to MAX_BUBBLES - 1
        if bubble_state(b) == BUBBLE_FREE
            actor_hide(bubble_actor[b])
        else
            if bubble_state(b) == BUBBLE_SHOT
                step = u8(SHOT_FRAMES - bubble_timer(b)) >> 1
                if step > 5
                    step = 5
                end
                cell = BUBBLE_FORM[step]
            elsif bubble_state(b) == BUBBLE_POP
                cell = BUBBLE_POPPED[u8(POP_FRAMES - bubble_timer(b)) / 6]
            elsif bubble_captive(b) != NO_CAPTIVE
                cell = BUBBLE_TRAPPED[u8(tick >> 3) % 3]
            else
                cell = BUBBLE_FLOAT_FRAMES[u8(tick >> 3) % 3]
            end
            draw_at(bubble_actor[b], bubble_x(b), bubble_y(b), cell, 0)
        end
    end
    return
end

# Replay builds (replay.py) log each frame here, REPLAY_BYTES apiece, for
# comparing with the arcade: Bub's x and y (i16), 2 if caught or 1; per
# enemy x and y (i16), its state and its motion; then per bubble (the first
# LOGGED_BUBBLES) x and y (i16) and its state.
const REPLAY_LOG: u32 = $52000
const REPLAY_BYTES = 56
const REPLAY_LIMIT = 1024
const LOGGED_BUBBLES = 6

procedure log_put16(at: far ^u8, value: i16)
    at[0] = u8(value)
    at[1] = u8(u16(value) >> 8)
    return
end

procedure log_frame()
    var at: far ^u8
    var i: u8
    if tick >= REPLAY_LIMIT
        return
    end
    at = REPLAY_LOG + u32(tick) * REPLAY_BYTES
    log_put16(at, body_x(PLAYER))
    log_put16(at + 2, body_y(PLAYER))
    at[4] = 1
    if caught
        at[4] = 2
    end
    for i = 0 to ENEMIES - 1
        log_put16(at + u32(5 + i * 6), body_x(FIRST_ENEMY + i))
        log_put16(at + u32(7 + i * 6), body_y(FIRST_ENEMY + i))
        at[9 + u16(i) * 6] = enemy_state[i]
        at[10 + u16(i) * 6] = enemy_motion[i] | (enemy_left[i] << 4)
    end
    for i = 0 to LOGGED_BUBBLES - 1
        log_put16(at + u32(23 + i * 5), bubble_x(i))
        log_put16(at + u32(25 + i * 5), bubble_y(i))
        at[27 + u16(i) * 5] = bubble_state(i)
    end
    return
end

export function main(): u8
    var i: u8
    var buttons: u8
    vic4_init()
    actors_sheet(u32(addr(DEMO_IMAGES)), u32(addr(DEMO_PALETTES)), u32(addr(DEMO_CELLS)))
    actors_software(SCREEN, COLUMNS, ROWS, SLOTS, ACTOR_CHARACTERS, ENTRIES)
    actors_hardware(SPRITE_TABLE, SPRITE_BUFFERS, 1, SPRITE_X0, SPRITE_Y0)
    vic4_border(0)
    vic4_background(0)
    bb_draw_room(1, 0, u32(addr(DEMO_ROOM_TILES)), u32(addr(DEMO_ROOM_PALETTES)),
                 u32(addr(DEMO_ROOM_MAP)), ROOM_TILES, ROOM_LEFT)
    physics_room(u32(addr(DEMO_ROOM_MAP)))
    bub = actor_new(ACTOR_HARDWARE)
    body_place(PLAYER, START_X, START_Y)
    for i = 0 to ENEMIES - 1
        enemy_actor[i] = actor_new(ACTOR_SOFTWARE)
        # Enemies never lose their slots to bubbles.
        actor_priority(enemy_actor[i], 1)
    end
    for i = 0 to MAX_BUBBLES - 1
        bubble_actor[i] = actor_new(ACTOR_SOFTWARE)
    end
    seed = $ace1
    tick = 0
    start_round()
    repeat
        vic4_wait_line(QUIET_LINE)
        buttons = read_buttons(tick)
        buttons_now = buttons
        move_bub(buttons)
        for i = 0 to ENEMIES - 1
            move_enemy(i)
        end
        bubbles_step()
        bubbles_meet()
        check_caught()
        check_cleared()
        remember()
        if REPLAY
            log_frame()
        end
        buttons_before = buttons
        draw_bub()
        draw_enemies()
        draw_bubbles()
        actors_frame()
        tick = tick + 1
    until 0
    return 0
end
