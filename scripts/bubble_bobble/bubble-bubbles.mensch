module BubbleBubbles

# Bubbles, Bubble Bobble-style: blown from in front of the player, they
# shoot sideways, then float up to just under the ceiling and drift toward
# the middle of the room, and in the end burst. A shooting bubble can trap
# an enemy; a trapped enemy breaks out (the bubble bursts) if the bubble is
# left too long. The game decides what touches what: this module keeps the
# bubbles moving and answers for them.
#
# Positions are room pixels (as BubblePhysics'), kept in sixteenths.
#
# The motion is the arcade's (measured in MAME, round 1): a shot goes 3 px a
# frame for SHOT_FRAMES frames, then 1 px more, and rests a frame; a
# floating bubble moves 1 px on 2 frames in every 5 (counted from when it
# starts floating), following round 1's air: up to AIR_TOP, across
# to AIR_X, then bobbing between AIR_BOB and AIR_TOP. It misses a move each
# time it turns, and each time its bottom edge passes the top or bottom of
# a platform.

import BubblePhysics

export const MAX_BUBBLES = 40
export const NO_BUBBLE = $ff
export const NO_CAPTIVE = $ff

# A bubble's state.
export const BUBBLE_FREE = 0
export const BUBBLE_SHOT = 1
export const BUBBLE_FLOAT = 2
export const BUBBLE_POP = 3

# Shooting: 3 px per frame for 21 frames (after the frame it is blown), 63 px.
export const SHOT_FRAMES = 21
const SHOT_SPEED = 48
# A floating bubble moves on frames whose age (frames since it started
# floating, after the shot's last pixel and rest) % 5 is 1 or 3.
# Round 1's air currents.
const AIR_TOP = 24
const AIR_X = 104
const AIR_BOB = 16
# How long a floating bubble lasts: LIFE_UNIT * its life (the arcade's is 8
# to 15, at random, given to bubble_blow) + LIFE_EXTRA frames; with an enemy
# inside (a guess, not yet measured) CAPTIVE_FRAMES.
const LIFE_UNIT = 60
const LIFE_EXTRA = 23
const CAPTIVE_FRAMES = 480
export const POP_FRAMES = 31

# Which way a floating bubble is going.
const GOING_UP = 0
const GOING_ACROSS = 1
const BOBBING_UP = 2
const BOBBING_DOWN = 3

const SIZE = 16
# A bubble appears this far in front of the one blowing it.
const MOUTH = 2

# `age` counts frames since it started floating (the shot's last pixel is
# at 1, a rest at 2); `skip` misses the next move.
type Bubble = record(state: u8, captive: u8, escaped: u8, x: i16, y: i16, vx: i16, timer: u16,
                     going: u8, age: u16, skip: u8, life: u8)

var bubbles: parallel [MAX_BUBBLES]Bubble

export procedure bubbles_reset()
    var b: u8
    for b = 0 to MAX_BUBBLES - 1
        bubbles[b].state = BUBBLE_FREE
    end
    return
end

# Blows a bubble from a 16x16 body at pixel (x, y), facing left if `left`,
# to float for `life` (see LIFE_UNIT): the bubble's number, or NO_BUBBLE if
# there is no room for one or a wall is in the way.
export function bubble_blow(x: i16, y: i16, left: u8, life: u8): u8
    var b: u8
    var start: i16
    start = x + MOUTH
    if left
        start = x - MOUTH
    end
    if terrain(start, y + 8) == WALL or terrain(start + SIZE - 1, y + 8) == WALL
        return NO_BUBBLE
    end
    for b = 0 to MAX_BUBBLES - 1
        if bubbles[b].state == BUBBLE_FREE
            bubbles[b].state = BUBBLE_SHOT
            bubbles[b].captive = NO_CAPTIVE
            bubbles[b].escaped = 0
            bubbles[b].x = start << 4
            bubbles[b].y = y << 4
            bubbles[b].vx = SHOT_SPEED
            if left
                bubbles[b].vx = 0 - SHOT_SPEED
            end
            bubbles[b].timer = SHOT_FRAMES
            bubbles[b].life = life
            # It shows where it was blown this frame, and moves from the next.
            bubbles[b].skip = 1
            return b
        end
    end
    return NO_BUBBLE
end

procedure start_float(b: u8)
    bubbles[b].state = BUBBLE_FLOAT
    bubbles[b].going = GOING_UP
    bubbles[b].age = 0
    bubbles[b].skip = 0
    bubbles[b].timer = u16(bubbles[b].life) * LIFE_UNIT + LIFE_EXTRA
    if bubbles[b].captive != NO_CAPTIVE
        bubbles[b].timer = CAPTIVE_FRAMES
    end
    return
end

procedure start_pop(b: u8)
    bubbles[b].state = BUBBLE_POP
    bubbles[b].timer = POP_FRAMES
    return
end

procedure shoot(b: u8)
    var x: i16
    var px: i16
    var edge: i16
    x = bubbles[b].x + bubbles[b].vx
    px = x >> 4
    edge = px
    if bubbles[b].vx > 0
        edge = px + SIZE - 1
    end
    if terrain(edge, (bubbles[b].y >> 4) + 8) == WALL
        # Up against the wall's cell, then float (with no last pixel).
        if bubbles[b].vx > 0
            bubbles[b].x = (((edge >> 3) << 3) - SIZE) << 4
        else
            bubbles[b].x = (((edge >> 3) << 3) + 8) << 4
        end
        start_float(b)
        bubbles[b].age = 1
        return
    end
    bubbles[b].x = x
    bubbles[b].timer = bubbles[b].timer - 1
    if bubbles[b].timer == 0
        start_float(b)
    end
    return
end

# Whether a bubble with its top at pixel row y has its bottom edge on the
# top or bottom of terrain under its middle at pixel column px.
function at_platform_edge(px: i16, y: i16): u8
    var bottom: i16
    bottom = y + SIZE
    if bottom & 7
        return 0
    end
    if terrain(px + 8, bottom) != EMPTY or terrain(px + 8, bottom - 1) != EMPTY
        return 1
    end
    return 0
end

# One move of floating bubble `b` along round 1's air.
procedure drift(b: u8)
    var x: i16
    var y: i16
    x = bubbles[b].x >> 4
    y = bubbles[b].y >> 4
    if bubbles[b].going == GOING_UP
        y = y - 1
        if y <= AIR_TOP
            y = AIR_TOP
            bubbles[b].going = GOING_ACROSS
            bubbles[b].skip = 1
        elsif at_platform_edge(x, y)
            bubbles[b].skip = 1
        end
    elsif bubbles[b].going == GOING_ACROSS
        if x < AIR_X
            x = x + 1
        elsif x > AIR_X
            x = x - 1
        end
        if x == AIR_X
            bubbles[b].going = BOBBING_UP
            bubbles[b].skip = 1
        end
    elsif bubbles[b].going == BOBBING_UP
        y = y - 1
        if y <= AIR_BOB
            bubbles[b].going = BOBBING_DOWN
            bubbles[b].skip = 1
        end
    else
        y = y + 1
        if y >= AIR_TOP
            bubbles[b].going = BOBBING_UP
            bubbles[b].skip = 1
        end
    end
    bubbles[b].x = x << 4
    bubbles[b].y = y << 4
    return
end

procedure float(b: u8)
    var age: u16
    age = bubbles[b].age + 1
    bubbles[b].age = age
    if age == 1
        # The shot's last pixel (then a frame's rest).
        if bubbles[b].vx > 0
            bubbles[b].x = bubbles[b].x + 16
        else
            bubbles[b].x = bubbles[b].x - 16
        end
    elsif age > 2 and (age % 5 == 1 or age % 5 == 3)
        if bubbles[b].skip
            bubbles[b].skip = 0
        else
            drift(b)
        end
    end
    bubbles[b].timer = bubbles[b].timer - 1
    if bubbles[b].timer == 0
        if bubbles[b].captive != NO_CAPTIVE
            bubbles[b].escaped = 1
        end
        start_pop(b)
    end
    return
end

# Moves every bubble one frame.
export procedure bubbles_step()
    var b: u8
    for b = 0 to MAX_BUBBLES - 1
        if bubbles[b].state == BUBBLE_SHOT and bubbles[b].skip
            bubbles[b].skip = 0
        elsif bubbles[b].state == BUBBLE_SHOT
            shoot(b)
        elsif bubbles[b].state == BUBBLE_FLOAT
            float(b)
        elsif bubbles[b].state == BUBBLE_POP
            bubbles[b].timer = bubbles[b].timer - 1
            if bubbles[b].timer == 0
                bubbles[b].state = BUBBLE_FREE
            end
        end
    end
    return
end

# Traps `enemy` in shooting bubble `b`, which starts to float: 1 if it
# did, 0 if `b` is not a shooting bubble or already holds one.
export function bubble_capture(b: u8, enemy: u8): u8
    if bubbles[b].state != BUBBLE_SHOT or bubbles[b].captive != NO_CAPTIVE
        return 0
    end
    bubbles[b].captive = enemy
    start_float(b)
    return 1
end

# Bursts floating bubble `b`: the enemy it held, or NO_CAPTIVE.
export function bubble_pop(b: u8): u8
    var enemy: u8
    enemy = bubbles[b].captive
    bubbles[b].captive = NO_CAPTIVE
    start_pop(b)
    return enemy
end

# The enemy that broke out of bubble `b` since the last call, or
# NO_CAPTIVE.
export function bubble_escapee(b: u8): u8
    var enemy: u8
    if bubbles[b].escaped == 0
        return NO_CAPTIVE
    end
    bubbles[b].escaped = 0
    enemy = bubbles[b].captive
    bubbles[b].captive = NO_CAPTIVE
    return enemy
end

export function bubble_state(b: u8): u8
    return bubbles[b].state
end

export function bubble_captive(b: u8): u8
    return bubbles[b].captive
end

export function bubble_x(b: u8): i16
    return bubbles[b].x >> 4
end

export function bubble_y(b: u8): i16
    return bubbles[b].y >> 4
end

# Frames left in the bubble's current state (for its animation).
export function bubble_timer(b: u8): u16
    return bubbles[b].timer
end
