module BubbleGame

# A playable Bubble Bobble-style room on the MEGA65: Bub on joystick 2 in
# room 1, with three Zen-chans that drop in, walk, turn at walls and now and
# then jump after him. Fire blows a bubble, which traps a Zen-chan it hits;
# touching a floating bubble pops it, and a Zen-chan popped that way is gone;
# landing on one with up held bounces Bub off it instead.
# A Zen-chan left in its bubble too long breaks out angry, and faster. When
# all three are gone the round starts again. Touching a Zen-chan spins Bub
# and puts him back at the start.
#
# Movement and collision are BubblePhysics', bubbles BubbleBubbles', drawing
# lib/actors.mensch's. Run it with scripts/bubble_bobble/run-game.sh.

import Vic4
import Actors
import BubbleDemoData
import BubbleVideo
import BubblePhysics
import BubbleBubbles
import BubbleAir
import BubbleRomTables
import GameReplay

# Chip RAM, as in the animation demo.
const ROOM_TILES: u32 = $44000
const SPRITE_TABLE: u32 = $45000
const SPRITE_BUFFERS: u32 = $46000
const ACTOR_CHARACTERS: u32 = $48000
const SCREEN: u32 = $50000

const COLUMNS = 40
const ROWS = 26
const SLOTS = 32
const ENTRIES = 32
const ROOM_LEFT = (COLUMNS - 32) / 2
const ROOM_X = ROOM_LEFT * 8
const SPRITE_X0 = 24
const SPRITE_Y0 = 46
const QUIET_LINE = 256

# ---------------------------------------------------------------- Bub

const PLAYER = 0
# The arcade moves Bub 6 times every 5 frames: twice on frames where
# (tick + BEAT_PHASE) % BEAT is 0 (in step with round 1's start). Walking is
# 1 px a move; steering a jump 1 px on 4 moves in every STEER_CYCLE,
# starting with a skip (the arcade's air steering is uneven, now behind,
# now catching up, by up to 3 px; this keeps closest to it); drifting off an
# edge 1 px every FALL_EVERY frames.
const BEAT = 5
const BEAT_PHASE = 2
const STEER_CYCLE = 5
const FALL_EVERY = 3
const START_X = 24
const START_Y = 184
# Frames Bub spins when caught, then frames he cannot be caught again after
# coming back (none at the start of a round), as the arcade. An enemy
# catches him when their centres are within CATCH_DISTANCE px both ways.
const CAUGHT_FRAMES = 186
const SAFE_FRAMES = 180
const CATCH_DISTANCE = 8
# Frames between bubbles, and of the blowing animation.
const BLOW_FRAMES = 22
# Bub and floating bubbles, as the arcade's sub CPU has them ($0664), with
# positions as centres: when their heights are less than TOUCH_HEIGHT apart,
# Bub pops a bubble that is no more than POP_FRONT px ahead of his middle
# (and less than POP_REACH behind that), and pushes one just further ahead
# (less than PUSH_AHEAD px more) the way he walks. Coming down onto one,
# within LAND_SIDE px across, he pops it if his middle is less than LAND_POP
# px above its, and bounces off it (with up held) if less than LAND_BOUNCE.
const TOUCH_HEIGHT = 12
const POP_FRONT = 5
const POP_REACH = 18
const PUSH_AHEAD = 10
const LAND_SIDE = 12
const LAND_POP = 12
const LAND_BOUNCE = 22
# A shooting bubble traps an enemy less than TRAP_REACH px from it both ways.
const TRAP_REACH = 14
# A bursting bubble bursts the first other bubble less than CHAIN_REACH px
# from it both ways, and so on, one a frame ($08F0).
const CHAIN_REACH = 20

const BUB_WALK: [6]u16 = [
    BUBBLUN_WALK_01, BUBBLUN_WALK_02, BUBBLUN_WALK_03,
    BUBBLUN_WALK_04, BUBBLUN_WALK_05, BUBBLUN_WALK_06
]
const BUB_SPIN: [6]u16 = [
    BUBBLUN_SPIN_01, BUBBLUN_SPIN_02, BUBBLUN_SPIN_03,
    BUBBLUN_SPIN_04, BUBBLUN_SPIN_05, BUBBLUN_SPIN_06
]
const BUB_BLOW: [8]u16 = [
    BUBBLUN_BLOW_01, BUBBLUN_BLOW_02, BUBBLUN_BLOW_03, BUBBLUN_BLOW_04,
    BUBBLUN_BLOW_05, BUBBLUN_BLOW_06, BUBBLUN_BLOW_07, BUBBLUN_BLOW_08
]

var bub: u8
var facing_left: u8
var walk_step: u8
# Frames of sideways input, for the step patterns.
var stride: u8
# Bubble lives taken from a replay's list.
var lives_used: u16
# The chain reaction: whether one is going, the bubble it is at, and which
# way the enemies it frees fly.
var chaining: u8
# Enemies the current chain has killed.
var chain_kills: u8
var score: u32
var item_actor: u8
var item_state: u8
var item_index: u8
var item_timer: u16
var item_y: i16
var round_frames: u16
var rounds_played: u16
var chain_from: u8
var chain_left: u8
# Moves steered during the current jump.
var steers: u8
var caught: u8
var safe: u8
var blowing: u8
var buttons_before: u8
var buttons_now: u8

# ---------------------------------------------------------------- Zen-chans

const ENEMIES = 3
const FIRST_ENEMY = 1
# Zen-chan movement, as measured in MAME (round 1, bublboblr): walking 1 px
# a frame; falling straight down at 1 px a frame; a jump is a 29-frame
# crouch, then straight up 40 px (one platform) at 1 px a frame; about 2
# frames' pause on turning at a wall and on landing. All three drop in at
# x 120 from 47 px above the room (111 frames to the top platform) and walk
# left. Angry Zen-chans' speed is a guess.
const ENEMY_SPEED = 16
const ANGRY_SPEED = 32
const ENEMY_CROUCH = 29
# How an enemy decides (the arcade's Zen-chan, bank 0 $8E3F): a cooldown
# counts down its walking frames; when it runs out it is reloaded with
# 10 + (enemy + 1) * the round's pace (round 1's is 120, so 130, 250 and
# 114 after wrapping) and the enemy changes mind:
# - chasing (mode 0): when Bub is above it, less than CHASE_RANGE px up,
#   it turns to walk toward him, or (within CLOSE px across) starts
#   climbing;
# - climbing (mode 1): while Bub is above it, or being caught, it holds the
#   cooldown at HOLD and jumps up to any platform it comes under; otherwise
#   the cooldown soon runs out and it goes back to chasing.
# It judges where Bub is from both their positions LAG frames ago. A jump
# from the height of its last jump (it came back down) is the arcade's
# other jump: rising while stepping 1 px forward every DRIFT_EVERY frames,
# falling at once if a wall stops it (seen in MAME; how long it lasts away
# from walls is a guess, as long as a jump).
const ROUND_PACE = 120
const HOLD = 2
const CHASE_RANGE = 32
const CLOSE = 16
const LAG = 2
const CHASING = 0
const CLIMBING = 1
const DRIFT_EVERY = 5
const NO_JUMP = 1000
const ENEMY_RISE = 40
const DROP_Y = -47
# Frames still after landing from the drop in, from a fall and from a jump.
# (At a wall an enemy turns round where it stands, in one frame.)
const ENTRY_PAUSE = 3
const LAND_PAUSE = 1
const RISE_PAUSE = 2
# Frames at an edge before falling off it.
const EDGE_PAUSE = 1
const DROP_X = 120
# Round 1's stagger: each drops in this many frames after the round starts.
const DROP_DELAY: [ENEMIES]u8 = [1, 21, 41]
# Frames between the last Zen-chan going and the round starting again.
const CLEAR_FRAMES = 120

# A Zen-chan's state.
const WAITING = 0
const ACTIVE = 1
const TRAPPED = 2
const GONE = 3
# Popped: hidden for DYING_HIDDEN frames, then flying off along its slot's
# script (BubbleRomTables), bouncing off a side wall, then falling.
const DYING = 4
const DYING_HIDDEN = 3
# Landed: food (BubbleRomTables' CHAIN_FOOD, by its place among the enemies
# its chain killed) for FRUIT_FRAMES; Bub collects it within COLLECT_REACH
# px both ways. Then its score floats up SCORE_RISE frames (1 px every 4)
# and stays SCORE_HOLD.
const FRUIT = 5
const SCORING = 6
# Touched by Bub: scored the next frame (the arcade's sub CPU notices,
# its main CPU scores).
const COLLECTED = 7
const FRUIT_FRAMES = 480
const COLLECT_REACH = 16
const SCORE_RISE = 120
const SCORE_HOLD = 60
# Points: an empty bubble, and a trapped enemy, burst.
const BUBBLE_POINTS = 10
const KILL_POINTS = 1000
# The round's item (BubbleRomTables' ITEM_*): it shows ITEM_DELAY frames into
# the round at the round's place, for ITEM_FRAMES. Which one: 49 less the
# seconds the last round took (at most 29); round 1's (the arcade carries
# time over from its attract demo) is 30.
const ITEM_DELAY = 343
const ITEM_FRAMES = 600
const ITEM_BEST = 49
const ITEM_SLOWEST = 29
const ROUND1_ITEM = 30
# Round 1's place, from the round table's sprite position ($90, $53): sprite
# coordinates are 8 px below and left of bodies' (the arcade's x and
# height), so room x = sprite x and room y = 208 - sprite height.
const ITEM_X = 83
const ITEM_Y = 64
const ITEM_WAITING = 0
const ITEM_SHOWN = 1
const ITEM_SCORING = 2
const ITEM_DONE = 3
const FLYING = 0
const FALLING_DEAD = 1
const SCRIPT_END = $99
const STEPS_END = $88

# An active enemy's motion.
const WALK = 0
const FALL = 1
const CROUCH = 2
const RISE = 3
const PAUSE = 4

const ZEN_WALK: [4]u16 = [
    ZEN_CHAN_WALK_01, ZEN_CHAN_WALK_02, ZEN_CHAN_WALK_03, ZEN_CHAN_WALK_04
]
const ZEN_DYING: [8]u16 = [
    ZEN_CHAN_STUNNED_01, ZEN_CHAN_STUNNED_02, ZEN_CHAN_STUNNED_03, ZEN_CHAN_STUNNED_04,
    ZEN_CHAN_STUNNED_05, ZEN_CHAN_STUNNED_06, ZEN_CHAN_STUNNED_07, ZEN_CHAN_STUNNED_08
]
const ZEN_ANGRY: [4]u16 = [
    ZEN_CHAN_ANGRY_01, ZEN_CHAN_ANGRY_02, ZEN_CHAN_ANGRY_03, ZEN_CHAN_ANGRY_04
]

var enemy_actor: [ENEMIES]u8
var enemy_state: [ENEMIES]u8
var enemy_delay: [ENEMIES]u8
var enemy_left: [ENEMIES]u8
var enemy_angry: [ENEMIES]u8
var enemy_motion: [ENEMIES]u8
var enemy_timer: [ENEMIES]u8
# Whether the enemy was under a platform it could jump to last frame.
var enemy_cooldown: [ENEMIES]u8
# A popped enemy's place in its chain, and frames left as food or score.
var enemy_chain: [ENEMIES]u8
var enemy_life: [ENEMIES]u16
# Whether a shot caught the enemy this frame.
var enemy_trapping: [ENEMIES]u8
# A dying enemy's place in its flight: script entry (into DEATH_SCRIPT, or
# BOUNCE_SCRIPT once bounced), repeats left, and step in the pattern.
var enemy_script: [ENEMIES]u16
var enemy_bounced: [ENEMIES]u8
var enemy_reps: [ENEMIES]u8
var enemy_step: [ENEMIES]u8
var enemy_mind: [ENEMIES]u8
# The height (y) the enemy last jumped from, or NO_JUMP; and whether its
# jump is the drifting one.
var enemy_jumped_from: [ENEMIES]i16
var enemy_drift: [ENEMIES]u8
# Positions over the last LAG + 1 frames (index 0 this frame): Bub's, then
# each enemy's.
var seen_x: [(ENEMIES + 1) * (LAG + 1)]i16
var seen_y: [(ENEMIES + 1) * (LAG + 1)]i16
# Whether the enemy is still dropping in at the start of the round.
var enemy_entering: [ENEMIES]u8
var clearing: u8

# ---------------------------------------------------------------- bubbles

const BUBBLE_FORM: [6]u16 = [
    BUBBLE_FORM_GREEN_01, BUBBLE_FORM_GREEN_02, BUBBLE_FORM_GREEN_03,
    BUBBLE_FORM_GREEN_04, BUBBLE_FORM_GREEN_05, BUBBLE_FORM_GREEN_06
]
const BUBBLE_FLOAT_FRAMES: [3]u16 = [BUBBLE_GREEN_01, BUBBLE_GREEN_02, BUBBLE_GREEN_03]
const BUBBLE_TRAPPED: [3]u16 = [
    ZEN_CHAN_BUBBLE_GREEN_01, ZEN_CHAN_BUBBLE_GREEN_02, ZEN_CHAN_BUBBLE_GREEN_03
]
# A popped bubble: a dotted ring breaking up.
const BUBBLE_POPPED: [3]u16 = [BUBBLE_DOTTED_01, BUBBLE_DOTTED_02, BUBBLE_DOTTED_03]

var bubble_actor: [MAX_BUBBLES]u8

var seed: u16
var tick: u16

# A pseudo-random byte (16-bit Galois shift register).
function random(): u8
    var low: u8
    low = u8(seed) & 1
    seed = seed >> 1
    if low
        seed = seed xor $b400
    end
    return u8(seed)
end

# ---------------------------------------------------------------- per frame

procedure start_round()
    var i: u8
    for i = 0 to ENEMIES - 1
        enemy_state[i] = WAITING
        enemy_delay[i] = DROP_DELAY[i]
        enemy_left[i] = 1
        enemy_angry[i] = 0
        enemy_trapping[i] = 0
        enemy_cooldown[i] = reload(i)
        enemy_mind[i] = CHASING
        enemy_jumped_from[i] = NO_JUMP
        actor_hide(enemy_actor[i])
    end
    bubbles_reset()
    chaining = 0
    item_index = ROUND1_ITEM
    if rounds_played
        item_index = ITEM_BEST - ITEM_SLOWEST
        if round_frames / 60 < ITEM_SLOWEST
            item_index = ITEM_BEST - u8(round_frames / 60)
        end
    end
    rounds_played = rounds_played + 1
    round_frames = 0
    item_state = ITEM_WAITING
    item_timer = ITEM_DELAY
    actor_hide(item_actor)
    clearing = 0
    return
end

# A new bubble's life: the arcade's is 8 to 15 at random; a replay build
# takes the arcade's own, in order.
function bubble_life(): u8
    if REPLAY and lives_used < REPLAY_LIVES_COUNT
        lives_used = lives_used + 1
        return REPLAY_LIVES[lives_used - 1]
    end
    return 8 + (random() & 7)
end

# The controls: the joystick, or in a replay build the script's input for
# frame `frame` (a frame's later reads see the next frame's). The script is
# runs of (frames, buttons), read forward: `frame` never goes back.
var run_at: u16
var run_start: u16

function read_buttons(frame: u16): u8
    if REPLAY
        while run_at < REPLAY_RUNS and frame >= run_start + u16(REPLAY_INPUT[run_at])
            run_start = run_start + u16(REPLAY_INPUT[run_at])
            run_at = run_at + 2
        end
        if run_at < REPLAY_RUNS
            return REPLAY_INPUT[run_at + 1]
        end
        return 0
    end
    return joystick(2)
end

# Pixels Bub steers on this move of a jump.
function steer(): i16
    steers = steers + 1
    if steers % STEER_CYCLE == 0
        return 0
    end
    return 1
end

procedure move_bub(buttons: u8)
    var dx: i16
    var pressed: u8
    var b: u8
    if caught
        caught = caught - 1
        if caught == 0
            body_place(PLAYER, START_X, START_Y)
            safe = SAFE_FRAMES
        elsif not supported(body_x(PLAYER), body_y(PLAYER) + 16)
            # Caught in the air, he sinks to the ground at 1 px a frame.
            body_place(PLAYER, body_x(PLAYER), body_y(PLAYER) + 1)
        end
        return
    end
    if safe
        safe = safe - 1
    end
    if blowing
        blowing = blowing - 1
    end
    pressed = buttons & (buttons_before xor $ff)
    dx = 0
    if buttons & (JOY_LEFT | JOY_RIGHT)
        stride = stride + 1
        if body_on_ground(PLAYER)
            dx = 1
        elsif body_jumping(PLAYER)
            dx = steer()
        elsif stride % FALL_EVERY == 0
            dx = 1
        end
        dx = dx << 4
        if buttons & JOY_LEFT
            dx = 0 - dx
            facing_left = 1
        else
            facing_left = 0
        end
    end
    # Taking off, Bub makes no step sideways that frame.
    if pressed & JOY_UP
        if body_jump(PLAYER)
            walk_step = 0
            dx = 0
            steers = STEER_CYCLE - 1
        end
    end
    if body_walk(PLAYER, dx) == 0 and dx != 0
        walk_step = walk_step + 1
    end
    if (pressed & JOY_FIRE) and blowing == 0
        b = bubble_blow(body_x(PLAYER), body_y(PLAYER), facing_left, bubble_life())
        blowing = BLOW_FRAMES
    end
    body_step(PLAYER)
    # The extra move on the beat: walking and jumping go twice as far. It
    # reads the controls afresh, as the arcade's later move does.
    if (tick + BEAT_PHASE) % BEAT == 0
        buttons = read_buttons(tick + 1)
        if body_on_ground(PLAYER) and (buttons & (JOY_LEFT | JOY_RIGHT))
            dx = 16
            if buttons & JOY_LEFT
                dx = 0 - dx
            end
            if body_walk(PLAYER, dx) == 0
                walk_step = walk_step + 1
            end
            body_step(PLAYER)
        elsif body_jumping(PLAYER)
            if buttons & (JOY_LEFT | JOY_RIGHT)
                dx = steer() << 4
                if buttons & JOY_LEFT
                    dx = 0 - dx
                end
                b = body_walk(PLAYER, dx)
            end
            body_step(PLAYER)
        end
    end
    return
end

function reload(i: u8): u8
    return u8(10 + (u16(i) + 1) * ROUND_PACE)
end

# Remembers this frame's positions of Bub (body 0) and the enemies.
procedure remember()
    var k: u8
    var at: u8
    for k = 0 to ENEMIES
        at = k * (LAG + 1)
        seen_x[at + 2] = seen_x[at + 1]
        seen_y[at + 2] = seen_y[at + 1]
        seen_x[at + 1] = seen_x[at]
        seen_y[at + 1] = seen_y[at]
        seen_x[at] = body_x(k)
        seen_y[at] = body_y(k)
    end
    return
end

# Bub's height above enemy `i`, and across from it, as it judges them.
function bub_above(i: u8): i16
    return seen_y[(i + 1) * (LAG + 1) + LAG] - seen_y[LAG]
end

function bub_across(i: u8): i16
    return seen_x[LAG] - seen_x[(i + 1) * (LAG + 1) + LAG]
end

# Enemy `i`, walking (or about to) at (x, y), makes up its mind for this
# frame: perhaps turning toward Bub, perhaps jumping up to a platform.
procedure think(i: u8, x: i16, y: i16)
    var up: i16
    var across: i16
    var under: u8
    enemy_cooldown[i] = enemy_cooldown[i] - 1
    if enemy_cooldown[i] == 0
        enemy_cooldown[i] = reload(i)
        enemy_mind[i] = enemy_mind[i] xor 1
    end
    up = bub_above(i)
    across = bub_across(i)
    if enemy_mind[i] == CHASING
        if y == START_Y or caught or up <= 0 or up >= CHASE_RANGE
            return
        end
        enemy_jumped_from[i] = NO_JUMP
        if across > 0 - CLOSE and across < CLOSE
            enemy_mind[i] = CLIMBING
        elsif across < 0
            enemy_left[i] = 1
        else
            enemy_left[i] = 0
        end
        return
    end
    if caught == 0 and up <= 0
        return
    end
    enemy_cooldown[i] = HOLD
    under = 0
    if y + 16 - ENEMY_RISE > 8
        under = ground_under_middle(x, y + 16 - ENEMY_RISE)
    end
    if under
        # One more step, then the crouch.
        enemy_motion[i] = CROUCH
        enemy_timer[i] = ENEMY_CROUCH + 1
        enemy_drift[i] = 0
        if enemy_jumped_from[i] == y
            enemy_drift[i] = 1
            enemy_jumped_from[i] = NO_JUMP
        else
            enemy_jumped_from[i] = y
        end
    end
    return
end

procedure move_enemy(i: u8)
    var body: u8
    var dx: i16
    var x: i16
    var y: i16
    var under: u8
    body = FIRST_ENEMY + i
    if enemy_state[i] == WAITING
        enemy_delay[i] = enemy_delay[i] - 1
        if enemy_delay[i] == 0
            body_place(body, DROP_X, DROP_Y)
            enemy_state[i] = ACTIVE
            enemy_motion[i] = FALL
            enemy_timer[i] = 0
            enemy_entering[i] = 1
        end
        return
    end
    if enemy_state[i] == DYING
        move_dying(i)
        return
    end

    if enemy_state[i] != ACTIVE
        return
    end
    x = body_x(body)
    y = body_y(body)
    if enemy_motion[i] == PAUSE
        enemy_timer[i] = enemy_timer[i] - 1
        if enemy_timer[i] == 0
            # Ready to walk: it may decide to jump where it stands.
            enemy_motion[i] = WALK
            think(i, x, y)
        end
    elsif enemy_motion[i] == WALK
        dx = ENEMY_SPEED
        if enemy_angry[i]
            dx = ANGRY_SPEED
        end
        if enemy_left[i]
            dx = 0 - dx
        end
        # Turning round at a wall takes the frame (and does not count
        # toward the jump cooldown).
        if body_walk(body, dx)
            enemy_left[i] = enemy_left[i] xor 1
        else
            x = body_x(body)
            if not supported(x, y + 16)
                enemy_motion[i] = FALL
                enemy_timer[i] = EDGE_PAUSE
            else
                think(i, x, y)
            end
        end
    elsif enemy_motion[i] == FALL and enemy_timer[i]
        enemy_timer[i] = enemy_timer[i] - 1
    elsif enemy_motion[i] == FALL
        y = y + 1
        if y >= ROOM_HEIGHT
            y = y - ROOM_HEIGHT - 16
        end
        # Land on the top of a cell (not the top row's).
        if ((y + 16) & 7) == 0 and y + 16 > 8 and supported(x, y + 16)
            enemy_motion[i] = PAUSE
            enemy_timer[i] = LAND_PAUSE
            if enemy_entering[i]
                enemy_timer[i] = ENTRY_PAUSE
                enemy_entering[i] = 0
            end
        end
        body_place(body, x, y)
    elsif enemy_motion[i] == CROUCH
        if enemy_timer[i] == ENEMY_CROUCH + 1
            dx = ENEMY_SPEED
            if enemy_left[i]
                dx = 0 - dx
            end
            under = body_walk(body, dx)
        end
        enemy_timer[i] = enemy_timer[i] - 1
        if enemy_timer[i] == 0
            enemy_motion[i] = RISE
            enemy_timer[i] = ENEMY_RISE
        end
    elsif enemy_motion[i] == RISE
        y = y - 1
        if enemy_drift[i] and (ENEMY_RISE - enemy_timer[i]) % DRIFT_EVERY == 0
            dx = ENEMY_SPEED
            if enemy_left[i]
                dx = 0 - dx
            end
            under = body_walk(body, dx)
            # Against a wall now: it turns, holds a frame, then falls.
            if under or body_walk(body, dx)
                enemy_left[i] = enemy_left[i] xor 1
                body_place(body, body_x(body), y)
                enemy_motion[i] = FALL
                enemy_timer[i] = 1
                return
            end
            under = body_walk(body, 0 - dx)
            x = body_x(body)
        end
        enemy_timer[i] = enemy_timer[i] - 1
        if enemy_timer[i] == 0
            enemy_motion[i] = FALL
            if supported(x, y + 16)
                enemy_motion[i] = PAUSE
                enemy_timer[i] = RISE_PAUSE
            end
            # Under another platform here: it may jump again at once.
        end
        body_place(body, x, y)
    end
    return
end

# ---------------------------------------------------------------- dying

function script_byte(i: u8, at: u16): u8
    if enemy_bounced[i]
        return BOUNCE_SCRIPT[at]
    end
    return DEATH_SCRIPT[at]
end

# Enemy `i` starts (or, `bounced`, starts again) on its slot's flight.
procedure start_script(i: u8, bounced: u8)
    enemy_bounced[i] = bounced
    if bounced
        enemy_script[i] = BOUNCE_SCRIPT_AT[i]
    else
        enemy_script[i] = DEATH_SCRIPT_AT[i]
    end
    enemy_reps[i] = script_byte(i, enemy_script[i] + 1)
    enemy_step[i] = 0
    return
end

# Enemy `i` is popped out of its bubble at (x, y), flying left if `left`.
procedure start_dying(i: u8, x: i16, y: i16, left: u8)
    enemy_state[i] = DYING
    enemy_motion[i] = FLYING
    enemy_timer[i] = DYING_HIDDEN
    enemy_left[i] = left
    body_place(FIRST_ENEMY + i, x, y)
    start_script(i, 0)
    return
end

# A flight step: 1 px, or 2 if that does not reach an 8-pixel line.
function fly(v: i16, d: i16): i16
    v = v + d
    if (v & 7) != 0
        v = v + d
    end
    return v
end

procedure move_dying(i: u8)
    var body: u8
    var x: i16
    var y: i16
    var way: u8
    var pattern: u16
    var bits: u8
    body = FIRST_ENEMY + i
    if enemy_timer[i]
        enemy_timer[i] = enemy_timer[i] - 1
        return
    end
    x = body_x(body)
    y = body_y(body)
    if enemy_motion[i] == FALLING_DEAD
        y = y + 1
        if y >= ROOM_HEIGHT
            y = y - ROOM_HEIGHT - 16
        end
        body_place(body, x, y)
        # Landing, it turns into food.
        if (y & 7) == 0 and supported(x, y + 16)
            enemy_state[i] = FRUIT
            enemy_life[i] = FRUIT_FRAMES
        end
        return
    end
    # At a side wall it turns and starts its bounce, holding a frame.
    if enemy_left[i] and x < 16
        enemy_left[i] = 0
        start_script(i, 1)
        return
    end
    if enemy_left[i] == 0 and x >= 224
        enemy_left[i] = 1
        start_script(i, 1)
        return
    end
    way = script_byte(i, enemy_script[i])
    if way == SCRIPT_END
        enemy_motion[i] = FALLING_DEAD
        return
    end
    if enemy_left[i] and way != 0
        way = (32 - way) & 31
    end
    pattern = DEATH_STEP_AT[way]
    bits = DEATH_STEPS[pattern + u16(enemy_step[i])]
    if bits & 1
        if bits & 8
            y = fly(y, 1)
        else
            y = fly(y, -1)
        end
    end
    if bits & $10
        if bits & $80
            x = fly(x, -1)
        else
            x = fly(x, 1)
        end
    end
    body_place(body, x, y)
    enemy_step[i] = enemy_step[i] + 1
    if DEATH_STEPS[pattern + u16(enemy_step[i])] == STEPS_END
        enemy_step[i] = 0
        enemy_reps[i] = enemy_reps[i] - 1
        if enemy_reps[i] == 0
            enemy_script[i] = enemy_script[i] + 2
            enemy_reps[i] = script_byte(i, enemy_script[i] + 1)
        end
    end
    return
end

# ---------------------------------------------------------------- food

# Whether Bub, alive, is within COLLECT_REACH px of (collect_x, collect_y)
# both ways. (Module variables, not parameters: the direct page is full.)
var collect_x: i16
var collect_y: i16
var collect_dx: i16
var collect_dy: i16

function bub_collects(): u8
    if caught
        return 0
    end
    collect_dx = body_x(PLAYER) - collect_x
    collect_dy = body_y(PLAYER) - collect_y
    if collect_dx > 0 - COLLECT_REACH and collect_dx < COLLECT_REACH and collect_dy > 0 - COLLECT_REACH and collect_dy < COLLECT_REACH
        return 1
    end
    return 0
end

# Enemies that are food lying where they landed, or their scores floating
# up. (A module variable for the loop: the direct page is full.)
var food_i: u8

procedure foods()
    food_i = 0
    while food_i != ENEMIES
        if enemy_state[food_i] == COLLECTED
            score = score + u32(CHAIN_POINTS[enemy_chain[food_i]])
            enemy_state[food_i] = SCORING
            enemy_life[food_i] = SCORE_RISE + SCORE_HOLD
        elsif enemy_state[food_i] == FRUIT or enemy_state[food_i] == SCORING
            enemy_life[food_i] = enemy_life[food_i] - 1
            collect_x = body_x(FIRST_ENEMY + food_i)
            collect_y = body_y(FIRST_ENEMY + food_i)
            if enemy_state[food_i] == FRUIT
                if bub_collects()
                    enemy_state[food_i] = COLLECTED
                elsif enemy_life[food_i] == 0
                    enemy_state[food_i] = GONE
                end
            elsif enemy_life[food_i] == 0
                enemy_state[food_i] = GONE
            elsif enemy_life[food_i] > SCORE_HOLD and (enemy_life[food_i] & 3) == 0
                body_place(FIRST_ENEMY + food_i, collect_x, collect_y - 1)
            end
        end
        food_i = food_i + 1
    end
    return
end

# The round's item: waiting, shown, its score floating up, or done.
procedure round_item()
    round_frames = round_frames + 1
    if item_state == ITEM_DONE
        return
    end
    item_timer = item_timer - 1
    if item_state == ITEM_WAITING
        if item_timer == 0
            item_state = ITEM_SHOWN
            item_timer = ITEM_FRAMES
            item_y = ITEM_Y
        end
    elsif item_state == ITEM_SHOWN
        collect_x = ITEM_X
        collect_y = ITEM_Y
        if bub_collects()
            score = score + u32(ITEM_POINTS[item_index])
            item_state = ITEM_SCORING
            item_timer = SCORE_RISE + SCORE_HOLD
        elsif item_timer == 0
            item_state = ITEM_DONE
        end
    else
        if item_timer == 0
            item_state = ITEM_DONE
        elsif item_timer > SCORE_HOLD and (item_timer & 3) == 0
            item_y = item_y - 1
        end
    end
    return
end

var item_cell: u16

procedure draw_item()
    item_cell = NO_SPRITE
    if item_state == ITEM_SHOWN
        item_cell = ITEM_FOOD[item_index]
    elsif item_state == ITEM_SCORING
        item_cell = ITEM_SCORE[item_index]
    end
    if item_cell == NO_SPRITE
        actor_hide(item_actor)
    else
        draw_at(item_actor, ITEM_X, item_y, item_cell, 0)
    end
    return
end

# ---------------------------------------------------------------- bubbles

# Bursts bubble `b` (Bub's doing if `fresh`, else the chain's), its enemy
# (if any) flying off left if `left`, and starts a chain reaction from it.
procedure burst(b: u8, left: u8, fresh: u8)
    var enemy: u8
    if fresh
        chain_kills = 0
    end
    enemy = bubble_pop(b)
    if enemy != NO_CAPTIVE
        start_dying(enemy, bubble_x(b), bubble_y(b), left)
        enemy_chain[enemy] = chain_kills
        if chain_kills < 10
            chain_kills = chain_kills + 1
        end
        score = score + KILL_POINTS
    else
        score = score + BUBBLE_POINTS
    end
    chain_from = b
    chain_left = left
    chaining = 1
    return
end

# The chain reaction: the bubble that last burst bursts the first floating
# bubble close to it.
procedure chain()
    var b: u8
    var dx: i16
    var dy: i16
    if chaining == 0
        return
    end
    chaining = 0
    for b = 0 to MAX_BUBBLES - 1
        if b != chain_from and bubble_state(b) == BUBBLE_FLOAT
            dx = bubble_x(b) - bubble_x(chain_from)
            dy = bubble_y(b) - bubble_y(chain_from)
            if dx > 0 - CHAIN_REACH and dx < CHAIN_REACH and dy > 0 - CHAIN_REACH and dy < CHAIN_REACH
                burst(b, chain_left, 0)
                return
            end
        end
    end
    return
end

# Bub against floating bubble `b`: popping it, pushing it or bouncing off it.
procedure bub_meets(b: u8)
    var ahead: i16
    var above: i16
    var across: i16
    across = bubble_x(b) - body_x(PLAYER)
    above = bubble_y(b) - body_y(PLAYER)
    if body_falling(PLAYER)
        if across > 0 - LAND_SIDE and across < LAND_SIDE and above >= 0
            if above < LAND_POP
                burst(b, facing_left, 1)
            elsif above < LAND_BOUNCE and (buttons_now & JOY_UP)
                body_launch(PLAYER)
            end
            return
        end
    end
    if above <= 0 - TOUCH_HEIGHT or above >= TOUCH_HEIGHT
        return
    end
    # How far the bubble is ahead of Bub's front (his middle + POP_FRONT).
    ahead = across - POP_FRONT
    if facing_left
        ahead = 0 - across - POP_FRONT
    end
    if ahead <= 0 and ahead > 0 - POP_REACH
        burst(b, facing_left, 1)
    elsif ahead > 0 and ahead < PUSH_AHEAD and (buttons_now & (JOY_LEFT | JOY_RIGHT))
        if facing_left
            bubble_nudge(b, -1)
        else
            bubble_nudge(b, 1)
        end
    end
    return
end

# Shooting bubbles trap enemies: as the arcade does, before anything moves
# this frame, so from where they all were at the end of the last.
procedure trap_enemies()
    var b: u8
    var i: u8
    var dx: i16
    var dy: i16
    for b = 0 to MAX_BUBBLES - 1
        if bubble_state(b) == BUBBLE_SHOT
            for i = 0 to ENEMIES - 1
                if enemy_state[i] == ACTIVE
                    dx = bubble_x(b) - body_x(FIRST_ENEMY + i)
                    dy = bubble_y(b) - body_y(FIRST_ENEMY + i)
                    if dx > 0 - TRAP_REACH and dx < TRAP_REACH and dy > 0 - TRAP_REACH and dy < TRAP_REACH
                        if bubble_capture(b, i)
                            # It finishes this frame, then is inside.
                            enemy_trapping[i] = 1
                        end
                    end
                end
            end
        end
    end
    return
end

# Enemies trapped this frame are inside their bubbles from now on.
procedure enter_bubbles()
    var i: u8
    for i = 0 to ENEMIES - 1
        if enemy_trapping[i]
            enemy_trapping[i] = 0
            enemy_state[i] = TRAPPED
            actor_hide(enemy_actor[i])
        end
    end
    return
end

# Bubbles against Bub: popping, pushing, bouncing, chain reactions; and
# enemies breaking out.
procedure bubbles_meet()
    var b: u8
    var i: u8
    var enemy: u8
    var dx: i16
    var dy: i16
    chain()
    for b = 0 to MAX_BUBBLES - 1
        if bubble_state(b) == BUBBLE_FLOAT and caught == 0
            bub_meets(b)
        end
        enemy = bubble_escapee(b)
        if enemy != NO_CAPTIVE
            body_place(FIRST_ENEMY + enemy, bubble_x(b), bubble_y(b))
            enemy_state[enemy] = ACTIVE
            enemy_motion[enemy] = FALL
            enemy_timer[enemy] = 0
            enemy_angry[enemy] = 1
        end
    end
    return
end

# Whether bodies `a` and `b`'s positions are within `distance` px both ways.
function near(a: u8, b: u8, distance: i16): u8
    var dx: i16
    var dy: i16
    dx = body_x(a) - body_x(b)
    dy = body_y(a) - body_y(b)
    if dx < 0
        dx = 0 - dx
    end
    if dy < 0
        dy = 0 - dy
    end
    if dx <= distance and dy <= distance
        return 1
    end
    return 0
end

procedure check_caught()
    var i: u8
    if caught or safe
        return
    end
    for i = 0 to ENEMIES - 1
        if enemy_state[i] == ACTIVE and near(PLAYER, FIRST_ENEMY + i, CATCH_DISTANCE)
            caught = CAUGHT_FRAMES
        end
    end
    return
end

procedure check_cleared()
    var i: u8
    if clearing
        clearing = clearing - 1
        if clearing == 0
            start_round()
        end
        return
    end
    # Cleared when every enemy is dead (its food may still lie about).
    for i = 0 to ENEMIES - 1
        if enemy_state[i] < FRUIT and enemy_state[i] != GONE
            return
        end
    end
    clearing = CLEAR_FRAMES
    return
end

# Draws `actor` at room pixel (x, y) with `cell`, hidden only while
# entirely above the room (a body partly above it shows its lower part).
# The sprites face left; `mirrored` turns them to face right.
procedure draw_at(actor: u8, x: i16, y: i16, cell: u16, mirrored: u8)
    if y <= -16
        actor_hide(actor)
        return
    end
    actor_draw(actor, u16(ROOM_X + x), u16(y), cell, mirrored)
    return
end

procedure draw_bub()
    var cell: u16
    if caught
        cell = BUB_SPIN[u8(tick >> 2) % 6]
    elsif blowing
        cell = BUB_BLOW[(BLOW_FRAMES - blowing) >> 1]
    elsif body_on_ground(PLAYER) == 0
        cell = BUB_WALK[2]
    elsif walk_step == 0 or (buttons_before & (JOY_LEFT | JOY_RIGHT)) == 0
        cell = BUBBLUN_STAND
    else
        cell = BUB_WALK[(walk_step >> 2) % 6]
    end
    # Blink while safe after being caught.
    if safe and (u8(tick) & 4)
        actor_hide(bub)
    else
        draw_at(bub, body_x(PLAYER), body_y(PLAYER), cell, facing_left xor 1)
    end
    return
end

procedure draw_enemies()
    var i: u8
    var cell: u16
    for i = 0 to ENEMIES - 1
        if enemy_state[i] == ACTIVE
            cell = ZEN_WALK[u8(tick >> 3) % 4]
            if enemy_angry[i]
                cell = ZEN_ANGRY[u8(tick >> 2) % 4]
            end
            draw_at(enemy_actor[i], body_x(FIRST_ENEMY + i), body_y(FIRST_ENEMY + i),
                    cell, enemy_left[i] xor 1)
        elsif enemy_state[i] == DYING and enemy_timer[i] == 0
            draw_at(enemy_actor[i], body_x(FIRST_ENEMY + i), body_y(FIRST_ENEMY + i),
                    ZEN_DYING[u8(tick >> 2) % 8], enemy_left[i] xor 1)
        elsif enemy_state[i] == FRUIT or enemy_state[i] == COLLECTED
            draw_at(enemy_actor[i], body_x(FIRST_ENEMY + i), body_y(FIRST_ENEMY + i),
                    CHAIN_FOOD[enemy_chain[i]], 0)
        elsif enemy_state[i] == SCORING and CHAIN_SCORE[enemy_chain[i]] != NO_SPRITE
            draw_at(enemy_actor[i], body_x(FIRST_ENEMY + i), body_y(FIRST_ENEMY + i),
                    CHAIN_SCORE[enemy_chain[i]], 0)
        else
            actor_hide(enemy_actor[i])
        end
    end
    return
end

procedure draw_bubbles()
    var b: u8
    var cell: u16
    var step: u8
    for b = 0 to MAX_BUBBLES - 1
        if bubble_state(b) == BUBBLE_FREE
            actor_hide(bubble_actor[b])
        else
            if bubble_state(b) == BUBBLE_SHOT
                step = u8(SHOT_FRAMES - bubble_timer(b)) >> 1
                if step > 5
                    step = 5
                end
                cell = BUBBLE_FORM[step]
            elsif bubble_state(b) == BUBBLE_POP
                # Three frames over the burst.
                cell = BUBBLE_POPPED[u8(u16(POP_FRAMES - bubble_timer(b)) * 3 / (POP_FRAMES + 1))]
            elsif bubble_captive(b) != NO_CAPTIVE
                cell = BUBBLE_TRAPPED[u8(tick >> 3) % 3]
            else
                cell = BUBBLE_FLOAT_FRAMES[u8(tick >> 3) % 3]
            end
            draw_at(bubble_actor[b], bubble_x(b), bubble_y(b), cell, 0)
        end
    end
    return
end

# Replay builds (replay.py) log each frame here, REPLAY_BYTES apiece, for
# comparing with the arcade: Bub's x and y (i16), 2 if caught or 1; per
# enemy x and y (i16), its state and its motion; then per bubble (the first
# LOGGED_BUBBLES) x, y + 40 and its state, a byte each; the score / 10.
const REPLAY_LOG: u32 = $52000
const REPLAY_BYTES = 80
const REPLAY_LIMIT = 700
const LOGGED_BUBBLES = 18

procedure log_put16(at: far ^u8, value: i16)
    at[0] = u8(value)
    at[1] = u8(u16(value) >> 8)
    return
end

procedure log_frame()
    var at: far ^u8
    var i: u8
    if tick >= REPLAY_LIMIT
        return
    end
    at = REPLAY_LOG + u32(tick) * REPLAY_BYTES
    log_put16(at, body_x(PLAYER))
    log_put16(at + 2, body_y(PLAYER))
    at[4] = 1
    if caught
        at[4] = 2
    end
    for i = 0 to ENEMIES - 1
        log_put16(at + u32(5 + i * 6), body_x(FIRST_ENEMY + i))
        log_put16(at + u32(7 + i * 6), body_y(FIRST_ENEMY + i))
        # On screen: walking, or dying once shown.
        at[9 + u16(i) * 6] = 0
        if enemy_state[i] == ACTIVE or (enemy_state[i] == DYING and enemy_timer[i] == 0)
            at[9 + u16(i) * 6] = 1
        end
        at[10 + u16(i) * 6] = enemy_motion[i] | (enemy_left[i] << 4)
    end
    log_put16(at + 77, i16(u16(score / 10)))
    for i = 0 to LOGGED_BUBBLES - 1
        at[23 + u16(i) * 3] = u8(bubble_x(i))
        at[24 + u16(i) * 3] = u8(bubble_y(i) + 40)
        at[25 + u16(i) * 3] = bubble_state(i)
    end
    return
end

export function main(): u8
    var i: u8
    var buttons: u8
    vic4_init()
    actors_sheet(u32(addr(DEMO_IMAGES)), u32(addr(DEMO_PALETTES)), u32(addr(DEMO_CELLS)))
    actors_software(SCREEN, COLUMNS, ROWS, SLOTS, ACTOR_CHARACTERS, ENTRIES)
    actors_hardware(SPRITE_TABLE, SPRITE_BUFFERS, 1, SPRITE_X0, SPRITE_Y0)
    vic4_border(0)
    vic4_background(0)
    bb_draw_room(1, 0, u32(addr(DEMO_ROOM_TILES)), u32(addr(DEMO_ROOM_PALETTES)),
                 u32(addr(DEMO_ROOM_MAP)), ROOM_TILES, ROOM_LEFT)
    physics_room(u32(addr(DEMO_ROOM_MAP)))
    bubbles_air(u32(addr(AIR_ROUND1)))
    bub = actor_new(ACTOR_HARDWARE)
    body_place(PLAYER, START_X, START_Y)
    for i = 0 to ENEMIES - 1
        enemy_actor[i] = actor_new(ACTOR_SOFTWARE)
        # Enemies never lose their slots to bubbles.
        actor_priority(enemy_actor[i], 1)
    end
    for i = 0 to MAX_BUBBLES - 1
        bubble_actor[i] = actor_new(ACTOR_SOFTWARE)
    end
    item_actor = actor_new(ACTOR_SOFTWARE)
    seed = $ace1
    tick = 0
    start_round()
    repeat
        vic4_wait_line(QUIET_LINE)
        buttons = read_buttons(tick)
        buttons_now = buttons
        trap_enemies()
        move_bub(buttons)
        for i = 0 to ENEMIES - 1
            move_enemy(i)
        end
        bubbles_step()
        bubbles_meet()
        foods()
        round_item()
        check_caught()
        check_cleared()
        remember()
        if REPLAY
            log_frame()
        end
        buttons_before = buttons
        draw_bub()
        draw_enemies()
        draw_bubbles()
        draw_item()
        actors_frame()
        enter_bubbles()
        tick = tick + 1
    until 0
    return 0
end
