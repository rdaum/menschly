module HellordDos
# Bank-0 code below the I/O window; the DOS is the largest module.
metadata code_segment = "LOWCODE"

external far procedure console_write(value: u8)
external far procedure console_newline()
external far function console_read(): u8
external far procedure console_write_text(text: near ^u8)
external far procedure console_write_hex8(value: u8)
external far procedure console_write_hex16(value: u16)
external far procedure console_clear()
external far procedure console_write_greeting()
external far procedure console_write_help()
external far procedure console_write_version()
external far procedure console_prompt_drive(drive: u8)
external far procedure console_write_unknown()
external far procedure console_write_flag(name: u8, value: u8)
external far procedure files_write_root_dir()
external far procedure files_write_games_dir()
external far procedure files_type_readme()
external far procedure files_type_system()
external far procedure files_type_demo()
external far procedure files_write_not_found()
external far procedure files_write_program_not_found()
external far procedure files_write_path_not_found()
external far procedure files_run_hello()
external far procedure files_run_demo()
external procedure machine_reboot()
external function serial_rx_overflow(): u8
external function serial_tx_overflow(): u8
external reentrant function bios_block_status(dev: u16): u16
external reentrant function bios_block_sector_count(dev: u16): u16
external reentrant procedure bios_block_set_lba(dev: u16, lba: u16)
external reentrant function fat_mount(dev: u16, base: u16): u16
external reentrant procedure fat_dir_rewind()
external reentrant function fat_dir_next(dta: near ^u8): u16
external reentrant function fat_open(path: near ^u8, slot: u16): u16
external reentrant function fat_file_size(slot: u16): u16
external reentrant function fat_file_byte(slot: u16, offset: u16): u8
external reentrant function fat_write(slot: u16, offset: u16, count: u16, buffer: near ^u8): u16
external reentrant function bios_block_read(dev: u16, buffer: near ^u8): u16
external reentrant function bios_block_write(dev: u16, buffer: near ^u8): u16

const COMMAND_UNKNOWN = 0
const COMMAND_HELP = 1
const COMMAND_VERSION = 2
const COMMAND_DIR = 3
const COMMAND_ECHO = 4
const COMMAND_STATUS = 5
const COMMAND_DRIVE = 6
const COMMAND_PWD = 7
const COMMAND_CD = 8
const COMMAND_MAP = 9
const COMMAND_TYPE = 10
const COMMAND_CLS = 11
const COMMAND_PROMPT = 12
const COMMAND_SET = 13
const COMMAND_RUN = 14
const COMMAND_MEM = 15
const COMMAND_PROGRAM = 16
const COMMAND_PATH = 17
const COMMAND_PEEK = 18
const COMMAND_POKE = 19
const COMMAND_DUMP = 20
const COMMAND_FILL = 21
const COMMAND_BLKINFO = 22
const COMMAND_REBOOT = 23
const COMMAND_EMPTY = 255
const FILE_UNKNOWN = 0
const FILE_README = 1
const FILE_SYSTEM = 2
const FILE_DEMO = 3
const PROGRAM_HELLO = 1
const PROGRAM_DEMO = 2
const DIR_ROOT = 0
const DIR_GAMES = 1
const PROMPT_SHORT = 0
const PROMPT_FULL = 1
const PATH_CURRENT = 0
const PATH_ROOT = 1
const LINE_LIMIT = 31
const PATH_LIMIT = 15
const BACKSPACE = $08
const RECALL = $10
const DELETE = $7f
const LOWERCASE_DELTA = 32
const BIOS_BLOCK0 = $0008
const DRIVE_COUNT = 26
const DRIVE_BACKEND_NONE = 0
const DRIVE_BACKEND_ROMFS = 1
const DRIVE_BACKEND_BIOS_BLOCK = 2
const FS_DRIVER_NONE = 0
const FS_DRIVER_ROMFS = 1
const FS_DRIVER_FAT = 2
const FAT_DRIVE = 18
const DOS_BLOCK_OK = 0
const DOS_BLOCK_ERR_NO_DEVICE = $ffff
const DOS_OK = 0
const DOS_ERR_PATH_NOT_FOUND = $ffff
const DOS_ERR_NO_MORE_FILES = $fffe
const DOS_ERR_FILE_NOT_FOUND = $fffd
const DOS_ERR_BAD_HANDLE = $fffc
const DOS_ERR_ACCESS_DENIED = $fffb
const GEMDOS_ATTR_DIR = $10
const DOS_MAX_HANDLES = 4
const DOS_HANDLE_BASE = 6
const DOS_HANDLE_LIMIT = 10
const FAT_ATTR_VOLUME = $08
const FAT_ATTR_DIRECTORY = $10
const FAT_ATTR_LONG_NAME = $0f

var current_drive: u8
var dos_initialized: u8
var current_dir: u8
var prompt_mode: u8
var path_mode: u8
var path_len: u16
var line_len: u16
var history_len: u16
var parse_end: u16
var parse_ok: u8
var drive_backend: [26]u8
var drive_fs_driver: [26]u8
var drive_bios_device: [26]u16
var drive_partition_lba: [26]u16
var block_cache_valid: u8
var block_cache_drive: u8
var block_cache_lba: u16
var dos_search_dir: u8
var dos_search_next: u8
var dos_current_read_slot: u8
var dos_handle_driver: [4]u8
var dos_handle_file: [4]u8
var dos_handle_offset: [4]u16
var dos_handle_drive: [4]u8
var dos_handle_lba: [4]u16
var dos_handle_size: [4]u16
var current_path: [16]u8
var command_buffer: [32]u8
var history_buffer: [32]u8
var block_sector_buffer: [512]u8
var fat_name: [16]u8
var fat_dta: [16]u8

export procedure dos_boot()
    current_drive = 'A'
    prompt_mode = PROMPT_SHORT
    path_mode = PATH_CURRENT
    dos_ensure_init()
    init_path()
    console_write_greeting()
    prompt()
    while 1 != 0
        read_line()
        save_history()
        dispatch_line()
        prompt()
    end
end

export reentrant function dos_get_drive_index(): u16
    dos_ensure_init()
    return dos_drive_index(current_drive)
end

export reentrant function dos_set_drive_index(drive: u16): u16
    dos_ensure_init()
    if drive < DRIVE_COUNT
        current_drive = u8(drive) + 'A'
        return $ffff
    else
        return 0
    end
end

export reentrant function dos_mount_fat_drive(drive: u16): u16
    dos_ensure_init()
    if drive >= DRIVE_COUNT
        return DOS_BLOCK_ERR_NO_DEVICE
    elsif drive_backend[drive] != DRIVE_BACKEND_BIOS_BLOCK
        return DOS_BLOCK_ERR_NO_DEVICE
    else
        drive_fs_driver[drive] = FS_DRIVER_FAT
        return DOS_OK
    end
end

export reentrant function dos_set_path(path: near ^u8): u16
    dos_ensure_init()
    if path^ == 0
        init_path()
        return DOS_OK
    elsif path_is_root(path) != 0
        init_path()
        return DOS_OK
    elsif path_is_current(path) != 0
        return DOS_OK
    elsif path_is_parent(path) != 0
        init_path()
        return DOS_OK
    elsif path_is_games(path) != 0
        set_games_path()
        return DOS_OK
    elsif path_is_root_games(path) != 0
        set_games_path()
        return DOS_OK
    else
        return DOS_ERR_PATH_NOT_FOUND
    end
end

export reentrant function dos_fsfirst(dta: near ^u8): u16
    dos_ensure_init()
    dos_search_dir = current_dir
    dos_search_next = 0
    if dos_current_fs_driver() == FS_DRIVER_FAT
        if dos_mount_current_fat() != DOS_OK
            return DOS_ERR_NO_MORE_FILES
        end
        fat_dir_rewind()
    end
    return dos_fsnext(dta)
end

# Mounts the current drive's FAT volume (a no-op when already mounted).
reentrant function dos_mount_current_fat(): u16
    var index: u16
    index = dos_drive_index(current_drive)
    if fat_mount(drive_bios_device[index], drive_partition_lba[index]) != 0
        return DOS_ERR_PATH_NOT_FOUND
    end
    return DOS_OK
end

export reentrant function dos_fsnext(dta: near ^u8): u16
    if dos_current_fs_driver() == FS_DRIVER_ROMFS
        return romfs_search_next(dta)
    elsif dos_current_fs_driver() == FS_DRIVER_FAT
        if dos_search_dir != DIR_ROOT
            return DOS_ERR_NO_MORE_FILES
        end
        return fat_dir_next(dta)
    else
        return DOS_ERR_NO_MORE_FILES
    end
end

export reentrant function dos_fopen(path: near ^u8): u16
    var driver: u8
    var code: u8
    dos_ensure_init()
    driver = dos_current_fs_driver()
    if driver == FS_DRIVER_FAT
        return dos_fat_open(path)
    end
    code = dos_fs_file_code(path)
    if code == FILE_UNKNOWN
        return DOS_ERR_FILE_NOT_FOUND
    else
        return dos_alloc_handle(driver, code)
    end
end

export reentrant function dos_fread(handle: u16, count: u16, buffer: near ^u8): u16
    var slot: u16
    var read_count: u16
    var driver: u8
    var code: u8
    var offset: u16
    var done: u8
    dos_ensure_init()
    if dos_handle_slot_valid(handle) == 0
        return DOS_ERR_BAD_HANDLE
    end
    slot = handle - DOS_HANDLE_BASE
    driver = dos_handle_driver[slot]
    code = dos_handle_file[slot]
    if code == FILE_UNKNOWN
        return DOS_ERR_BAD_HANDLE
    end
    dos_current_read_slot = u8(slot)
    offset = dos_handle_offset[slot]
    read_count = 0
    done = 0
    while done == 0
        if read_count == count
            done = 1
        elsif offset >= dos_file_size(driver, code)
            done = 1
        else
            buffer^ = dos_file_byte(driver, code, offset)
            buffer = buffer + 1
            offset = offset + 1
            read_count = read_count + 1
        end
    end
    dos_handle_offset[slot] = offset
    return read_count
end

export reentrant function dos_fwrite(handle: u16, count: u16, buffer: near ^u8): u16
    var slot: u16
    var written: u16
    dos_ensure_init()
    if dos_handle_slot_valid(handle) == 0
        return DOS_ERR_BAD_HANDLE
    end
    slot = handle - DOS_HANDLE_BASE
    if dos_handle_file[slot] == FILE_UNKNOWN
        return DOS_ERR_BAD_HANDLE
    elsif dos_handle_driver[slot] == FS_DRIVER_FAT
        written = fat_write(slot, dos_handle_offset[slot], count, buffer)
        dos_handle_offset[slot] = dos_handle_offset[slot] + written
        return written
    else
        return DOS_ERR_ACCESS_DENIED
    end
end

export reentrant function dos_fclose(handle: u16): u16
    var slot: u16
    dos_ensure_init()
    if dos_handle_slot_valid(handle) == 0
        return DOS_ERR_BAD_HANDLE
    else
        slot = handle - DOS_HANDLE_BASE
        dos_handle_driver[slot] = FS_DRIVER_NONE
        dos_handle_file[slot] = FILE_UNKNOWN
        dos_handle_offset[slot] = 0
        dos_handle_drive[slot] = 0
        dos_handle_lba[slot] = 0
        dos_handle_size[slot] = 0
        return DOS_OK
    end
end

reentrant function dos_fat_open(path: near ^u8): u16
    var handle: u16
    var slot: u16
    if current_dir != DIR_ROOT
        return DOS_ERR_FILE_NOT_FOUND
    end
    if dos_mount_current_fat() != DOS_OK
        return DOS_ERR_FILE_NOT_FOUND
    end
    handle = dos_alloc_handle(FS_DRIVER_FAT, 1)
    if handle < DOS_HANDLE_BASE or handle >= DOS_HANDLE_LIMIT
        return handle
    end
    slot = handle - DOS_HANDLE_BASE
    if fat_open(path, slot) != 0
        dos_handle_driver[slot] = FS_DRIVER_NONE
        dos_handle_file[slot] = FILE_UNKNOWN
        return DOS_ERR_FILE_NOT_FOUND
    end
    return handle
end

export reentrant function fat_read_sector(drive: u16, lba: u16, buffer: near ^u8): u16
    dos_ensure_init()
    if drive >= DRIVE_COUNT
        return DOS_BLOCK_ERR_NO_DEVICE
    elsif drive_fs_driver[drive] != FS_DRIVER_FAT
        return DOS_BLOCK_ERR_NO_DEVICE
    else
        return dos_drive_read_blocks(u8(drive) + 'A', lba, 1, buffer)
    end
end

export reentrant function fat_write_sector(drive: u16, lba: u16, buffer: near ^u8): u16
    dos_ensure_init()
    if drive >= DRIVE_COUNT
        return DOS_BLOCK_ERR_NO_DEVICE
    elsif drive_fs_driver[drive] != FS_DRIVER_FAT
        return DOS_BLOCK_ERR_NO_DEVICE
    else
        return dos_drive_write_blocks(u8(drive) + 'A', lba, 1, buffer)
    end
end

function command_code(): u8
    if line_len == 0
        return COMMAND_EMPTY
    elsif is_help() != 0
        return COMMAND_HELP
    elsif is_version() != 0
        return COMMAND_VERSION
    elsif is_dir() != 0
        return COMMAND_DIR
    elsif is_status() != 0
        return COMMAND_STATUS
    elsif is_pwd() != 0
        return COMMAND_PWD
    elsif is_map() != 0
        return COMMAND_MAP
    elsif is_mem() != 0
        return COMMAND_MEM
    elsif is_cls() != 0
        return COMMAND_CLS
    elsif is_prompt() != 0
        return COMMAND_PROMPT
    elsif is_path() != 0
        return COMMAND_PATH
    elsif is_peek() != 0
        return COMMAND_PEEK
    elsif is_poke() != 0
        return COMMAND_POKE
    elsif is_dump() != 0
        return COMMAND_DUMP
    elsif is_fill() != 0
        return COMMAND_FILL
    elsif is_blkinfo() != 0
        return COMMAND_BLKINFO
    elsif command_word_matches("REBOOT") != 0
        return COMMAND_REBOOT
    elsif is_set() != 0
        return COMMAND_SET
    elsif is_run() != 0
        return COMMAND_RUN
    elsif is_type() != 0
        return COMMAND_TYPE
    elsif is_cd() != 0
        return COMMAND_CD
    elsif is_echo() != 0
        return COMMAND_ECHO
    elsif is_drive_select() != 0
        return COMMAND_DRIVE
    elsif bare_program_code() != 0
        return COMMAND_PROGRAM
    else
        return COMMAND_UNKNOWN
    end
end

procedure init_path()
    current_path[0] = '/'
    path_len = 1
    history_len = 0
    parse_end = 0
    parse_ok = 0
    current_dir = DIR_ROOT
    return
end

procedure set_games_path()
    current_path[0] = 'G'
    current_path[1] = 'A'
    current_path[2] = 'M'
    current_path[3] = 'E'
    current_path[4] = 'S'
    path_len = 5
    current_dir = DIR_GAMES
    return
end

function normalized_drive(value: u8): u8
    if value >= 'a' and value <= 'z'
        return value - LOWERCASE_DELTA
    else
        return value
    end
end

reentrant function path_is_root(path: near ^u8): u8
    if path^ == '/'
        path = path + 1
        if path^ == 0
            return 1
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function path_is_current(path: near ^u8): u8
    if path^ == '.'
        path = path + 1
        if path^ == 0
            return 1
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function path_is_parent(path: near ^u8): u8
    if path^ == '.'
        path = path + 1
        if path^ == '.'
            path = path + 1
            if path^ == 0
                return 1
            else
                return 0
            end
        else
            return 0
        end
    else
        return 0
    end
end

reentrant function path_is_games(path: near ^u8): u8
    if normalized_drive(path^) != 'G'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'A'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'M'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'E'
        return 0
    end
    path = path + 1
    if normalized_drive(path^) != 'S'
        return 0
    end
    path = path + 1
    if path^ == 0
        return 1
    else
        return 0
    end
end

reentrant function path_is_root_games(path: near ^u8): u8
    if path^ == '/'
        path = path + 1
        return path_is_games(path)
    else
        return 0
    end
end

function is_drive_letter(value: u8): u8
    var drive: u8
    drive = normalized_drive(value)
    if drive >= 'A' and drive <= 'Z'
        return 1
    else
        return 0
    end
end

function is_drive_select(): u8
    if line_len == 2 and is_drive_letter(command_buffer[0]) != 0 and command_buffer[1] == ':'
        return 1
    else
        return 0
    end
end

reentrant procedure dos_ensure_init()
    if dos_initialized == 0
        dos_init_drives()
    end
    return
end

procedure dos_init_drives()
    var index: u16
    if current_drive == 0
        current_drive = 'A'
    end
    index = 0
    while index != DRIVE_COUNT
        drive_backend[index] = DRIVE_BACKEND_ROMFS
        drive_fs_driver[index] = FS_DRIVER_ROMFS
        drive_bios_device[index] = 0
        drive_partition_lba[index] = 0
        index = index + 1
    end
    drive_backend[0] = DRIVE_BACKEND_BIOS_BLOCK
    drive_bios_device[0] = BIOS_BLOCK0
    drive_partition_lba[0] = 0
    # S: is the block device as a FAT volume (the SD card on the MEGA65).
    drive_backend[FAT_DRIVE] = DRIVE_BACKEND_BIOS_BLOCK
    drive_fs_driver[FAT_DRIVE] = FS_DRIVER_FAT
    drive_bios_device[FAT_DRIVE] = BIOS_BLOCK0
    drive_partition_lba[FAT_DRIVE] = 0
    block_cache_valid = 0
    index = 0
    while index != DOS_MAX_HANDLES
        dos_handle_driver[index] = FS_DRIVER_NONE
        dos_handle_file[index] = FILE_UNKNOWN
        dos_handle_offset[index] = 0
        dos_handle_drive[index] = 0
        dos_handle_lba[index] = 0
        dos_handle_size[index] = 0
        index = index + 1
    end
    dos_initialized = 1
    return
end

function dos_drive_index(drive: u8): u16
    return u16(normalized_drive(drive) - 'A')
end

function dos_drive_backend(drive: u8): u8
    return drive_backend[dos_drive_index(drive)]
end

function dos_drive_fs_driver(drive: u8): u8
    return drive_fs_driver[dos_drive_index(drive)]
end

function dos_drive_bios_device(drive: u8): u16
    if dos_drive_backend(drive) != DRIVE_BACKEND_BIOS_BLOCK
        return 0
    else
        return drive_bios_device[dos_drive_index(drive)]
    end
end

function dos_drive_partition_lba(drive: u8): u16
    return drive_partition_lba[dos_drive_index(drive)]
end

function dos_drive_block_status(drive: u8): u16
    var dev: u16
    dev = dos_drive_bios_device(drive)
    if dev == 0
        return 0
    else
        return bios_block_status(dev)
    end
end

function dos_drive_block_sector_count(drive: u8): u16
    var dev: u16
    dev = dos_drive_bios_device(drive)
    if dev == 0
        return 0
    else
        return bios_block_sector_count(dev)
    end
end

function dos_drive_read_blocks(drive: u8, lba: u16, count: u16, buffer: near ^u8): u16
    var physical_lba: u16
    physical_lba = dos_drive_partition_lba(drive) + lba
    return dos_volume_read_blocks(drive, physical_lba, count, buffer)
end

function dos_drive_write_blocks(drive: u8, lba: u16, count: u16, buffer: near ^u8): u16
    var physical_lba: u16
    physical_lba = dos_drive_partition_lba(drive) + lba
    return dos_volume_write_blocks(drive, physical_lba, count, buffer)
end

function dos_volume_read_blocks(drive: u8, lba: u16, count: u16, buffer: near ^u8): u16
    var dev: u16
    var status: u16
    var sector_lba: u16
    var remaining: u16
    dev = dos_drive_bios_device(drive)
    if dev == 0
        return DOS_BLOCK_ERR_NO_DEVICE
    else
        sector_lba = lba
        remaining = count
        while remaining != 0
            if block_cache_valid != 0 and block_cache_drive == normalized_drive(drive) and block_cache_lba == sector_lba
                copy_block_cache_to(buffer)
            else
                bios_block_set_lba(dev, sector_lba)
                status = bios_block_read(dev, addr(block_sector_buffer))
                if status != DOS_BLOCK_OK
                    return status
                end
                block_cache_valid = 1
                block_cache_drive = normalized_drive(drive)
                block_cache_lba = sector_lba
                copy_block_cache_to(buffer)
            end
            buffer = buffer + $0200
            sector_lba = sector_lba + 1
            remaining = remaining - 1
        end
        return DOS_BLOCK_OK
    end
end

function dos_volume_write_blocks(drive: u8, lba: u16, count: u16, buffer: near ^u8): u16
    var dev: u16
    var status: u16
    var sector_lba: u16
    var remaining: u16
    dev = dos_drive_bios_device(drive)
    if dev == 0
        return DOS_BLOCK_ERR_NO_DEVICE
    else
        sector_lba = lba
        remaining = count
        while remaining != 0
            copy_block_to_cache(buffer)
            bios_block_set_lba(dev, sector_lba)
            status = bios_block_write(dev, addr(block_sector_buffer))
            if status != DOS_BLOCK_OK
                return status
            end
            block_cache_valid = 1
            block_cache_drive = normalized_drive(drive)
            block_cache_lba = sector_lba
            buffer = buffer + $0200
            sector_lba = sector_lba + 1
            remaining = remaining - 1
        end
        return DOS_BLOCK_OK
    end
end

procedure copy_block_cache_to(buffer: near ^u8)
    var index: u16
    index = 0
    while index != $0200
        buffer^ = block_sector_buffer[index]
        buffer = buffer + 1
        index = index + 1
    end
    return
end

procedure copy_block_to_cache(buffer: near ^u8)
    var index: u16
    index = 0
    while index != $0200
        block_sector_buffer[index] = buffer^
        buffer = buffer + 1
        index = index + 1
    end
    return
end

function command_char_matches(index: u16, expected: u8): u8
    if normalized_drive(command_buffer[index]) == expected
        return 1
    else
        return 0
    end
end

function command_word_matches(word: near ^u8): u8
    var index: u16
    var ch: u8
    index = 0
    ch = word^
    while ch != 0
        if index >= line_len
            return 0
        elsif command_char_matches(index, ch) == 0
            return 0
        else
            index = index + 1
            word = word + 1
            ch = word^
        end
    end
    if index == line_len
        return 1
    else
        return 0
    end
end

function command_argument_matches(word: near ^u8): u8
    var index: u16
    var ch: u8
    index = 0
    ch = word^
    while ch != 0
        if index >= line_len
            return 0
        elsif command_char_matches(index, ch) == 0
            return 0
        else
            index = index + 1
            word = word + 1
            ch = word^
        end
    end
    if index < line_len and command_buffer[index] == ' ' and index + 1 < line_len
        return 1
    else
        return 0
    end
end

function argument_start(short: near ^u8, long: near ^u8): u16
    var index: u16
    index = 0
    if command_argument_matches(short) != 0
        while short^ != 0
            index = index + 1
            short = short + 1
        end
        return index + 1
    else
        while long^ != 0
            index = index + 1
            long = long + 1
        end
        return index + 1
    end
end

function argument_word_matches(index: u16, word: near ^u8): u8
    var ch: u8
    ch = word^
    while ch != 0
        if index >= line_len
            return 0
        elsif command_char_matches(index, ch) == 0
            return 0
        else
            index = index + 1
            word = word + 1
            ch = word^
        end
    end
    if index == line_len
        return 1
    else
        return 0
    end
end

function argument_name_matches(index: u16, word: near ^u8): u8
    var ch: u8
    ch = word^
    while ch != 0
        if index >= line_len
            return 0
        elsif command_char_matches(index, ch) == 0
            return 0
        else
            index = index + 1
            word = word + 1
            ch = word^
        end
    end
    if index == line_len
        return 1
    elsif command_buffer[index] == ' '
        return 1
    else
        return 0
    end
end

